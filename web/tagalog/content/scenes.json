{
  "_doc": "Diálogos de cada lección. lines: role native_m|native_f, tl, es. setting: lo que dice el narrador para situar.",
  "scenes": {
    "lesson-01": {
      "setting": "Estás en una calle de Tondo, a media mañana. Una mujer te saluda desde su puesto de la sari-sari.",
      "lines": [
        {
          "role": "native_f",
          "tl": "Magandang umaga po! Kumusta?",
          "es": "¡Buenos días! ¿Qué tal?"
        },
        {
          "role": "native_m",
          "tl": "Mabuti naman po, salamat. Ako si Víctor.",
          "es": "Bien, gracias. Soy Víctor."
        },
        {
          "role": "native_f",
          "tl": "Ako si Ana. Anong pangalan mo?",
          "es": "Yo soy Ana. ¿Cómo te llamas?"
        },
        {
          "role": "native_m",
          "tl": "Víctor. Salamat po, Ana. Ingat ka!",
          "es": "Víctor. Gracias, Ana. ¡Cuídate!"
        }
      ]
    },
    "lesson-02": {
      "setting": "Un chico se te acerca en la parroquia. Quiere saber si le entiendes.",
      "lines": [
        {
          "role": "native_m",
          "tl": "Kumusta po? Marunong ka bang mag-Tagalog?",
          "es": "¿Qué tal? ¿Sabes hablar Tagalog?"
        },
        {
          "role": "native_f",
          "tl": "Konti lang. Marunong ka bang mag-Ingles?",
          "es": "Solo un poco. ¿Sabes hablar inglés?"
        },
        {
          "role": "native_m",
          "tl": "Hindi po. Hindi ako marunong.",
          "es": "No. No sé."
        },
        {
          "role": "native_f",
          "tl": "Sige. Ulitin mo po? Naiintindihan mo ba?",
          "es": "Vale. ¿Repites, por favor? ¿Me entiendes?"
        },
        {
          "role": "native_m",
          "tl": "Opo! Konti lang.",
          "es": "¡Sí! Un poco."
        }
      ]
    },
    "lesson-03": {
      "setting": "Sentado con un amigo nuevo en un banco. Habláis de vosotros.",
      "lines": [
        {
          "role": "native_f",
          "tl": "Ako si Marites. Ikaw?",
          "es": "Yo soy Marites. ¿Y tú?"
        },
        {
          "role": "native_m",
          "tl": "Ako si Víctor. Gutom ako!",
          "es": "Yo soy Víctor. ¡Tengo hambre!"
        },
        {
          "role": "native_f",
          "tl": "Ako rin! Malapit lang ang bahay ko.",
          "es": "¡Yo también! Mi casa está aquí cerca."
        },
        {
          "role": "native_m",
          "tl": "Sino siya?",
          "es": "¿Quién es ella?"
        },
        {
          "role": "native_f",
          "tl": "Kaibigan ko. Ikaw din, kaibigan ko na!",
          "es": "Mi amiga. ¡Tú también, ya eres mi amigo!"
        }
      ]
    },
    "lesson-04": {
      "setting": "En un patio de Tondo. Un vecino te presenta a alguien y te pregunta dónde vives.",
      "lines": [
        {
          "role": "native_m",
          "tl": "Saan ka nakatira?",
          "es": "¿Dónde vives?"
        },
        {
          "role": "native_f",
          "tl": "Nakatira ako sa Tondo. Malapit lang.",
          "es": "Vivo en Tondo. Aquí cerca."
        },
        {
          "role": "native_m",
          "tl": "Sino siya?",
          "es": "¿Quién es ella?"
        },
        {
          "role": "native_f",
          "tl": "Kaibigan ko. Ano ito?",
          "es": "Mi amiga. ¿Qué es esto?"
        },
        {
          "role": "native_m",
          "tl": "Kape. Doon ang bahay ko.",
          "es": "Café. Allí está mi casa."
        }
      ]
    },
    "lesson-05": {
      "setting": "Quieres ir a Divisoria y no sabes por dónde. Preguntas a una señora en la esquina.",
      "lines": [
        {
          "role": "native_m",
          "tl": "Paano pumunta sa Divisoria? Malayo ba?",
          "es": "¿Cómo se va a Divisoria? ¿Está lejos?"
        },
        {
          "role": "native_f",
          "tl": "Hindi. Dumiretso ka lang. Kumanan ka.",
          "es": "No. Sigue recto. Gira a la derecha."
        },
        {
          "role": "native_m",
          "tl": "Gusto ko ng tubig. Gusto mo ba?",
          "es": "Quiero agua. ¿Quieres?"
        },
        {
          "role": "native_f",
          "tl": "Ayaw ko. Gusto kong pumunta sa palengke.",
          "es": "No quiero. Quiero ir al mercado."
        },
        {
          "role": "native_m",
          "tl": "Sige. Para po!",
          "es": "Vale. ¡Pare aquí!"
        }
      ]
    },
    "lesson-06": {
      "setting": "En una sari-sari. Quieres un café y preguntas el precio.",
      "lines": [
        {
          "role": "native_m",
          "tl": "Magkano po ito?",
          "es": "¿Cuánto cuesta esto?"
        },
        {
          "role": "native_f",
          "tl": "Bente pesos po.",
          "es": "Veinte pesos."
        },
        {
          "role": "native_m",
          "tl": "Ang mahal! Isang kape nga po.",
          "es": "¡Qué caro! Un café, por favor."
        },
        {
          "role": "native_f",
          "tl": "Sige. Pahingi po ng tubig?",
          "es": "Vale. ¿Me da agua?"
        },
        {
          "role": "native_m",
          "tl": "Wala. Mura ang kape, dalawa!",
          "es": "No hay. El café es barato, ¡dos!"
        }
      ]
    },
    "lesson-07": {
      "setting": "Un chico te dice que no ha ido a casa. Le preguntas cuándo y por qué.",
      "lines": [
        {
          "role": "native_f",
          "tl": "Kailan ka pupunta sa bahay?",
          "es": "¿Cuándo vas a ir a casa?"
        },
        {
          "role": "native_m",
          "tl": "Bukas. Hindi ngayon.",
          "es": "Mañana. Hoy no."
        },
        {
          "role": "native_f",
          "tl": "Bakit?",
          "es": "¿Por qué?"
        },
        {
          "role": "native_m",
          "tl": "Kasi gutom ako. Mamaya na lang.",
          "es": "Porque tengo hambre. Mejor más tarde."
        },
        {
          "role": "native_f",
          "tl": "Ilan kayo sa bahay?",
          "es": "¿Cuántos sois en casa?"
        },
        {
          "role": "native_m",
          "tl": "Lima. Kahapon, apat.",
          "es": "Cinco. Ayer, cuatro."
        }
      ]
    },
    "lesson-08": {
      "setting": "Tu primera conversación completa. En la parroquia, con una familia que acabas de conocer.",
      "lines": [
        {
          "role": "native_m",
          "tl": "Magandang hapon po! Kumusta kayo?",
          "es": "¡Buenas tardes! ¿Cómo están?"
        },
        {
          "role": "native_f",
          "tl": "Mabuti naman. Ako si Marites. Ikaw?",
          "es": "Bien. Yo soy Marites. ¿Y tú?"
        },
        {
          "role": "native_m",
          "tl": "Ako si Víctor. Taga-Espanya kami.",
          "es": "Soy Víctor. Somos de España."
        },
        {
          "role": "native_f",
          "tl": "Marunong ka bang mag-Tagalog?",
          "es": "¿Sabes hablar Tagalog?"
        },
        {
          "role": "native_m",
          "tl": "Konti lang. Sandali lang po… Ano sa Tagalog ang 'agua'?",
          "es": "Solo un poco. Un momento… ¿cómo se dice 'agua' en Tagalog?"
        },
        {
          "role": "native_f",
          "tl": "Tubig! Tara, kain tayo!",
          "es": "¡Tubig! ¡Venga, comamos!"
        },
        {
          "role": "native_m",
          "tl": "Sige! Salamat po. Pasensya na po, konti lang.",
          "es": "¡Vale! Gracias. Perdón, solo sé un poco."
        },
        {
          "role": "native_f",
          "tl": "Walang anuman. Ingat ka!",
          "es": "De nada. ¡Cuídate!"
        }
      ]
    },
    "lesson-09": {
      "setting": "En Tondo, un niño pregunta a un visitante sobre su casa.",
      "lines": [
        {
          "role": "kid_m",
          "tl": "Kumusta po? Saan ka nakatira?",
          "es": "¿Hola, dónde vives?"
        },
        {
          "role": "native_m",
          "tl": "Nakatira ako sa Tondo. Ikaw, saan ang bahay mo?",
          "es": "Vivo en Tondo. ¿Y tú, dónde está tu casa?"
        },
        {
          "role": "kid_m",
          "tl": "Malapit lang po. Nasaan ka ngayon?",
          "es": "Aquí cerca. ¿Dónde estás ahora?"
        },
        {
          "role": "native_m",
          "tl": "Nasa bahay ako.",
          "es": "Estoy en casa."
        },
        {
          "role": "kid_m",
          "tl": "Ah, nandiyan po pala kayo.",
          "es": "Ah, así que está ahí."
        }
      ]
    },
    "lesson-10": {
      "setting": "En una calle de Tondo, un voluntario conversa con un niño sobre su familia.",
      "lines": [
        {
          "role": "native_m",
          "tl": "Kumusta ka, iho?",
          "es": "¿Cómo estás, hijo?"
        },
        {
          "role": "kid_m",
          "tl": "Mabuti naman po.",
          "es": "Bien, gracias."
        },
        {
          "role": "native_m",
          "tl": "May pamilya ka ba?",
          "es": "¿Tienes familia?"
        },
        {
          "role": "kid_m",
          "tl": "Opo, may pamilya ako.",
          "es": "Sí, tengo familia."
        },
        {
          "role": "native_m",
          "tl": "Ilan kayo sa pamilya?",
          "es": "¿Cuántos sois en la familia?"
        },
        {
          "role": "kid_m",
          "tl": "Lima po kami.",
          "es": "Somos cinco."
        }
      ]
    },
    "lesson-11": {
      "setting": "En una calle de Tondo, un niño se encuentra con un voluntario extranjero.",
      "lines": [
        {
          "role": "native_m",
          "tl": "Kumusta ka?",
          "es": "¿Cómo estás?"
        },
        {
          "role": "kid_m",
          "tl": "Mabuti naman po.",
          "es": "Bien, gracias."
        },
        {
          "role": "native_m",
          "tl": "Ilang taon ka na?",
          "es": "¿Cuántos años tienes?"
        },
        {
          "role": "kid_m",
          "tl": "Sampung taon na ako.",
          "es": "Tengo diez años."
        },
        {
          "role": "native_m",
          "tl": "Ilang taon na si Kuya mo?",
          "es": "¿Cuántos años tiene tu hermano mayor?"
        },
        {
          "role": "kid_m",
          "tl": "Dalawampung taon na si Kuya.",
          "es": "El hermano mayor tiene veinte años."
        }
      ]
    },
    "lesson-12": {
      "setting": "En una calle de Tondo, un voluntario español charla con un residente local sobre su ocupación.",
      "lines": [
        {
          "role": "native_m",
          "tl": "Kumusta ka?",
          "es": "¿Cómo estás?"
        },
        {
          "role": "native_f",
          "tl": "Mabuti naman. Anong trabaho mo?",
          "es": "Bien, gracias. ¿De qué trabajas?"
        },
        {
          "role": "native_m",
          "tl": "Drayber ako. Ikaw?",
          "es": "Soy conductor. ¿Y tú?"
        },
        {
          "role": "native_f",
          "tl": "Nagtitinda ako sa palengke.",
          "es": "Soy vendedora en el mercado."
        },
        {
          "role": "native_m",
          "tl": "May negosyo ka ba?",
          "es": "¿Tienes negocio?"
        },
        {
          "role": "native_f",
          "tl": "Walang negosyo, pero may sweldo naman.",
          "es": "No tengo negocio, pero tengo sueldo."
        }
      ]
    },
    "lesson-13": {
      "setting": "En una calle de Tondo, un niño se encuentra con un adulto conocido.",
      "lines": [
        {
          "role": "native_m",
          "tl": "Kumusta ka, iho?",
          "es": "¿Cómo estás, hijo?"
        },
        {
          "role": "kid_m",
          "tl": "Mabuti naman po.",
          "es": "Bien, gracias."
        },
        {
          "role": "native_m",
          "tl": "Kumain ka na ba?",
          "es": "¿Ya has comido?"
        },
        {
          "role": "kid_m",
          "tl": "Hindi pa po.",
          "es": "Todavía no."
        },
        {
          "role": "native_m",
          "tl": "Kain tayo!",
          "es": "¡Comamos!"
        }
      ]
    },
    "lesson-14": {
      "setting": "En una pequeña fiesta en el barrio de Tondo, donde los vecinos se reúnen para conocerse mejor.",
      "lines": [
        {
          "role": "native_f",
          "tl": "Ikinagagalak kitang makilala.",
          "es": "Encantada de conocerte."
        },
        {
          "role": "native_m",
          "tl": "Ako si Juan. Kumusta ka?",
          "es": "Soy Juan. ¿Cómo estás?"
        },
        {
          "role": "native_f",
          "tl": "Mabuti naman. Tara, kanta ka!",
          "es": "Bien, gracias. ¡Vamos, canta!"
        },
        {
          "role": "native_m",
          "tl": "Sige, pero bukas na lang. Kita tayo bukas.",
          "es": "Vale, pero mejor mañana. Nos vemos mañana."
        },
        {
          "role": "native_f",
          "tl": "Oo, kita tayo bukas.",
          "es": "Sí, nos vemos mañana."
        }
      ]
    },
    "lesson-15": {
      "setting": "En una calle concurrida de Tondo, un voluntario se acerca a un niño que parece estar solo.",
      "lines": [
        {
          "role": "native_m",
          "tl": "Kumusta? Anong ginagawa mo dito?",
          "es": "Hola, ¿qué haces aquí?"
        },
        {
          "role": "kid_m",
          "tl": "Nandito lang ako.",
          "es": "Estoy solo aquí."
        },
        {
          "role": "native_m",
          "tl": "Mag-isa ka ba?",
          "es": "¿Estás solo?"
        },
        {
          "role": "kid_m",
          "tl": "Opo, hindi po ako mag-isa.",
          "es": "No, no estoy solo."
        },
        {
          "role": "native_m",
          "tl": "Nasaan ang nanay at tatay mo?",
          "es": "¿Dónde están tu madre y tu padre?"
        },
        {
          "role": "kid_m",
          "tl": "Opo, nasa bahay sila.",
          "es": "Sí, están en casa."
        },
        {
          "role": "native_m",
          "tl": "Halika dito.",
          "es": "Ven aquí."
        }
      ]
    },
    "lesson-16": {
      "setting": "En una calle concurrida de Tondo, un voluntario se acerca a un grupo de niños jugando.",
      "lines": [
        {
          "role": "native_m",
          "tl": "Kumusta kayo?",
          "es": "¿Cómo estáis?"
        },
        {
          "role": "kid_m",
          "tl": "Okay lang po.",
          "es": "Estamos bien."
        },
        {
          "role": "native_m",
          "tl": "Saan kayo natutulog?",
          "es": "¿Dónde dormís?"
        },
        {
          "role": "kid_f",
          "tl": "Sa kalye lang po.",
          "es": "Solo en la calle."
        },
        {
          "role": "native_m",
          "tl": "Bakit hindi kayo umuuwi?",
          "es": "¿Por qué no volvéis a casa?"
        },
        {
          "role": "kid_m",
          "tl": "Mahirap ang buhay po.",
          "es": "La vida es difícil."
        },
        {
          "role": "native_m",
          "tl": "Umuwi na kayo, ha?",
          "es": "Volved a casa, ¿vale?"
        }
      ]
    },
    "lesson-17": {
      "setting": "En una calle concurrida de Tondo, un voluntario se acerca a un grupo de niños jugando.",
      "lines": [
        {
          "role": "native_m",
          "tl": "Kumusta kayo?",
          "es": "¿Cómo estáis?"
        },
        {
          "role": "kid_f",
          "tl": "Okay lang po.",
          "es": "Bien, gracias."
        },
        {
          "role": "native_m",
          "tl": "Inaalagaan ka ba nila?",
          "es": "¿Te cuidan?"
        },
        {
          "role": "kid_m",
          "tl": "Opo, inaalagaan ako.",
          "es": "Sí, me cuidan."
        },
        {
          "role": "native_m",
          "tl": "Huwag kang matakot.",
          "es": "No tengas miedo."
        },
        {
          "role": "kid_f",
          "tl": "Opo, okay lang ako.",
          "es": "Sí, estoy bien."
        }
      ]
    },
    "lesson-18": {
      "setting": "En una calle de Tondo, un voluntario se acerca a un grupo de niños para hablar con ellos.",
      "lines": [
        {
          "role": "native_m",
          "tl": "Kumusta mga bata?",
          "es": "¿Cómo están, niños?"
        },
        {
          "role": "kid_m",
          "tl": "Okay lang po.",
          "es": "Bien, gracias."
        },
        {
          "role": "native_m",
          "tl": "Nag-aaral ka ba?",
          "es": "¿Estudias?"
        },
        {
          "role": "kid_f",
          "tl": "Opo, nag-aaral ako.",
          "es": "Sí, estudio."
        },
        {
          "role": "native_m",
          "tl": "Saan ka nag-aaral?",
          "es": "¿Dónde estudias?"
        },
        {
          "role": "kid_f",
          "tl": "Sa Tondo Elementary po.",
          "es": "En la primaria de Tondo."
        },
        {
          "role": "native_m",
          "tl": "May tsinelas ka ba?",
          "es": "¿Tienes chinelas?"
        },
        {
          "role": "kid_m",
          "tl": "Hindi po, wala akong tsinelas.",
          "es": "No, no tengo chinelas."
        }
      ]
    },
    "lesson-19": {
      "setting": "En una calle concurrida de Tondo, un voluntario se acerca a un niño que parece estar pidiendo dinero.",
      "lines": [
        {
          "role": "native_m",
          "tl": "Kumusta? Anong ginagawa mo dito?",
          "es": "Hola, ¿qué haces aquí?"
        },
        {
          "role": "kid_m",
          "tl": "Namamalimos po.",
          "es": "Estoy pidiendo limosna."
        },
        {
          "role": "native_m",
          "tl": "Sino ang kasama mo?",
          "es": "¿Quién está contigo?"
        },
        {
          "role": "kid_m",
          "tl": "Opo, wala akong kasama.",
          "es": "Sí, no tengo compañía."
        },
        {
          "role": "native_m",
          "tl": "Ingat ka!",
          "es": "¡Cuídate!"
        }
      ]
    }
  }
}
