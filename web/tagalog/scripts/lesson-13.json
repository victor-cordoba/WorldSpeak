      "clip": "_clips/70b983c14c641ed2.mp3"
    },
    {
      "role": "native_m",
      "lang": "tl",
      "text": "Hindi pa.",
      "kind": "phrase",
      "pause": 2.5,
      "translation_es": "Todavía no.",
