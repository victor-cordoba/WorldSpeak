      "pause": 0.4,
      "translation_es": "",
      "item": null,
      "clip": "_clips/bc80af6f4976abf5.mp3"
    },
    {
      "role": "narrator",
      "lang": "es",
      "text": "En Tagalog, 'na' indica que algo ya ha ocurrido, mientras que 'pa' indica que algo no ha ocurrido aún. Se usan para expresar el estado de acciones en el tiempo.",
      "kind": "explanation",
      "pause": 0.6,
      "translation_es": "",
      "item": null,
      "clip": "_clips/8ea569f8def84a60.mp3"
    },
    {
      "role": "native_m",
      "lang": "tl",
      "text": "Kumain ka na ba?",
