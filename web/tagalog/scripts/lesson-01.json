{
  "title": "Hola, ¿cómo estás? ¿Cómo te llamas?",
  "subtitle": "Saludar según la hora, decir tu nombre y preguntar el suyo.",
  "summary_es": "Aprendes a saludar (Kumusta, Magandang umaga), a decir cómo estás, a presentarte con Ako si y a preguntar el nombre con Anong pangalan mo.",
  "topics": [
    "Saludos",
    "Presentarse",
    "Preguntar el nombre",
    "Cortesía po",
    "Despedirse"
  ],
  "dialogue": {
    "tl": [
      "Magandang umaga po! Kumusta?",
      "Mabuti naman po, salamat. Ako si Víctor.",
      "Ako si Ana. Anong pangalan mo?",
      "Víctor. Salamat po, Ana. Ingat ka!"
    ],
    "es": [
      "¡Buenos días! ¿Qué tal?",
      "Bien, gracias. Soy Víctor.",
      "Yo soy Ana. ¿Cómo te llamas?",
      "Víctor. Gracias, Ana. ¡Cuídate!"
    ]
  },
