      "lang": "tl",
      "text": "Magandang umaga po! Kumusta?",
      "kind": "dialogue",
      "pause": 0.8,
      "translation_es": "¡Buenos días! ¿Qué tal?",
      "item": null,
      "clip": "_clips/b0b572e244b5850f.mp3"
    },
    {
      "role": "native_m",
      "lang": "tl",
      "text": "Mabuti naman po, salamat. Ako si Javier.",
