    {
      "role": "narrator",
      "lang": "es",
      "text": "En Tagalog, 'may' se utiliza para indicar posesión o existencia, mientras que 'wala' indica ausencia. Ejemplos: 'May pamilya ako.' significa 'Tengo familia.' y 'Wala akong pamilya.' significa 'No tengo familia.'",
      "kind": "explanation",
      "pause": 0.6,
      "translation_es": "",
      "item": null,
      "clip": "_clips/a63f3f824953c432.mp3"
    },
