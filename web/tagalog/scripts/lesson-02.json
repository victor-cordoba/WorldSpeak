      "clip": "_clips/ff98ee2879b85def.mp3"
    },
    {
      "role": "narrator",
      "lang": "es",
      "text": "No has entendido. Pídele que repita.",
      "kind": "prompt",
      "pause": 4.0,
      "translation_es": "",
      "item": null,
      "clip": "_clips/450f3a78b2dc0126.mp3"
