      "clip": "_clips/cc5fd09abe2c6ac1.mp3"
    },
    {
      "role": "narrator",
      "lang": "es",
      "text": "Otra vez. «¿Sabes hablar inglés?».",
      "kind": "prompt",
      "pause": 4.0,
