    },
    {
      "role": "narrator",
      "lang": "es",
      "text": "Conversación guiada. Yo te digo la situación, tú hablas, y luego lo oyes.",
      "kind": "instruction",
      "pause": 0.6,
      "translation_es": "",
      "item": null,
      "clip": "_clips/9245463fec500642.mp3"
    },
    {
      "role": "narrator",
      "lang": "es",
      "text": "Saluda y pregúntale si sabe hablar inglés.",
      "kind": "prompt",
      "pause": 4.0,
      "translation_es": "",
      "item": null,
      "clip": "_clips/76c3fbca37d2c163.mp3"
    },
    {
      "role": "native_m",
      "lang": "tl",
      "text": "Marunong ka bang mag-Ingles?",
      "kind": "phrase",
      "pause": 3.5,
      "translation_es": "¿Sabes hablar inglés?",
      "item": "marunong-ingles",
      "clip": "_clips/366253aacc1f79db.mp3"
    },
    {
      "role": "narrator",
      "lang": "es",
      "text": "Te dice que no. Pregúntale si te entiende.",
      "kind": "prompt",
      "pause": 4.0,
      "translation_es": "",
      "item": null,
      "clip": "_clips/be03061f4e491f33.mp3"
