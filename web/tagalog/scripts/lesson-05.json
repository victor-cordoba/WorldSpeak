    },
    {
      "term": "Paano pumunta sa Tondo?",
      "es": "¿Cómo se va a Tondo?"
    },
    {
      "term": "Malayo ba?",
      "es": "¿Está lejos?"
    },
    {
      "term": "Kumanan ka. / Kumaliwa ka.",
      "es": "Gira a la derecha. / Gira a la izquierda."
    },
    {
      "term": "Para po!",
      "es": "¡Pare aquí! (en el jeepney)"
    }
  ],
