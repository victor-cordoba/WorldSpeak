    },
    {
      "role": "native_f",
      "lang": "tl",
      "text": "Ako rin! Malapit lang ang bahay ko.",
      "kind": "dialogue",
      "pause": 0.8,
      "translation_es": "¡Yo también! Mi casa está aquí cerca.",
      "item": null,
      "clip": "_clips/acd81071df557f38.mp3"
    },
    {
      "role": "native_m",
      "lang": "tl",
      "text": "Sino siya?",
      "kind": "dialogue",
      "pause": 0.8,
      "translation_es": "¿Quién es ella?",
      "item": null,
      "clip": "_clips/9a6fc7c491d35c9a.mp3"
    },
    {
      "role": "native_f",
      "lang": "tl",
      "text": "Kaibigan ko. Ikaw din, kaibigan ko na!",
      "kind": "dialogue",
      "pause": 0.8,
      "translation_es": "Mi amiga. ¡Tú también, ya eres mi amigo!",
      "item": null,
      "clip": "_clips/4d72b0d39c098563.mp3"
    },
