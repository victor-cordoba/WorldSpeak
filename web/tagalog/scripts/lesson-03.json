      "clip": "_clips/b8284c836e772333.mp3"
    },
    {
      "role": "native_m",
      "lang": "tl",
      "text": "Ako si Javier. Gutom ako!",
      "kind": "dialogue",
      "pause": 0.8,
      "translation_es": "Yo soy Javier. ¡Tengo hambre!",
      "item": null,
      "clip": "_clips/c5cd9c11225ff931.mp3"
    },
    {
      "role": "native_f",
      "lang": "tl",
      "text": "Ako rin! Malapit lang ang bahay ko.",
      "kind": "dialogue",
      "pause": 0.8,
      "translation_es": "¡Yo también! Mi casa está aquí cerca.",
      "item": null,
      "clip": "_clips/1f6badb9f26fa2f7.mp3"
    },
    {
      "role": "native_m",
      "lang": "tl",
      "text": "Sino siya?",
      "kind": "dialogue",
      "pause": 0.8,
      "translation_es": "¿Quién es ella?",
      "item": null,
      "clip": "_clips/8b913dbf8fbb5ff4.mp3"
    },
    {
      "role": "native_f",
      "lang": "tl",
      "text": "Kaibigan ko. Ikaw din, kaibigan ko na!",
      "kind": "dialogue",
      "pause": 0.8,
      "translation_es": "Mi amiga. ¡Tú también, ya eres mi amigo!",
      "item": null,
      "clip": "_clips/ef77f746944bd564.mp3"
    },
