      "clip": "_clips/11aa53d3badaa8ec.mp3"
    },
    {
      "role": "native_m",
      "lang": "tl",
      "text": "Ako si Víctor. Gutom ako!",
      "kind": "dialogue",
      "pause": 0.8,
      "translation_es": "Yo soy Víctor. ¡Tengo hambre!",
      "item": null,
