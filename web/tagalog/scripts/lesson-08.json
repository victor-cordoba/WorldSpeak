      "kind": "phrase",
      "pause": 2.5,
      "translation_es": "vosotros, usted / ellos",
      "item": "kayo-sila"
    },
    {
      "role": "narrator",
      "lang": "es",
      "text": "Y ahora, «¡Vamos».",
      "kind": "prompt",
      "pause": 4.0,
      "translation_es": "",
      "item": null
    },
    {
      "role": "native_m",
      "lang": "tl",
      "text": "Tara!",
      "kind": "phrase",
      "pause": 2.5,
      "translation_es": "¡Vamos!",
      "item": "tara"
    },
    {
      "role": "narrator",
      "lang": "es",
      "text": "¿Cómo se dice «Un momento»?",
      "kind": "prompt",
      "pause": 4.0,
      "translation_es": "",
      "item": null
    },
    {
      "role": "native_f",
      "lang": "tl",
      "text": "Sandali lang.",
      "kind": "phrase",
      "pause": 2.5,
      "translation_es": "Un momento.",
      "item": "sandali-lang"
    },
    {
      "role": "narrator",
      "lang": "es",
      "text": "Di: «Perdón, disculpa».",
      "kind": "prompt",
      "pause": 4.0,
      "translation_es": "",
      "item": null
    },
    {
      "role": "native_m",
      "lang": "tl",
      "text": "Pasensya na po.",
      "kind": "phrase",
      "pause": 2.5,
      "translation_es": "Perdón, disculpa.",
      "item": "pasensya-na-po"
    },
    {
      "role": "narrator",
      "lang": "es",
      "text": "Otra vez. «¿Cómo se dice 'agua' en Tagalog?».",
      "kind": "prompt",
      "pause": 4.0,
      "translation_es": "",
      "item": null
    },
    {
      "role": "native_f",
      "lang": "tl",
      "text": "Ano sa Tagalog ang 'agua'?",
      "kind": "phrase",
      "pause": 3.5,
      "translation_es": "¿Cómo se dice 'agua' en Tagalog?",
      "item": "ano-sa-tagalog"
    },
    {
      "role": "narrator",
      "lang": "es",
      "text": "Y ahora, «De nada».",
      "kind": "prompt",
      "pause": 4.0,
      "translation_es": "",
      "item": null
    },
    {
      "role": "native_m",
      "lang": "tl",
      "text": "Walang anuman.",
      "kind": "phrase",
      "pause": 2.5,
      "translation_es": "De nada.",
      "item": "walang-anuman"
    },
    {
      "role": "narrator",
      "lang": "es",
      "text": "Escucha la conversación completa una vez más. Ahora la entiendes entera.",
      "kind": "instruction",
      "pause": 0.6,
      "translation_es": "",
      "item": null
    },
    {
      "role": "native_m",
      "lang": "tl",
      "text": "Magandang hapon po! Kumusta kayo?",
      "kind": "dialogue",
      "pause": 0.8,
      "translation_es": "¡Buenas tardes! ¿Cómo están?",
      "item": null
    },
    {
      "role": "native_f",
      "lang": "tl",
      "text": "Mabuti naman. Ako si Marites. Ikaw?",
      "kind": "dialogue",
      "pause": 0.8,
      "translation_es": "Bien. Yo soy Marites. ¿Y tú?",
      "item": null
    },
    {
      "role": "native_m",
      "lang": "tl",
      "text": "Ako si Víctor. Taga-Espanya kami.",
      "kind": "dialogue",
      "pause": 0.8,
      "translation_es": "Soy Víctor. Somos de España.",
      "item": null
    },
    {
      "role": "native_f",
      "lang": "tl",
      "text": "Marunong ka bang mag-Tagalog?",
      "kind": "dialogue",
      "pause": 0.8,
      "translation_es": "¿Sabes hablar Tagalog?",
      "item": null
    },
    {
      "role": "native_m",
      "lang": "tl",
      "text": "Konti lang. Sandali lang po… Ano sa Tagalog ang 'agua'?",
      "kind": "dialogue",
      "pause": 0.8,
      "translation_es": "Solo un poco. Un momento… ¿cómo se dice 'agua' en Tagalog?",
      "item": null
    },
    {
      "role": "native_f",
      "lang": "tl",
      "text": "Tubig! Tara, kain tayo!",
      "kind": "dialogue",
      "pause": 0.8,
      "translation_es": "¡Tubig! ¡Venga, comamos!",
      "item": null
    },
    {
      "role": "native_m",
      "lang": "tl",
      "text": "Sige! Salamat po. Pasensya na po, konti lang.",
      "kind": "dialogue",
      "pause": 0.8,
      "translation_es": "¡Vale! Gracias. Perdón, solo sé un poco.",
      "item": null
    },
    {
      "role": "native_f",
      "lang": "tl",
      "text": "Walang anuman. Ingat ka!",
      "kind": "dialogue",
      "pause": 0.8,
      "translation_es": "De nada. ¡Cuídate!",
      "item": null
    },
    {
      "role": "narrator",
      "lang": "es",
      "text": "Hasta la próxima lección. Ingat ka!",
