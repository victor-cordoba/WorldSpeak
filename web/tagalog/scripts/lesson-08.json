      "pause": 4.0,
      "translation_es": "",
      "item": null
    },
    {
      "role": "native_f",
      "lang": "tl",
      "text": "Magkano po ito?",
      "kind": "phrase",
      "pause": 2.5,
      "translation_es": "¿Cuánto cuesta esto?",
      "item": "magkano-po-ito"
    },
    {
      "role": "narrator",
      "lang": "es",
      "text": "¿Cómo se dice «Quiero agua»?",
      "kind": "prompt",
      "pause": 4.0,
      "translation_es": "",
      "item": null
    },
    {
      "role": "native_m",
      "lang": "tl",
      "text": "Gusto ko ng tubig.",
      "kind": "phrase",
