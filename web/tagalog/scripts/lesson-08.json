      "translation_es": "Quiero agua.",
      "item": "gusto-ko-ng"
    },
    {
      "role": "narrator",
      "lang": "es",
      "text": "Di: «¿Por qué?».",
      "kind": "prompt",
      "pause": 4.0,
      "translation_es": "",
      "item": null
    },
    {
      "role": "native_f",
      "lang": "tl",
      "text": "Bakit?",
      "kind": "phrase",
      "pause": 2.5,
      "translation_es": "¿Por qué?",
      "item": "bakit"
    },
    {
      "role": "narrator",
      "lang": "es",
      "text": "Repaso final. Todo lo de hoy.",
      "kind": "instruction",
      "pause": 0.5,
      "translation_es": "",
      "item": null
    },
    {
      "role": "narrator",
      "lang": "es",
      "text": "Di: «nosotros (sin ti) / nosotros (contigo)».",
      "kind": "prompt",
      "pause": 4.0,
      "translation_es": "",
      "item": null
    },
    {
      "role": "native_m",
      "lang": "tl",
      "text": "kami / tayo",
      "kind": "phrase",
      "pause": 2.5,
      "translation_es": "nosotros (sin ti) / nosotros (contigo)",
      "item": "kami-tayo"
    },
    {
      "role": "narrator",
      "lang": "es",
      "text": "Otra vez. «vosotros, usted / ellos».",
      "kind": "prompt",
      "pause": 4.0,
      "translation_es": "",
      "item": null
    },
    {
      "role": "native_f",
      "lang": "tl",
