    },
    {
      "start": 229.111,
      "end": 231.205,
      "text": "Pregunta para entender si alguien está asustado."
    },
    {
      "start": 231.705,
      "end": 232.923,
      "text": "¿Cómo se dice «¿Tienes miedo?»?"
    },
    {
      "start": 236.923,
      "end": 238.763,
      "text": "Takot ka ba?"
    },
    {
      "start": 241.263,
