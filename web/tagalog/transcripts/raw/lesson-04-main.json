    },
    {
      "start": 216.57,
      "end": 223.31,
      "text": "Ano ito? ¿qué es esto? Ano ang… ¿cuál es…?"
    },
    {
      "start": 223.81,
      "end": 227.231,
      "text": "¿Cómo se dice «¿Qué? / ¿Cuál?»?"
    },
    {
      "start": 231.231,
      "end": 231.859,
      "text": "Ano?"
    },
    {
      "start": 234.359,
