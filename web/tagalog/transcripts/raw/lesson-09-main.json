    },
    {
      "start": 391.48,
      "end": 393.16,
      "text": "Nasa bahay ako."
    },
    {
      "start": 394.36,
      "end": 396.679,
      "text": "Nandito / Nandoon."
    },
    {
      "start": 398.679,
      "end": 399.823,
      "text": "«Aquí / Allí»."
    },
    {
      "start": 400.323,
      "end": 402.641,
      "text": "Nandito / Nandoon."
    },
    {
      "start": 403.841,
      "end": 405.414,
      "text": "Wala siya dito."
