    },
    {
      "start": 417.554,
      "end": 421.855,
      "text": "Conversación guiada. Yo te digo la situación, tú hablas, y luego lo oyes."
    },
    {
      "start": 422.455,
      "end": 424.301,
      "text": "Pregunta a alguien dónde está su casa."
    },
    {
      "start": 428.301,
      "end": 429.261,
      "text": "Saan ang bahay mo?"
    },
    {
      "start": 431.761,
      "end": 433.247,
      "text": "Responde que estás en casa."
    },
    {
      "start": 437.247,
      "end": 438.287,
      "text": "Nasa bahay ako."
    },
    {
      "start": 440.787,
      "end": 442.744,
      "text": "Repaso final. Todo lo de hoy."
