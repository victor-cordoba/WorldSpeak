    {
      "start": 587.78,
      "end": 589.086,
      "text": "Saan ang bahay mo?"
    },
    {
      "start": 591.586,
      "end": 593.18,
      "text": "Responde que estás en casa."
    },
    {
      "start": 597.18,
      "end": 598.721,
      "text": "Nasa bahay ako."
    },
    {
      "start": 601.221,
      "end": 603.337,
