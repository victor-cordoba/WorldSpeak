    },
    {
      "start": 482.646,
      "end": 488.289,
      "text": "Conversación guiada. Yo te digo la situación, tú hablas, y luego lo oyes."
    },
    {
      "start": 488.889,
      "end": 490.51,
      "text": "Pregúntale cuándo va a casa."
    },
    {
      "start": 494.51,
      "end": 495.086,
      "text": "Kailan?"
    },
    {
      "start": 497.586,
      "end": 500.106,
      "text": "Te dice que mañana. Pregunta por qué."
    },
    {
      "start": 504.106,
