      "text": "Reseta"
    },
    {
      "start": 281.762,
      "end": 283.904,
      "text": "Un momento. Volvamos atrás."
    },
    {
      "start": 284.304,
      "end": 286.368,
      "text": "Y ahora, «Me duele la cabeza»."
    },
    {
      "start": 290.368,
