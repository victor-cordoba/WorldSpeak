      "start": 797.252,
      "end": 800.62,
      "text": "Como hay tiempo, repasemos de nuevo lo anterior."
    },
    {
      "start": 801.12,
      "end": 802.188,
      "text": ""
    },
    {
      "start": 802.688,
      "end": 804.318,
      "text": "¿Cómo se dice «¿Cómo estás?»?"
    },
    {
      "start": 808.318,
      "end": 808.958,
      "text": "Kumusta ka?"
    },
    {
      "start": 811.458,
      "end": 814.858,
      "text": "Di: «Soy Javier. / Me llamo Javier»."
    },
    {
      "start": 818.858,
      "end": 819.818,
      "text": "Ako si Javier."
    },
    {
      "start": 822.318,
      "end": 825.019,
      "text": "¿Cómo se dice «¿Cómo te llamas?»?"
    },
    {
      "start": 829.019,
      "end": 829.899,
      "text": "Anong pangalan mo?"
    },
    {
      "start": 832.399,
      "end": 834.686,
      "text": "Di: «¿Sabes hablar Tagalog?»."
    },
    {
      "start": 838.686,
      "end": 840.432,
      "text": "Marunong ka bang mag-Tagalog?"
    },
    {
      "start": 843.932,
      "end": 846.216,
      "text": "¿Cómo se dice «¿Dónde vives?»?"
    },
    {
      "start": 850.216,
      "end": 851.336,
      "text": "Saan ka nakatira?"
    },
    {
      "start": 853.836,
      "end": 856.297,
      "text": "Di: «¿Cuánto cuesta esto?»."
    },
    {
      "start": 860.297,
      "end": 861.113,
      "text": "Magkano po ito?"
    },
    {
      "start": 863.613,
      "end": 865.4,
      "text": "¿Cómo se dice «Quiero agua»?"
    },
    {
      "start": 869.4,
      "end": 870.68,
      "text": "Gusto ko ng tubig."
    },
    {
      "start": 873.18,
      "end": 874.384,
      "text": "Di: «¿Por qué?»."
    },
    {
      "start": 878.384,
      "end": 879.022,
      "text": "Bakit?"
    },
    {
      "start": 881.522,
      "end": 883.769,
      "text": "¿Cómo se dice «Quiero ir a Divisoria»?"
    },
    {
      "start": 887.769,
      "end": 889.529,
      "text": "Gusto kong pumunta sa Divisoria."
    },
    {
      "start": 893.029,
      "end": 894.935,
      "text": "Di: «¿Quién es él/ella?»."
    },
    {
      "start": 898.935,
      "end": 899.575,
      "text": "Sino siya?"
    },
    {
      "start": 902.075,
      "end": 904.536,
      "text": "Repaso final. Todo lo de hoy."
    },
    {
      "start": 905.036,
      "end": 910.236,
      "text": "Di: «nosotros (sin ti) / nosotros (contigo)»."
    },
    {
      "start": 914.236,
      "end": 915.836,
      "text": "kami / tayo"
    },
    {
      "start": 918.336,
      "end": 922.144,
      "text": "Otra vez. «vosotros, usted / ellos»."
    },
    {
      "start": 926.144,
      "end": 928.064,
      "text": "kayo / sila"
    },
    {
      "start": 930.564,
      "end": 932.143,
      "text": "Y ahora, «¡Vamos»."
    },
    {
      "start": 936.143,
      "end": 936.993,
      "text": "Tara!"
    },
    {
      "start": 939.493,
      "end": 941.449,
      "text": "¿Cómo se dice «Un momento»?"
    },
    {
      "start": 945.449,
      "end": 946.312,
      "text": "Sandali lang."
    },
    {
      "start": 948.812,
      "end": 950.809,
      "text": "Di: «Perdón, disculpa»."
    },
    {
      "start": 954.809,
      "end": 955.657,
      "text": "Pasensya na po."
    },
    {
      "start": 958.157,
      "end": 961.919,
      "text": "Otra vez. «¿Cómo se dice 'agua' en Tagalog?»."
    },
    {
      "start": 965.919,
      "end": 967.839,
      "text": "Ano sa Tagalog ang 'agua'?"
    },
    {
      "start": 971.339,
      "end": 973.15,
      "text": "Y ahora, «De nada»."
    },
    {
      "start": 977.15,
      "end": 978.03,
      "text": "Walang anuman."
    },
    {
      "start": 980.53,
      "end": 986.195,
      "text": "Escucha la conversación completa una vez más. Ahora la entiendes entera."
    },
    {
      "start": 986.795,
      "end": 989.111,
      "text": "Magandang hapon po! Kumusta kayo?"
    },
    {
      "start": 989.911,
      "end": 993.751,
      "text": "Mabuti naman. Ako si Marites. Ikaw?"
    },
    {
      "start": 994.551,
      "end": 997.107,
      "text": "Ako si Javier. Taga-Espanya kami."
    },
    {
      "start": 997.907,
      "end": 1000.067,
      "text": "Marunong ka bang mag-Tagalog?"
    },
    {
      "start": 1000.867,
      "end": 1006.067,
      "text": "Konti lang. Sandali lang po… Ano sa Tagalog ang 'agua'?"
    },
    {
      "start": 1006.867,
      "end": 1009.766,
      "text": "Tubig! Tara, kain tayo!"
    },
    {
      "start": 1010.566,
      "end": 1013.846,
      "text": "Sige! Salamat po. Pasensya na po, konti lang."
    },
    {
      "start": 1014.646,
      "end": 1016.967,
      "text": "Walang anuman. Ingat ka!"
    },
    {
      "start": 1017.767,
      "end": 1020.739,
      "text": "Hasta la próxima lección. Ingat ka!"
