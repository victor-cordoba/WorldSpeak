    },
    {
      "start": 119.816,
      "end": 125.706,
      "text": "El sujeto. Ako si Javier. Gutom ako = tengo hambre (hambriento yo)."
    },
    {
      "start": 126.206,
      "end": 127.434,
      "text": "¿Cómo se dice «yo»?"
    },
    {
      "start": 131.434,
      "end": 131.973,
      "text": "ako"
    },
    {
      "start": 134.473,
      "end": 135.883,
      "text": "Otra vez. «yo»."
    },
    {
      "start": 139.883,
      "end": 140.422,
      "text": "ako"
    },
    {
      "start": 142.922,
      "end": 144.881,
      "text": "«tú». Escucha y repite."
    },
    {
      "start": 145.381,
      "end": 147.861,
      "text": "ikaw / ka"
    },
    {
      "start": 150.361,
