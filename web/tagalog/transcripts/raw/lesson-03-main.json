      "text": "kaw"
    },
    {
      "start": 411.899,
      "end": 412.379,
      "text": "Ikaw"
    },
    {
      "start": 413.579,
      "end": 414.049,
      "text": "Ikaw?"
    },
    {
      "start": 416.549,
      "end": 417.02,
      "text": "Ikaw?"
    },
    {
      "start": 418.22,
      "end": 422.321,
      "text": "Para devolver la pregunta. Ikaw solo, con entonación de pregunta."
    },
    {
      "start": 422.821,
      "end": 424.363,
      "text": "¿Cómo se dice «¿Y tú?»?"
    },
    {
      "start": 428.363,
      "end": 428.833,
      "text": "Ikaw?"
    },
    {
      "start": 431.333,
      "end": 432.692,
      "text": "Otra vez. «¿Y tú?»."
    },
    {
      "start": 436.692,
      "end": 437.163,
      "text": "Ikaw?"
    },
    {
      "start": 439.663,
      "end": 443.868,
      "text": "«Tengo hambre». Literalmente, hambriento yo. Escucha y repite."
    },
    {
      "start": 444.368,
      "end": 445.408,
      "text": "Gutom ako."
    },
    {
      "start": 447.908,
      "end": 449.748,
      "text": "ko"
    },
    {
      "start": 450.948,
      "end": 451.487,
      "text": "ako"
    },
    {
      "start": 452.687,
      "end": 453.647,
      "text": "Gutom ako"
    },
    {
      "start": 456.147,
