      "text": "mo"
    },
    {
      "start": 258.108,
      "end": 261.896,
      "text": "pangalan mo = tu nombre. gusto mo = tú quieres."
    },
    {
      "start": 262.396,
      "end": 265.661,
      "text": "¿Cómo se dice «tu / tú (agente)»?"
    },
    {
      "start": 269.661,
      "end": 270.221,
      "text": "mo"
    },
    {
      "start": 272.721,
      "end": 275.568,
      "text": "Otra vez. «tu / tú (agente)»."
    },
    {
      "start": 279.568,
      "end": 280.128,
      "text": "mo"
    },
    {
      "start": 282.628,
      "end": 284.771,
      "text": "Un momento. Volvamos atrás."
    },
    {
      "start": 285.171,
      "end": 286.398,
      "text": "Y ahora, «tú»."
    },
    {
      "start": 290.398,
