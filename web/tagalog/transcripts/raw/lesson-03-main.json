      "text": "siya"
    },
    {
      "start": 333.033,
      "end": 335.227,
      "text": "Otra vez. «él / ella»."
    },
    {
      "start": 339.227,
      "end": 341.467,
      "text": "siya"
    },
    {
      "start": 343.967,
      "end": 348.068,
      "text": "«Mi casa». Literalmente, casa mi. Escucha y repite."
    },
    {
      "start": 348.568,
      "end": 350.408,
      "text": "Bahay ko."
    },
    {
      "start": 352.908,
      "end": 354.748,
      "text": "ko"
    },
    {
      "start": 355.948,
      "end": 356.668,
      "text": "Bahay ko"
    },
    {
      "start": 359.168,
      "end": 361.008,
      "text": "Bahay ko."
    },
    {
      "start": 363.508,
      "end": 365.348,
      "text": "Bahay ko."
    },
    {
      "start": 366.548,
      "end": 369.944,
      "text": "Al revés que en español: primero la cosa, luego de quién."
    },
    {
      "start": 370.444,
      "end": 371.907,
      "text": "¿Cómo se dice «Mi casa»?"
    },
    {
      "start": 375.907,
