  "segments": [
    {
      "start": 0.8,
      "end": 4.3,
      "text": "Lección tres. Yo, tú, mi, tu."
    },
    {
      "start": 4.9,
      "end": 9.942,
      "text": "Sentado con un amigo nuevo en un banco. Habláis de vosotros. Escucha la conversación."
    },
    {
      "start": 10.742,
      "end": 12.982,
      "text": "Ako si Marites. Ikaw?"
    },
    {
      "start": 13.782,
      "end": 16.822,
      "text": "Ako si Javier. Gutom ako!"
    },
    {
      "start": 17.622,
      "end": 20.502,
      "text": "Ako rin! Malapit lang ang bahay ko."
    },
    {
      "start": 21.302,
      "end": 21.942,
      "text": "Sino siya?"
    },
    {
      "start": 22.742,
      "end": 26.902,
      "text": "Kaibigan ko. Ikaw din, kaibigan ko na!"
    },
    {
      "start": 27.702,
      "end": 35.905,
      "text": "Los pronombres que hacen funcionar todo: ako, ka, ko, mo, siya. Al terminar, esta conversación la vas a hacer tú."
    },
    {
      "start": 36.705,
      "end": 38.638,
      "text": "Antes de empezar, repasemos."
    },
    {
      "start": 39.138,
      "end": 41.149,
      "text": "¿Cómo se dice «Repite, por favor»?"
    },
    {
      "start": 45.149,
      "end": 46.189,
      "text": "Ulitin mo po."
    },
    {
      "start": 48.689,
      "end": 50.283,
      "text": "Di: «¿Me entiendes?»."
    },
    {
      "start": 54.283,
      "end": 55.323,
      "text": "Naiintindihan mo ba?"
    },
    {
      "start": 57.823,
      "end": 59.649,
      "text": "¿Cómo se dice «Solo un poco»?"
    },
    {
      "start": 63.649,
      "end": 64.59,
      "text": "Konti lang."
    },
    {
      "start": 67.09,
      "end": 68.501,
      "text": "Di: «No lo sé»."
    },
    {
      "start": 72.501,
      "end": 73.141,
      "text": "Hindi ko alam."
    },
    {
      "start": 75.641,
      "end": 77.705,
      "text": "¿Cómo se dice «¿Sabes hablar Tagalog?»?"
    },
    {
      "start": 81.705,
      "end": 83.451,
      "text": "Marunong ka bang mag-Tagalog?"
    },
    {
      "start": 86.951,
      "end": 88.493,
      "text": "Di: «¿Cómo te llamas?»."
    },
    {
      "start": 92.493,
      "end": 93.373,
      "text": "Anong pangalan mo?"
    },
    {
      "start": 95.873,
      "end": 97.388,
      "text": "¿Cómo se dice «Gracias»?"
    },
    {
      "start": 101.388,
      "end": 102.028,
      "text": "Salamat po."
    },
    {
      "start": 104.528,
      "end": 106.722,
      "text": "«yo». Escucha y repite."
    },
    {
      "start": 107.222,
      "end": 107.761,
      "text": "ako"
    },
    {
      "start": 110.261,
      "end": 112.101,
      "text": "ko"
    },
    {
      "start": 113.301,
