    {
      "start": 0.8,
      "end": 3.199,
      "text": "Lección 2. ¿Hablas Tagalog?."
    },
    {
      "start": 3.799,
      "end": 9.08,
      "text": "Un chico se te acerca en la parroquia. Quiere saber si le entiendes. Escucha la conversación."
    },
    {
      "start": 9.88,
      "end": 13.8,
      "text": "Kumusta po? Marunong ka bang mag-Tagalog?"
    },
    {
      "start": 14.6,
      "end": 17.96,
      "text": "Konti lang. Marunong ka bang mag-Ingles?"
    },
    {
      "start": 18.76,
      "end": 21.0,
      "text": "Hindi po. Hindi ako marunong."
    },
    {
      "start": 21.8,
      "end": 25.4,
      "text": "Sige. Ulitin mo po? Naiintindihan mo ba?"
    },
    {
      "start": 26.2,
      "end": 27.72,
      "text": "Opo! Konti lang."
    },
    {
      "start": 28.52,
      "end": 36.521,
      "text": "Preguntar si saben Tagalog o inglés, decir que un poco, y entender sí, no y no sé. Al terminar, esta conversación la vas a hacer tú."
    },
    {
      "start": 37.321,
      "end": 39.357,
      "text": "Antes de empezar, repasemos."
    },
    {
      "start": 39.857,
      "end": 41.372,
      "text": "¿Cómo se dice «¿Cómo estás?»?"
    },
    {
      "start": 45.372,
      "end": 46.492,
      "text": "Kumusta ka?"
    },
    {
      "start": 48.992,
      "end": 51.693,
      "text": "Di: «Soy Javier. / Me llamo Javier»."
    },
    {
      "start": 55.693,
      "end": 57.933,
      "text": "Ako si Javier."
    },
    {
      "start": 60.433,
      "end": 62.068,
      "text": "¿Cómo se dice «¿Cómo te llamas?»?"
    },
    {
      "start": 66.068,
      "end": 67.428,
      "text": "Anong pangalan mo?"
    },
    {
      "start": 69.928,
      "end": 71.268,
      "text": "Di: «Gracias»."
    },
    {
      "start": 75.268,
