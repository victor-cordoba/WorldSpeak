      "text": "Opo."
    },
    {
      "start": 66.886,
      "end": 69.315,
      "text": "Di: «No hay. / No tengo»."
    },
    {
      "start": 73.315,
      "end": 74.256,
      "text": "Wala."
    },
    {
      "start": 76.756,
