  "segments": [
    {
      "start": 0.8,
      "end": 3.047,
      "text": "Lección doce. ¿De qué trabajas?"
    },
    {
      "start": 3.647,
      "end": 10.438,
      "text": "En una calle de Tondo, un voluntario español charla con un residente local sobre su ocupación. Escucha la conversación."
    },
    {
      "start": 11.238,
      "end": 11.878,
      "text": "Kumusta ka?"
    },
    {
      "start": 12.678,
      "end": 15.447,
      "text": "Mabuti naman. Anong trabaho mo?"
    },
    {
      "start": 16.247,
      "end": 18.007,
      "text": "Drayber ako. Ikaw?"
    },
    {
      "start": 18.807,
      "end": 21.039,
      "text": "Nagtitinda ako sa palengke."
    },
    {
      "start": 21.839,
      "end": 23.279,
      "text": "May negosyo ka ba?"
    },
    {
      "start": 24.079,
      "end": 27.029,
      "text": "Walang negosyo, pero may sweldo naman."
    },
    {
      "start": 27.829,
      "end": 33.55,
      "text": "Aprender a preguntar y responder sobre ocupaciones. Al terminar, esta conversación la vas a hacer tú."
    },
    {
      "start": 34.35,
      "end": 36.283,
      "text": "Antes de empezar, repasemos."
    },
    {
      "start": 36.783,
      "end": 38.429,
      "text": "¿Cómo se dice «Ya es mayor»?"
    },
    {
      "start": 42.429,
      "end": 43.147,
      "text": "Matanda na."
    },
    {
      "start": 45.647,
      "end": 47.418,
      "text": "Di: «Es todavía joven»."
    },
    {
      "start": 51.418,
      "end": 52.298,
      "text": "Bata pa siya."
    },
    {
      "start": 54.798,
      "end": 56.94,
      "text": "¿Cómo se dice «¿Tienes familia?»?"
    },
    {
      "start": 60.94,
      "end": 62.06,
      "text": "May pamilya ka ba?"
    },
    {
      "start": 64.56,
      "end": 66.858,
      "text": "Di: «¿Cuántos sois en la familia?»."
    },
    {
      "start": 70.858,
      "end": 72.058,
      "text": "Ilan kayo sa pamilya?"
    },
    {
      "start": 74.558,
      "end": 76.387,
      "text": "¿Cómo se dice «¿Dónde vives?»?"
    },
    {
      "start": 80.387,
      "end": 81.507,
      "text": "Saan ka nakatira?"
    },
    {
      "start": 84.007,
      "end": 85.703,
      "text": "Di: «¿Cómo estás?»."
    },
    {
      "start": 89.703,
      "end": 90.343,
      "text": "Kumusta ka?"
    },
    {
      "start": 92.843,
      "end": 95.142,
      "text": "¿Cómo se dice «Bien, gracias»?"
    },
    {
      "start": 99.142,
      "end": 100.262,
      "text": "Mabuti naman."
    },
    {
      "start": 102.762,
      "end": 107.464,
      "text": "«¿De qué trabajas?». Literalmente, ¿Qué trabajo tuyo?. Escucha y repite."
    },
    {
      "start": 107.964,
      "end": 109.084,
      "text": "Anong trabaho mo?"
    },
    {
      "start": 111.584,
      "end": 112.144,
      "text": "mo"
    },
    {
      "start": 113.344,
      "end": 115.904,
      "text": "trabaho mo"
    },
    {
      "start": 118.404,
      "end": 119.353,
      "text": "Anong trabaho mo"
    },
    {
      "start": 121.853,
      "end": 122.973,
      "text": "Anong trabaho mo?"
    },
    {
      "start": 125.473,
      "end": 126.593,
      "text": "Anong trabaho mo?"
    },
    {
      "start": 127.793,
      "end": 130.868,
      "text": "Útil para conocer a alguien y saber su ocupación."
    },
    {
      "start": 131.368,
      "end": 133.51,
      "text": "¿Cómo se dice «¿De qué trabajas?»?"
    },
    {
      "start": 137.51,
      "end": 138.63,
      "text": "Anong trabaho mo?"
    },
    {
      "start": 141.13,
      "end": 143.007,
      "text": "Otra vez. «¿De qué trabajas?»."
    },
    {
      "start": 147.007,
      "end": 148.127,
      "text": "Anong trabaho mo?"
    },
    {
      "start": 150.627,
      "end": 152.688,
      "text": "«Sueldo». Escucha y repite."
    },
    {
      "start": 153.188,
      "end": 153.748,
      "text": "Sweldo"
    },
    {
      "start": 156.248,
      "end": 158.648,
      "text": "do"
    },
    {
      "start": 159.848,
      "end": 160.408,
      "text": "Sweldo"
    },
    {
      "start": 161.608,
      "end": 162.169,
      "text": "Sweldo"
    },
    {
      "start": 164.669,
      "end": 165.229,
      "text": "Sweldo"
    },
    {
      "start": 166.429,
      "end": 168.544,
      "text": "Préstamo del español 'sueldo'."
    },
    {
      "start": 169.044,
      "end": 170.454,
      "text": "¿Cómo se dice «Sueldo»?"
    },
    {
      "start": 174.454,
      "end": 175.014,
      "text": "Sweldo"
    },
    {
      "start": 177.514,
      "end": 179.343,
      "text": "Otra vez. «Sueldo»."
    },
    {
      "start": 183.343,
      "end": 183.903,
      "text": "Sweldo"
    },
    {
      "start": 186.403,
      "end": 191.445,
      "text": "«¿Tienes trabajo?». Literalmente, ¿Hay trabajo tú?. Escucha y repite."
    },
    {
      "start": 191.945,
      "end": 192.905,
      "text": "May trabaho ka ba?"
    },
    {
      "start": 195.405,
      "end": 196.845,
      "text": "ba"
    },
    {
      "start": 198.045,
      "end": 198.925,
      "text": "ka ba"
    },
    {
      "start": 201.425,
      "end": 202.35,
      "text": "trabaho ka ba"
    },
    {
      "start": 204.85,
      "end": 205.97,
      "text": "May trabaho ka ba"
    },
    {
      "start": 208.47,
      "end": 209.43,
      "text": "May trabaho ka ba?"
    },
    {
      "start": 211.93,
      "end": 212.89,
      "text": "May trabaho ka ba?"
    },
    {
      "start": 214.09,
      "end": 216.754,
      "text": "Pregunta común para saber si alguien está empleado."
    },
    {
      "start": 217.254,
      "end": 218.952,
      "text": "¿Cómo se dice «¿Tienes trabajo?»?"
    },
    {
      "start": 222.952,
      "end": 223.913,
      "text": "May trabaho ka ba?"
    },
    {
      "start": 226.413,
      "end": 228.241,
      "text": "Otra vez. «¿Tienes trabajo?»."
    },
    {
      "start": 232.241,
      "end": 233.201,
      "text": "May trabaho ka ba?"
    },
    {
      "start": 235.701,
      "end": 238.0,
      "text": "«Conductor». Escucha y repite."
    },
    {
      "start": 238.5,
      "end": 239.86,
      "text": "Drayber"
    },
    {
      "start": 242.36,
      "end": 243.96,
      "text": "ber"
    },
    {
      "start": 245.16,
      "end": 246.52,
      "text": "Drayber"
    },
    {
      "start": 247.72,
      "end": 249.08,
      "text": "Drayber"
    },
    {
      "start": 251.58,
      "end": 252.94,
      "text": "Drayber"
    },
    {
      "start": 254.14,
      "end": 256.073,
      "text": "Préstamo del inglés 'driver'."
    },
    {
      "start": 256.573,
      "end": 258.114,
      "text": "¿Cómo se dice «Conductor»?"
    },
    {
      "start": 262.114,
      "end": 263.474,
      "text": "Drayber"
    },
    {
      "start": 265.974,
      "end": 267.751,
      "text": "Otra vez. «Conductor»."
    },
    {
      "start": 271.751,
      "end": 273.111,
      "text": "Drayber"
    },
    {
      "start": 275.611,
      "end": 277.753,
      "text": "Un momento. Volvamos atrás."
    },
    {
      "start": 278.153,
      "end": 279.563,
      "text": "Y ahora, «Sueldo»."
    },
    {
      "start": 283.563,
      "end": 284.123,
      "text": "Sweldo"
    },
    {
      "start": 286.623,
      "end": 289.419,
      "text": "«Vendedor/a». Escucha y repite."
    },
    {
      "start": 289.919,
      "end": 290.879,
      "text": "Nagtitinda"
    },
    {
      "start": 293.379,
      "end": 294.739,
      "text": "da"
    },
    {
      "start": 295.939,
      "end": 297.765,
      "text": "tinda"
    },
    {
      "start": 298.965,
      "end": 301.656,
      "text": "titinda"
    },
    {
      "start": 302.856,
      "end": 303.816,
      "text": "Nagtitinda"
    },
    {
      "start": 305.016,
      "end": 305.976,
      "text": "Nagtitinda"
    },
    {
      "start": 308.476,
      "end": 309.436,
      "text": "Nagtitinda"
    },
    {
      "start": 310.636,
      "end": 312.461,
      "text": "Persona que vende productos."
    },
    {
      "start": 312.961,
      "end": 314.5,
      "text": "¿Cómo se dice «Vendedor/a»?"
    },
    {
      "start": 318.5,
      "end": 319.46,
      "text": "Nagtitinda"
    },
    {
      "start": 321.96,
      "end": 323.919,
      "text": "Otra vez. «Vendedor/a»."
    },
    {
      "start": 327.919,
      "end": 328.879,
      "text": "Nagtitinda"
    },
    {
      "start": 331.379,
      "end": 334.174,
      "text": "Pregunta sorpresa, de una lección anterior."
    },
    {
      "start": 334.574,
      "end": 382.191,
      "text": "Y ahora, «Sí (con respeto)»."
    },
    {
      "start": 386.191,
      "end": 386.831,
      "text": "Opo."
    },
    {
      "start": 389.331,
      "end": 390.846,
      "text": "Préstamos del español."
    },
    {
      "start": 391.246,
      "end": 402.555,
      "text": "En Tagalog, hay muchas palabras que son préstamos del español, como 'sweldo' para sueldo. Estas palabras mantienen un significado similar y son fáciles de reconocer para los hispanohablantes."
    },
    {
      "start": 403.155,
      "end": 403.715,
      "text": "Sweldo"
    },
    {
      "start": 406.215,
      "end": 406.855,
      "text": "Negosyo"
    },
    {
      "start": 409.355,
      "end": 417.688,
      "text": "Ahora, a entender. Vas a oír respuestas típicas, con otra voz. Escucha, y piensa qué significan. Luego te lo digo."
    },
    {
      "start": 418.288,
      "end": 419.648,
      "text": "Drayber"
    },
    {
      "start": 421.648,
      "end": 422.536,
      "text": "«Conductor»."
    },
    {
      "start": 423.036,
      "end": 424.396,
      "text": "Drayber"
    },
    {
      "start": 425.596,
      "end": 426.78,
      "text": "Nagtitinda"
    },
    {
      "start": 428.78,
      "end": 429.773,
      "text": "«Vendedor/a»."
    },
    {
      "start": 430.273,
      "end": 431.456,
      "text": "Nagtitinda"
    },
    {
      "start": 432.656,
      "end": 434.265,
      "text": "Walang trabaho"
    },
    {
      "start": 436.265,
      "end": 437.31,
      "text": "«Sin trabajo»."
    },
    {
      "start": 437.81,
      "end": 439.419,
      "text": "Walang trabaho"
    },
    {
      "start": 440.619,
      "end": 441.579,
      "text": "Negosyo"
    },
    {
      "start": 443.579,
      "end": 444.519,
      "text": "«Negocio»."
    },
    {
      "start": 445.019,
      "end": 445.979,
      "text": "Negosyo"
    },
    {
      "start": 447.179,
      "end": 452.221,
      "text": "Conversación guiada. Yo te digo la situación, tú hablas, y luego lo oyes."
    },
    {
      "start": 452.821,
      "end": 454.775,
      "text": "Pregunta a alguien de qué trabaja."
    },
    {
      "start": 458.775,
      "end": 459.895,
      "text": "Anong trabaho mo?"
    },
    {
      "start": 462.395,
      "end": 464.224,
      "text": "Responde que eres conductor."
    },
    {
      "start": 468.224,
      "end": 469.584,
      "text": "Drayber"
    },
    {
      "start": 472.084,
      "end": 474.331,
      "text": "Repaso final. Todo lo de hoy."
    },
    {
      "start": 474.831,
      "end": 476.555,
      "text": "Di: «¿De qué trabajas?»."
    },
    {
      "start": 480.555,
      "end": 481.675,
      "text": "Anong trabaho mo?"
    },
    {
      "start": 484.175,
      "end": 486.003,
      "text": "Otra vez. «Sueldo»."
    },
    {
      "start": 490.003,
      "end": 490.563,
      "text": "Sweldo"
    },
    {
      "start": 493.063,
      "end": 494.761,
      "text": "Y ahora, «¿Tienes trabajo?»."
    },
    {
      "start": 498.761,
      "end": 499.721,
      "text": "May trabaho ka ba?"
    },
    {
      "start": 502.221,
      "end": 503.763,
      "text": "¿Cómo se dice «Conductor»?"
    },
    {
      "start": 507.763,
      "end": 509.123,
