    },
    {
      "start": 312.66,
      "end": 314.287,
      "text": "Otra vez. «Vendedor/a»."
    },
    {
      "start": 318.287,
      "end": 319.247,
      "text": "Nagtitinda"
    },
    {
      "start": 321.747,
      "end": 324.067,
      "text": "Pregunta sorpresa, de una lección anterior."
    },
    {
      "start": 324.467,
      "end": 325.7,
      "text": "Y ahora, «Sí (con respeto)»."
    },
    {
      "start": 329.7,
      "end": 330.34,
