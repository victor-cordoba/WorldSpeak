    },
    {
      "start": 164.005,
      "end": 165.125,
      "text": "¿Cómo se dice «Sueldo»?"
    },
    {
      "start": 169.125,
      "end": 169.685,
      "text": "Sweldo"
    },
    {
      "start": 172.185,
      "end": 173.659,
      "text": "Otra vez. «Sueldo»."
