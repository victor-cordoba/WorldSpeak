    {
      "start": 285.852,
      "end": 288.466,
      "text": "Para preguntar si el niño está acompañado."
    },
    {
      "start": 288.966,
      "end": 291.485,
      "text": "¿Cómo se dice «¿Quién está contigo?»?"
    },
    {
      "start": 295.485,
