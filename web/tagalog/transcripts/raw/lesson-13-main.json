    },
    {
      "start": 467.44,
      "end": 471.84,
      "text": "Conversación guiada. Yo te digo la situación, tú hablas, y luego lo oyes."
    },
    {
      "start": 472.44,
      "end": 474.6,
      "text": "Pregúntale a alguien si ya ha comido."
    },
    {
      "start": 478.6,
      "end": 479.64,
      "text": "Kumain ka na ba?"
    },
    {
      "start": 482.14,
      "end": 484.06,
      "text": "Responde que ya has comido."
    },
    {
      "start": 488.06,
      "end": 489.58,
      "text": "Kumain na po ako."
    },
    {
