    {
      "start": 25.614,
      "end": 27.658,
      "kind": "dialogue",
      "text": "Kape. Doon ang bahay ko.",
      "translation_es": "Café. Allí está mi casa.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 28.458,
      "end": 37.192,
      "kind": "explanation",
      "text": "Las tres preguntas que abren cualquier conversación, y entender lo que te contestan. Al terminar, esta conversación la vas a hacer tú.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 37.992,
      "end": 40.472,
      "kind": "instruction",
