{
  "id": "lesson-04-main",
  "title": "Lección 04",
  "summary_es": "Aprendes Saan, Sino y Ano, la receta interrogativa + ka + verbo, aquí/ahí/allí, y a entender respuestas como nakatira ako sa Tondo o malapit lang.",
  "topics": [
    "Saan",
    "Sino",
    "Ano",
    "Dónde vives",
    "Aquí y allí"
  ],
  "dialogue": {
    "tl": [
      "Saan ka nakatira?",
      "Nakatira ako sa Tondo. Malapit lang.",
      "Sino siya?",
      "Kaibigan ko. Ano ito?",
      "Kape. Doon ang bahay ko."
    ],
    "es": [
      "¿Dónde vives?",
      "Vivo en Tondo. Aquí cerca.",
      "¿Quién es ella?",
      "Mi amiga. ¿Qué es esto?",
      "Café. Allí está mi casa."
    ]
  },
  "segments": [
