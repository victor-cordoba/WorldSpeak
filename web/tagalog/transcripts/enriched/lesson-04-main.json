      "note_es": "",
      "language": "en"
    },
    {
      "start": 5.56,
      "end": 13.89,
      "kind": "instruction",
      "text": "En un patio de Tondo. Un vecino te presenta a alguien y te pregunta dónde vives. Escucha la conversación.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 14.69,
      "end": 15.81,
      "kind": "dialogue",
      "text": "Saan ka nakatira?",
      "translation_es": "¿Dónde vives?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 16.61,
      "end": 20.13,
      "kind": "dialogue",
      "text": "Nakatira ako sa Tondo. Malapit lang.",
      "translation_es": "Vivo en Tondo. Aquí cerca.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 20.93,
      "end": 21.57,
      "kind": "dialogue",
      "text": "Sino siya?",
