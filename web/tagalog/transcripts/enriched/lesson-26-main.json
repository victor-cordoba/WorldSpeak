      "note_es": "",
      "language": "tl"
    },
    {
      "start": 25.586,
      "end": 30.577,
      "kind": "explanation",
      "text": "Aprende a preguntar por el menú del día y pedir comida. Al terminar, esta conversación la vas a hacer tú.",
