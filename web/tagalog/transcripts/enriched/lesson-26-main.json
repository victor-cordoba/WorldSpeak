    {
      "start": 3.72,
      "end": 11.195,
      "kind": "instruction",
      "text": "En una karinderya en Tondo, un voluntario español pregunta por el menú del día. Escucha la conversación.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 11.995,
      "end": 13.755,
      "kind": "dialogue",
      "text": "Magandang tanghali po.",
      "translation_es": "Buen mediodía.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 14.555,
      "end": 16.339,
      "kind": "dialogue",
      "text": "Ano po ang ulam ngayon?",
