      "end": 839.893,
      "kind": "phrase",
      "text": "Masarap!",
      "translation_es": "¡Delicioso!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 842.393,
      "end": 846.443,
      "kind": "instruction",
      "text": "Escucha la conversación completa una vez más. Ahora la entiendes entera.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 847.043,
      "end": 848.723,
      "kind": "dialogue",
      "text": "Magandang tanghali po.",
      "translation_es": "Buen mediodía.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 849.523,
      "end": 851.283,
      "kind": "dialogue",
      "text": "Ano po ang ulam ngayon?",
      "translation_es": "¿Cuál es el plato del día?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 852.083,
      "end": 855.443,
      "kind": "dialogue",
      "text": "May sisig, pancit, at adobo po.",
      "translation_es": "Hay sisig, pancit y adobo.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 856.243,
      "end": 858.243,
      "kind": "dialogue",
      "text": "Masarap po ang adobo.",
      "translation_es": "El adobo está delicioso.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 859.043,
      "end": 861.443,
      "kind": "dialogue",
      "text": "Pahingi po ng kanin.",
      "translation_es": "Deme arroz, por favor.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 862.243,
      "end": 864.083,
      "kind": "dialogue",
      "text": "Sige po, isang kanin.",
      "translation_es": "De acuerdo, un arroz.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 864.883,
      "end": 867.288,
      "kind": "instruction",
      "text": "Hasta la próxima lección. Ingat ka!",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    }
