    {
      "start": 4.247,
      "end": 10.203,
      "kind": "instruction",
      "text": "En una karinderya en Tondo, un voluntario español pregunta por el menú del día. Escucha la conversación.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 11.003,
      "end": 12.763,
      "kind": "dialogue",
      "text": "Magandang tanghali po.",
      "translation_es": "Buen mediodía.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 13.563,
      "end": 15.347,
      "kind": "dialogue",
      "text": "Ano po ang ulam ngayon?",
      "translation_es": "¿Cuál es el plato del día?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 16.147,
      "end": 18.627,
      "kind": "dialogue",
      "text": "May sisig, pancit, at adobo po.",
