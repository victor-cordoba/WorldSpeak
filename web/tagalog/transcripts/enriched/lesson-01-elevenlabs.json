      "note_es": "",
      "language": "tl"
    },
    {
      "start": 401.62,
      "end": 404.26,
      "kind": "prompt",
      "text": "Otra vez. «¡Cuídate! (adiós)».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 408.26,
      "end": 408.9,
