    },
    {
      "start": 798.876,
      "end": 800.103,
      "kind": "phrase",
      "text": "kami / tayo",
      "translation_es": "nosotros (sin ti) / nosotros (contigo)",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 802.603,
      "end": 805.451,
      "kind": "prompt",
      "text": "Otra vez. «vosotros, usted / ellos».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 809.451,
      "end": 811.645,
      "kind": "phrase",
      "text": "kayo / sila",
      "translation_es": "vosotros, usted / ellos",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 814.145,
      "end": 815.503,
      "kind": "prompt",
      "text": "Y ahora, «¡Vamos».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 819.503,
      "end": 820.444,
      "kind": "phrase",
      "text": "Tara!",
      "translation_es": "¡Vamos!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 822.944,
      "end": 824.642,
      "kind": "prompt",
      "text": "¿Cómo se dice «Un momento»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 828.642,
      "end": 829.765,
      "kind": "phrase",
      "text": "Sandali lang.",
      "translation_es": "Un momento.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 832.265,
      "end": 834.041,
      "kind": "prompt",
      "text": "Di: «Perdón, disculpa».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 838.041,
      "end": 839.321,
      "kind": "phrase",
      "text": "Pasensya na po.",
      "translation_es": "Perdón, disculpa.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 841.821,
      "end": 844.616,
      "kind": "prompt",
      "text": "Otra vez. «¿Cómo se dice 'agua' en Tagalog?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 848.616,
      "end": 850.863,
      "kind": "phrase",
      "text": "Ano sa Tagalog ang 'agua'?",
      "translation_es": "¿Cómo se dice 'agua' en Tagalog?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 854.363,
      "end": 855.878,
      "kind": "prompt",
      "text": "Y ahora, «De nada».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 859.878,
      "end": 861.106,
      "kind": "phrase",
      "text": "Walang anuman.",
      "translation_es": "De nada.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 863.606,
      "end": 867.576,
      "kind": "instruction",
      "text": "Escucha la conversación completa una vez más. Ahora la entiendes entera.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 868.176,
      "end": 870.71,
      "kind": "dialogue",
      "text": "Magandang hapon po! Kumusta kayo?",
      "translation_es": "¡Buenas tardes! ¿Cómo están?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 871.51,
      "end": 875.664,
      "kind": "dialogue",
      "text": "Mabuti naman. Ako si Marites. Ikaw?",
      "translation_es": "Bien. Yo soy Marites. ¿Y tú?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 876.464,
      "end": 879.128,
      "kind": "dialogue",
      "text": "Ako si Víctor. Taga-Espanya kami.",
      "translation_es": "Soy Víctor. Somos de España.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 879.928,
      "end": 882.175,
      "kind": "dialogue",
      "text": "Marunong ka bang mag-Tagalog?",
      "translation_es": "¿Sabes hablar Tagalog?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 882.975,
      "end": 887.259,
      "kind": "dialogue",
      "text": "Konti lang. Sandali lang po… Ano sa Tagalog ang 'agua'?",
      "translation_es": "Solo un poco. Un momento… ¿cómo se dice 'agua' en Tagalog?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 888.059,
      "end": 891.037,
      "kind": "dialogue",
      "text": "Tubig! Tara, kain tayo!",
      "translation_es": "¡Tubig! ¡Venga, comamos!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 891.837,
      "end": 895.337,
      "kind": "dialogue",
      "text": "Sige! Salamat po. Pasensya na po, konti lang.",
      "translation_es": "¡Vale! Gracias. Perdón, solo sé un poco.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 896.137,
      "end": 898.514,
      "kind": "dialogue",
      "text": "Walang anuman. Ingat ka!",
      "translation_es": "De nada. ¡Cuídate!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 899.314,
      "end": 901.665,
      "kind": "instruction",
      "text": "Hasta la próxima lección. Ingat ka!",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    }
  ],
