      "kind": "phrase",
      "text": "Marunong ka bang mag-Tagalog?",
      "translation_es": "¿Sabes hablar Tagalog?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 96.075,
      "end": 97.904,
      "kind": "prompt",
      "text": "¿Cómo se dice «¿Dónde vives?»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 101.904,
      "end": 103.024,
      "kind": "phrase",
      "text": "Saan ka nakatira?",
