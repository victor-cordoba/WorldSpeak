      "note_es": "",
      "language": "en"
    },
    {
      "start": 111.535,
      "end": 112.352,
      "kind": "phrase",
      "text": "Magkano po ito?",
      "translation_es": "¿Cuánto cuesta esto?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 114.852,
      "end": 116.445,
      "kind": "prompt",
      "text": "¿Cómo se dice «Quiero agua»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 120.445,
      "end": 121.725,
      "kind": "phrase",
      "text": "Gusto ko ng tubig.",
      "translation_es": "Quiero agua.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 124.225,
      "end": 129.577,
      "kind": "explanation",
      "text": "Fíjate: tayo es nosotros contigo incluido. Si dicen tayo, te están invitando.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
