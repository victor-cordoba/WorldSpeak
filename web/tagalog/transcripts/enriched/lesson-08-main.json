    },
    {
      "start": 798.859,
      "end": 800.087,
      "kind": "phrase",
      "text": "kami / tayo",
      "translation_es": "nosotros (sin ti) / nosotros (contigo)",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 802.587,
      "end": 805.434,
      "kind": "prompt",
      "text": "Otra vez. «vosotros, usted / ellos».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 809.434,
      "end": 811.628,
      "kind": "phrase",
      "text": "kayo / sila",
      "translation_es": "vosotros, usted / ellos",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 814.128,
      "end": 815.486,
      "kind": "prompt",
      "text": "Y ahora, «¡Vamos».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 819.486,
      "end": 820.427,
      "kind": "phrase",
      "text": "Tara!",
      "translation_es": "¡Vamos!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 822.927,
      "end": 824.625,
      "kind": "prompt",
      "text": "¿Cómo se dice «Un momento»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 828.625,
      "end": 829.748,
      "kind": "phrase",
      "text": "Sandali lang.",
      "translation_es": "Un momento.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 832.248,
      "end": 834.024,
      "kind": "prompt",
      "text": "Di: «Perdón, disculpa».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 838.024,
      "end": 839.304,
      "kind": "phrase",
      "text": "Pasensya na po.",
      "translation_es": "Perdón, disculpa.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 841.804,
      "end": 844.599,
      "kind": "prompt",
      "text": "Otra vez. «¿Cómo se dice 'agua' en Tagalog?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 848.599,
      "end": 850.845,
      "kind": "phrase",
      "text": "Ano sa Tagalog ang 'agua'?",
      "translation_es": "¿Cómo se dice 'agua' en Tagalog?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 854.345,
      "end": 855.86,
      "kind": "prompt",
      "text": "Y ahora, «De nada».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 859.86,
      "end": 861.088,
      "kind": "phrase",
      "text": "Walang anuman.",
      "translation_es": "De nada.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 863.588,
      "end": 867.559,
      "kind": "instruction",
      "text": "Escucha la conversación completa una vez más. Ahora la entiendes entera.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 868.159,
      "end": 870.692,
      "kind": "dialogue",
      "text": "Magandang hapon po! Kumusta kayo?",
      "translation_es": "¡Buenas tardes! ¿Cómo están?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 871.492,
      "end": 875.646,
      "kind": "dialogue",
      "text": "Mabuti naman. Ako si Marites. Ikaw?",
      "translation_es": "Bien. Yo soy Marites. ¿Y tú?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 876.446,
      "end": 879.11,
      "kind": "dialogue",
      "text": "Ako si Víctor. Taga-Espanya kami.",
      "translation_es": "Soy Víctor. Somos de España.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 879.91,
      "end": 882.157,
      "kind": "dialogue",
      "text": "Marunong ka bang mag-Tagalog?",
      "translation_es": "¿Sabes hablar Tagalog?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 882.957,
      "end": 887.241,
      "kind": "dialogue",
      "text": "Konti lang. Sandali lang po… Ano sa Tagalog ang 'agua'?",
      "translation_es": "Solo un poco. Un momento… ¿cómo se dice 'agua' en Tagalog?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 888.041,
      "end": 891.019,
      "kind": "dialogue",
      "text": "Tubig! Tara, kain tayo!",
      "translation_es": "¡Tubig! ¡Venga, comamos!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 891.819,
      "end": 895.319,
      "kind": "dialogue",
      "text": "Sige! Salamat po. Pasensya na po, konti lang.",
      "translation_es": "¡Vale! Gracias. Perdón, solo sé un poco.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 896.119,
      "end": 898.496,
      "kind": "dialogue",
      "text": "Walang anuman. Ingat ka!",
      "translation_es": "De nada. ¡Cuídate!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 899.296,
      "end": 901.647,
      "kind": "instruction",
      "text": "Hasta la próxima lección. Ingat ka!",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    }
  ],
