      "end": 801.256,
      "kind": "prompt",
      "text": "Di: «¿Sabes hablar Tagalog?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 805.256,
      "end": 807.003,
      "kind": "phrase",
      "text": "Marunong ka bang mag-Tagalog?",
      "translation_es": "¿Sabes hablar Tagalog?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 810.503,
      "end": 812.332,
      "kind": "prompt",
      "text": "¿Cómo se dice «¿Dónde vives?»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 816.332,
      "end": 817.452,
      "kind": "phrase",
      "text": "Saan ka nakatira?",
      "translation_es": "¿Dónde vives?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 819.952,
      "end": 821.963,
      "kind": "prompt",
      "text": "Di: «¿Cuánto cuesta esto?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 825.963,
      "end": 826.779,
      "kind": "phrase",
      "text": "Magkano po ito?",
      "translation_es": "¿Cuánto cuesta esto?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 829.279,
      "end": 830.873,
      "kind": "prompt",
      "text": "¿Cómo se dice «Quiero agua»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 834.873,
      "end": 836.153,
      "kind": "phrase",
      "text": "Gusto ko ng tubig.",
      "translation_es": "Quiero agua.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 838.653,
      "end": 839.881,
      "kind": "prompt",
      "text": "Di: «¿Por qué?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 843.881,
      "end": 844.518,
      "kind": "phrase",
      "text": "Bakit?",
      "translation_es": "¿Por qué?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 847.018,
      "end": 849.082,
      "kind": "prompt",
      "text": "¿Cómo se dice «Quiero ir a Divisoria»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 853.082,
      "end": 854.842,
      "kind": "phrase",
      "text": "Gusto kong pumunta sa Divisoria.",
      "translation_es": "Quiero ir a Divisoria.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 858.342,
      "end": 860.223,
      "kind": "prompt",
      "text": "Di: «¿Quién es él/ella?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 864.223,
      "end": 864.863,
      "kind": "phrase",
      "text": "Sino siya?",
      "translation_es": "¿Quién es él/ella?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 867.363,
      "end": 869.609,
      "kind": "instruction",
      "text": "Repaso final. Todo lo de hoy.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 870.109,
      "end": 873.845,
      "kind": "prompt",
      "text": "Di: «nosotros (sin ti) / nosotros (contigo)».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 877.845,
      "end": 879.445,
      "kind": "phrase",
      "text": "kami / tayo",
      "translation_es": "nosotros (sin ti) / nosotros (contigo)",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 881.945,
      "end": 885.315,
      "kind": "prompt",
      "text": "Otra vez. «vosotros, usted / ellos».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 889.315,
      "end": 891.235,
      "kind": "phrase",
      "text": "kayo / sila",
      "translation_es": "vosotros, usted / ellos",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 893.735,
      "end": 895.145,
      "kind": "prompt",
      "text": "Y ahora, «¡Vamos».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 899.145,
      "end": 899.995,
      "kind": "phrase",
      "text": "Tara!",
      "translation_es": "¡Vamos!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 902.495,
      "end": 904.193,
      "kind": "prompt",
      "text": "¿Cómo se dice «Un momento»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 908.193,
      "end": 909.056,
      "kind": "phrase",
      "text": "Sandali lang.",
      "translation_es": "Un momento.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 911.556,
      "end": 913.489,
      "kind": "prompt",
      "text": "Di: «Perdón, disculpa».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 917.489,
      "end": 918.337,
      "kind": "phrase",
      "text": "Pasensya na po.",
      "translation_es": "Perdón, disculpa.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 920.837,
      "end": 923.449,
      "kind": "prompt",
      "text": "Otra vez. «¿Cómo se dice 'agua' en Tagalog?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 927.449,
      "end": 929.369,
      "kind": "phrase",
      "text": "Ano sa Tagalog ang 'agua'?",
      "translation_es": "¿Cómo se dice 'agua' en Tagalog?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 932.869,
      "end": 934.462,
      "kind": "prompt",
      "text": "Y ahora, «De nada».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 938.462,
      "end": 939.342,
      "kind": "phrase",
      "text": "Walang anuman.",
      "translation_es": "De nada.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 941.842,
      "end": 946.179,
      "kind": "instruction",
      "text": "Escucha la conversación completa una vez más. Ahora la entiendes entera.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 946.779,
      "end": 949.094,
      "kind": "dialogue",
      "text": "Magandang hapon po! Kumusta kayo?",
      "translation_es": "¡Buenas tardes! ¿Cómo están?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 949.894,
      "end": 953.734,
      "kind": "dialogue",
      "text": "Mabuti naman. Ako si Marites. Ikaw?",
      "translation_es": "Bien. Yo soy Marites. ¿Y tú?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 954.534,
      "end": 957.09,
      "kind": "dialogue",
      "text": "Ako si Javier. Taga-Espanya kami.",
      "translation_es": "Soy Javier. Somos de España.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 957.89,
      "end": 960.05,
      "kind": "dialogue",
      "text": "Marunong ka bang mag-Tagalog?",
      "translation_es": "¿Sabes hablar Tagalog?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 960.85,
      "end": 966.051,
      "kind": "dialogue",
      "text": "Konti lang. Sandali lang po… Ano sa Tagalog ang 'agua'?",
      "translation_es": "Solo un poco. Un momento… ¿cómo se dice 'agua' en Tagalog?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 966.851,
      "end": 969.75,
      "kind": "dialogue",
      "text": "Tubig! Tara, kain tayo!",
      "translation_es": "¡Tubig! ¡Venga, comamos!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 970.55,
      "end": 973.83,
      "kind": "dialogue",
      "text": "Sige! Salamat po. Pasensya na po, konti lang.",
      "translation_es": "¡Vale! Gracias. Perdón, solo sé un poco.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 974.63,
      "end": 976.95,
      "kind": "dialogue",
      "text": "Walang anuman. Ingat ka!",
      "translation_es": "De nada. ¡Cuídate!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 977.75,
      "end": 980.284,
      "kind": "instruction",
      "text": "Hasta la próxima lección. Ingat ka!",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    }
  ],
