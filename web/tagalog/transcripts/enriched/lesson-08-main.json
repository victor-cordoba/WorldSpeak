{
  "id": "lesson-08-main",
  "title": "Lección 08",
  "summary_es": "Cierras el Nivel 1 con kami, tayo, kayo, sila, con sige, tara, sandali lang y pasensya, y con la herramienta para seguir aprendiendo: ano sa Tagalog ang.",
  "topics": [
    "Kami y tayo",
    "Sige y Tara",
    "Un momento",
    "Cómo se dice",
    "Conversación completa"
  ],
  "dialogue": {
    "tl": [
      "Magandang hapon po! Kumusta kayo?",
      "Mabuti naman. Ako si Marites. Ikaw?",
      "Ako si Javier. Taga-Espanya kami.",
      "Marunong ka bang mag-Tagalog?",
      "Konti lang. Sandali lang po… Ano sa Tagalog ang 'agua'?",
      "Tubig! Tara, kain tayo!",
      "Sige! Salamat po. Pasensya na po, konti lang.",
      "Walang anuman. Ingat ka!"
    ],
    "es": [
      "¡Buenas tardes! ¿Cómo están?",
      "Bien. Yo soy Marites. ¿Y tú?",
      "Soy Javier. Somos de España.",
      "¿Sabes hablar Tagalog?",
      "Solo un poco. Un momento… ¿cómo se dice 'agua' en Tagalog?",
      "¡Tubig! ¡Venga, comamos!",
      "¡Vale! Gracias. Perdón, solo sé un poco.",
      "De nada. ¡Cuídate!"
    ]
  },
  "segments": [
    {
      "start": 0.8,
      "end": 4.483,
      "kind": "instruction",
      "text": "Lección 8. Repaso: tu primera conversación.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 5.083,
      "end": 11.823,
      "kind": "instruction",
      "text": "Tu primera conversación completa. En la parroquia, con una familia que acabas de conocer. Escucha la conversación.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 12.623,
      "end": 14.938,
      "kind": "dialogue",
      "text": "Magandang hapon po! Kumusta kayo?",
      "translation_es": "¡Buenas tardes! ¿Cómo están?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 15.738,
      "end": 19.579,
      "kind": "dialogue",
      "text": "Mabuti naman. Ako si Marites. Ikaw?",
      "translation_es": "Bien. Yo soy Marites. ¿Y tú?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 20.379,
      "end": 22.935,
      "kind": "dialogue",
      "text": "Ako si Javier. Taga-Espanya kami.",
      "translation_es": "Soy Javier. Somos de España.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 23.735,
      "end": 25.895,
      "kind": "dialogue",
      "text": "Marunong ka bang mag-Tagalog?",
      "translation_es": "¿Sabes hablar Tagalog?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 26.695,
      "end": 31.895,
      "kind": "dialogue",
      "text": "Konti lang. Sandali lang po… Ano sa Tagalog ang 'agua'?",
      "translation_es": "Solo un poco. Un momento… ¿cómo se dice 'agua' en Tagalog?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 32.695,
      "end": 35.594,
      "kind": "dialogue",
      "text": "Tubig! Tara, kain tayo!",
      "translation_es": "¡Tubig! ¡Venga, comamos!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 36.394,
      "end": 39.674,
      "kind": "dialogue",
      "text": "Sige! Salamat po. Pasensya na po, konti lang.",
      "translation_es": "¡Vale! Gracias. Perdón, solo sé un poco.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 40.474,
      "end": 42.794,
      "kind": "dialogue",
      "text": "Walang anuman. Ingat ka!",
      "translation_es": "De nada. ¡Cuídate!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 43.594,
      "end": 52.943,
      "kind": "explanation",
      "text": "Nosotros, vosotros, ellos, las muletillas de la calle, y la conversación entera de principio a fin. Al terminar, esta conversación la vas a hacer tú.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 53.743,
      "end": 55.676,
      "kind": "instruction",
      "text": "Antes de empezar, repasemos.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 56.176,
      "end": 58.109,
      "kind": "prompt",
