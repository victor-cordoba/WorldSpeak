    {
      "start": 530.252,
      "end": 550.252,
      "kind": "explanation",
      "text": "Coge una frase normal y mete ba después de la primera palabra o del pronombre. Marunong ka ba. Gutom ka ba. Taga-Maynila ka ba. Se responde con oo o hindi. Cuando ba va detrás de ka y sigue otra palabra, se pega: kang, bang.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 550.852,
      "end": 552.599,
      "kind": "phrase",
      "text": "Marunong ka bang mag-Tagalog?",
      "translation_es": "¿Sabes hablar Tagalog?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 556.099,
      "end": 557.139,
      "kind": "phrase",
      "text": "Naiintindihan mo ba?",
