{
  "id": "lesson-02-main",
  "title": "Lección 02",
  "summary_es": "Aprendes la pregunta de sí o no con ba, a preguntar si alguien habla Tagalog o inglés, a decir konti lang y a entender oo, hindi, hindi ko alam.",
  "topics": [
    "Preguntas con ba",
    "Marunong",
    "Konti lang",
    "Sí y no",
    "No lo sé"
  ],
  "dialogue": {
    "tl": [
      "Kumusta po? Marunong ka bang mag-Tagalog?",
      "Konti lang. Marunong ka bang mag-Ingles?",
      "Hindi po. Hindi ako marunong.",
      "Sige. Ulitin mo po? Naiintindihan mo ba?",
      "Opo! Konti lang."
    ],
    "es": [
      "¿Qué tal? ¿Sabes hablar Tagalog?",
      "Solo un poco. ¿Sabes hablar inglés?",
      "No. No sé.",
      "Vale. ¿Repites, por favor? ¿Me entiendes?",
      "¡Sí! Un poco."
    ]
  },
