      "language": "tl"
    },
    {
      "start": 761.109,
      "end": 763.029,
      "kind": "dialogue",
      "text": "Drayber ako. Ikaw?",
      "translation_es": "Soy conductor. ¿Y tú?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 763.829,
      "end": 766.229,
      "kind": "dialogue",
      "text": "Nagtitinda ako sa palengke.",
      "translation_es": "Soy vendedora en el mercado.",
