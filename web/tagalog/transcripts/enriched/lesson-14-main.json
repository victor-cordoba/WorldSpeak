    },
    {
      "start": 509.78,
      "end": 514.18,
      "kind": "instruction",
      "text": "Conversación guiada. Yo te digo la situación, tú hablas, y luego lo oyes.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 514.78,
      "end": 518.86,
      "kind": "prompt",
      "text": "Te presentan a alguien nuevo en una fiesta. ¿Cómo te presentas?",
