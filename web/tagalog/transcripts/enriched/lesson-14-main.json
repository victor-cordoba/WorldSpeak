      "note_es": "",
      "language": "tl"
    },
    {
      "start": 474.14,
      "end": 483.42,
      "kind": "instruction",
      "text": "Ahora, a entender. Vas a oír respuestas típicas, con otra voz. Escucha, y piensa qué significan. Luego te lo digo.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 484.02,
      "end": 485.94,
      "kind": "phrase",
      "text": "Oo, kita tayo bukas.",
      "translation_es": "Sí, nos vemos mañana.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 487.94,
      "end": 490.58,
      "kind": "explanation",
      "text": "«Sí, nos vemos mañana».",
      "translation_es": "",
