    },
    {
      "start": 384.206,
      "end": 392.539,
      "kind": "explanation",
      "text": "En Tagalog, es común que el predicado preceda al sujeto. Esto significa que las acciones o descripciones se mencionan antes de quién las realiza o a quién se refieren.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
