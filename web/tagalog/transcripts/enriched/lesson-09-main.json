      "note_es": "",
      "language": "en"
    },
    {
      "start": 863.86,
      "end": 866.5,
      "kind": "phrase",
      "text": "Nandito / Nandoon.",
      "translation_es": "Aquí / Allí.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 869.0,
      "end": 870.24,
      "kind": "prompt",
      "text": "Di: «No está aquí».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 874.24,
      "end": 875.36,
      "kind": "phrase",
      "text": "Wala siya dito.",
      "translation_es": "No está aquí.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 877.86,
      "end": 879.939,
      "kind": "prompt",
      "text": "Otra vez. «¿Dónde está el baño?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 883.939,
      "end": 885.459,
      "kind": "phrase",
      "text": "Nasaan ang banyo?",
      "translation_es": "¿Dónde está el baño?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 887.959,
      "end": 889.345,
      "kind": "prompt",
      "text": "Y ahora, «Ahí».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 893.345,
      "end": 894.305,
      "kind": "phrase",
      "text": "Nandiyan.",
      "translation_es": "Ahí.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 896.805,
      "end": 898.661,
      "kind": "prompt",
      "text": "¿Cómo se dice «¿Dónde está el mercado?»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 902.661,
      "end": 904.021,
      "kind": "phrase",
      "text": "Saan ang palengke?",
      "translation_es": "¿Dónde está el mercado?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 906.521,
      "end": 910.571,
      "kind": "instruction",
      "text": "Escucha la conversación completa una vez más. Ahora la entiendes entera.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 911.171,
      "end": 913.731,
      "kind": "dialogue",
      "text": "Kumusta po? Saan ka nakatira?",
      "translation_es": "¿Hola, dónde vives?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 914.531,
      "end": 918.611,
      "kind": "dialogue",
      "text": "Nakatira ako sa Tondo. Ikaw, saan ang bahay mo?",
      "translation_es": "Vivo en Tondo. ¿Y tú, dónde está tu casa?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 919.411,
      "end": 922.211,
      "kind": "dialogue",
      "text": "Malapit lang po. Nasaan ka ngayon?",
      "translation_es": "Aquí cerca. ¿Dónde estás ahora?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 923.011,
      "end": 924.451,
      "kind": "dialogue",
      "text": "Nasa bahay ako.",
      "translation_es": "Estoy en casa.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 925.251,
      "end": 927.651,
      "kind": "dialogue",
      "text": "Ah, nandiyan po pala kayo.",
      "translation_es": "Ah, así que está ahí.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 928.451,
      "end": 930.857,
      "kind": "instruction",
      "text": "Hasta la próxima lección. Ingat ka!",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    }
  ],
