      "language": "en"
    },
    {
      "start": 777.21,
      "end": 779.326,
      "kind": "phrase",
      "text": "Nandito / Nandoon.",
      "translation_es": "Aquí / Allí.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 781.826,
      "end": 783.472,
      "kind": "prompt",
      "text": "Di: «No está aquí».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 787.472,
      "end": 789.013,
      "kind": "phrase",
      "text": "Wala siya dito.",
      "translation_es": "No está aquí.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 791.513,
      "end": 793.524,
      "kind": "prompt",
      "text": "Otra vez. «¿Dónde está el baño?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 797.524,
      "end": 798.882,
      "kind": "phrase",
      "text": "Nasaan ang banyo?",
      "translation_es": "¿Dónde está el baño?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 801.382,
      "end": 802.61,
      "kind": "prompt",
      "text": "Y ahora, «Ahí».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 806.61,
      "end": 807.472,
      "kind": "phrase",
      "text": "Nandiyan.",
      "translation_es": "Ahí.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 809.972,
      "end": 811.983,
      "kind": "prompt",
      "text": "¿Cómo se dice «¿Dónde está el mercado?»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 815.983,
      "end": 817.394,
      "kind": "phrase",
      "text": "Saan ang palengke?",
      "translation_es": "¿Dónde está el mercado?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 819.894,
      "end": 823.864,
      "kind": "instruction",
      "text": "Escucha la conversación completa una vez más. Ahora la entiendes entera.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 824.464,
      "end": 826.658,
      "kind": "dialogue",
      "text": "Kumusta po? Saan ka nakatira?",
      "translation_es": "¿Hola, dónde vives?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 827.458,
      "end": 831.559,
      "kind": "dialogue",
      "text": "Nakatira ako sa Tondo. Ikaw, saan ang bahay mo?",
      "translation_es": "Vivo en Tondo. ¿Y tú, dónde está tu casa?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 832.359,
      "end": 834.501,
      "kind": "dialogue",
      "text": "Malapit lang po. Nasaan ka ngayon?",
      "translation_es": "Aquí cerca. ¿Dónde estás ahora?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 835.301,
      "end": 836.66,
      "kind": "dialogue",
      "text": "Nasa bahay ako.",
      "translation_es": "Estoy en casa.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 837.46,
      "end": 839.236,
      "kind": "dialogue",
      "text": "Ah, nandiyan po pala kayo.",
      "translation_es": "Ah, así que está ahí.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 840.036,
      "end": 842.387,
      "kind": "instruction",
      "text": "Hasta la próxima lección. Ingat ka!",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    }
  ],
