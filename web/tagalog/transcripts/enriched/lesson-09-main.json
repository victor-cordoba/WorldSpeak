      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 777.227,
      "end": 779.343,
      "kind": "phrase",
      "text": "Nandito / Nandoon.",
      "translation_es": "Aquí / Allí.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 781.843,
      "end": 783.489,
      "kind": "prompt",
      "text": "Di: «No está aquí».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 787.489,
      "end": 789.03,
      "kind": "phrase",
      "text": "Wala siya dito.",
      "translation_es": "No está aquí.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 791.53,
      "end": 793.542,
      "kind": "prompt",
      "text": "Otra vez. «¿Dónde está el baño?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 797.542,
      "end": 798.9,
      "kind": "phrase",
      "text": "Nasaan ang banyo?",
      "translation_es": "¿Dónde está el baño?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 801.4,
      "end": 802.628,
      "kind": "prompt",
      "text": "Y ahora, «Ahí».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 806.628,
      "end": 807.49,
      "kind": "phrase",
      "text": "Nandiyan.",
      "translation_es": "Ahí.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 809.99,
      "end": 812.001,
      "kind": "prompt",
      "text": "¿Cómo se dice «¿Dónde está el mercado?»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 816.001,
      "end": 817.412,
      "kind": "phrase",
      "text": "Saan ang palengke?",
      "translation_es": "¿Dónde está el mercado?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 819.912,
      "end": 823.882,
      "kind": "instruction",
      "text": "Escucha la conversación completa una vez más. Ahora la entiendes entera.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 824.482,
      "end": 826.677,
      "kind": "dialogue",
      "text": "Kumusta po? Saan ka nakatira?",
      "translation_es": "¿Hola, dónde vives?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 827.477,
      "end": 831.578,
      "kind": "dialogue",
      "text": "Nakatira ako sa Tondo. Ikaw, saan ang bahay mo?",
      "translation_es": "Vivo en Tondo. ¿Y tú, dónde está tu casa?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 832.378,
      "end": 834.52,
      "kind": "dialogue",
      "text": "Malapit lang po. Nasaan ka ngayon?",
      "translation_es": "Aquí cerca. ¿Dónde estás ahora?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 835.32,
      "end": 836.678,
      "kind": "dialogue",
      "text": "Nasa bahay ako.",
      "translation_es": "Estoy en casa.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 837.478,
      "end": 839.255,
      "kind": "dialogue",
      "text": "Ah, nandiyan po pala kayo.",
      "translation_es": "Ah, así que está ahí.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 840.055,
      "end": 842.406,
      "kind": "instruction",
      "text": "Hasta la próxima lección. Ingat ka!",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    }
  ],
