      "note_es": "",
      "language": "en"
    },
    {
      "start": 810.076,
      "end": 811.356,
      "kind": "phrase",
      "text": "Gusto ko ng tubig.",
      "translation_es": "Quiero agua.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 813.856,
      "end": 815.449,
      "kind": "prompt",
      "text": "Otra vez. «¿Quieres?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 819.449,
      "end": 820.169,
      "kind": "phrase",
      "text": "Gusto mo ba?",
      "translation_es": "¿Quieres?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 822.669,
      "end": 824.785,
      "kind": "prompt",
      "text": "Y ahora, «Quiero ir a Divisoria».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 828.785,
      "end": 830.545,
      "kind": "phrase",
      "text": "Gusto kong pumunta sa Divisoria.",
      "translation_es": "Quiero ir a Divisoria.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 834.045,
      "end": 836.344,
      "kind": "prompt",
      "text": "¿Cómo se dice «¿Cómo se va a Tondo?»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 840.344,
      "end": 841.864,
      "kind": "phrase",
      "text": "Paano pumunta sa Tondo?",
      "translation_es": "¿Cómo se va a Tondo?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 845.364,
      "end": 847.062,
      "kind": "prompt",
      "text": "Di: «¿Está lejos?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 851.062,
      "end": 851.702,
      "kind": "phrase",
      "text": "Malayo ba?",
      "translation_es": "¿Está lejos?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 854.202,
      "end": 857.467,
      "kind": "prompt",
      "text": "Otra vez. «Gira a la derecha. / Gira a la izquierda».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 861.467,
      "end": 864.667,
      "kind": "phrase",
      "text": "Kumanan ka. / Kumaliwa ka.",
      "translation_es": "Gira a la derecha. / Gira a la izquierda.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 868.167,
      "end": 870.597,
      "kind": "prompt",
      "text": "Y ahora, «¡Pare aquí! (en el jeepney)».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 874.597,
      "end": 875.449,
      "kind": "phrase",
      "text": "Para po!",
      "translation_es": "¡Pare aquí! (en el jeepney)",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 877.949,
      "end": 882.285,
      "kind": "instruction",
      "text": "Escucha la conversación completa una vez más. Ahora la entiendes entera.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 882.885,
      "end": 885.845,
      "kind": "dialogue",
      "text": "Paano pumunta sa Divisoria? Malayo ba?",
      "translation_es": "¿Cómo se va a Divisoria? ¿Está lejos?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 886.645,
      "end": 890.464,
      "kind": "dialogue",
      "text": "Hindi. Dumiretso ka lang. Kumanan ka.",
      "translation_es": "No. Sigue recto. Gira a la derecha.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 891.264,
      "end": 893.905,
      "kind": "dialogue",
      "text": "Gusto ko ng tubig. Gusto mo ba?",
      "translation_es": "Quiero agua. ¿Quieres?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 894.705,
      "end": 897.684,
      "kind": "dialogue",
      "text": "Ayaw ko. Gusto kong pumunta sa palengke.",
      "translation_es": "No quiero. Quiero ir al mercado.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 898.484,
      "end": 900.324,
      "kind": "dialogue",
      "text": "Sige. Para po!",
      "translation_es": "Vale. ¡Pare aquí!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 901.124,
      "end": 903.658,
      "kind": "instruction",
      "text": "Hasta la próxima lección. Ingat ka!",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    }
  ],
