      "note_es": "",
      "language": "en"
    },
    {
      "start": 762.205,
      "end": 763.485,
      "kind": "phrase",
      "text": "Gusto ko ng tubig.",
      "translation_es": "Quiero agua.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 765.985,
      "end": 767.344,
      "kind": "prompt",
      "text": "Otra vez. «¿Quieres?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 771.344,
      "end": 772.064,
      "kind": "phrase",
      "text": "Gusto mo ba?",
      "translation_es": "¿Quieres?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 774.564,
      "end": 776.278,
      "kind": "prompt",
      "text": "Y ahora, «Quiero ir a Divisoria».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 780.278,
      "end": 782.038,
      "kind": "phrase",
      "text": "Gusto kong pumunta sa Divisoria.",
      "translation_es": "Quiero ir a Divisoria.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 785.538,
      "end": 787.078,
      "kind": "prompt",
      "text": "¿Cómo se dice «¿Cómo se va a Tondo?»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 791.078,
      "end": 792.598,
      "kind": "phrase",
      "text": "Paano pumunta sa Tondo?",
      "translation_es": "¿Cómo se va a Tondo?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 796.098,
      "end": 797.433,
      "kind": "prompt",
      "text": "Di: «¿Está lejos?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 801.433,
      "end": 802.073,
      "kind": "phrase",
      "text": "Malayo ba?",
      "translation_es": "¿Está lejos?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 804.573,
      "end": 807.268,
      "kind": "prompt",
      "text": "Otra vez. «Gira a la derecha. / Gira a la izquierda».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 811.268,
      "end": 814.468,
      "kind": "phrase",
      "text": "Kumanan ka. / Kumaliwa ka.",
      "translation_es": "Gira a la derecha. / Gira a la izquierda.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 817.968,
      "end": 820.298,
      "kind": "prompt",
      "text": "Y ahora, «¡Pare aquí! (en el jeepney)».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 824.298,
      "end": 825.15,
      "kind": "phrase",
      "text": "Para po!",
      "translation_es": "¡Pare aquí! (en el jeepney)",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 827.65,
      "end": 830.931,
      "kind": "instruction",
      "text": "Escucha la conversación completa una vez más. Ahora la entiendes entera.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 831.531,
      "end": 834.491,
      "kind": "dialogue",
      "text": "Paano pumunta sa Divisoria? Malayo ba?",
      "translation_es": "¿Cómo se va a Divisoria? ¿Está lejos?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 835.291,
      "end": 839.11,
      "kind": "dialogue",
      "text": "Hindi. Dumiretso ka lang. Kumanan ka.",
      "translation_es": "No. Sigue recto. Gira a la derecha.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 839.91,
      "end": 842.55,
      "kind": "dialogue",
      "text": "Gusto ko ng tubig. Gusto mo ba?",
      "translation_es": "Quiero agua. ¿Quieres?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 843.35,
      "end": 846.33,
      "kind": "dialogue",
      "text": "Ayaw ko. Gusto kong pumunta sa palengke.",
      "translation_es": "No quiero. Quiero ir al mercado.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 847.13,
      "end": 848.97,
      "kind": "dialogue",
      "text": "Sige. Para po!",
      "translation_es": "Vale. ¡Pare aquí!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 849.77,
      "end": 851.783,
      "kind": "instruction",
      "text": "Hasta la próxima lección. Ingat ka!",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    }
  ],
