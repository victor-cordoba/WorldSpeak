      "text": "Di: «Quiero agua».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 901.612,
      "end": 902.892,
      "kind": "phrase",
      "text": "Gusto ko ng tubig.",
      "translation_es": "Quiero agua.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 905.392,
      "end": 906.984,
      "kind": "prompt",
      "text": "Otra vez. «¿Quieres?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 910.984,
      "end": 911.704,
      "kind": "phrase",
      "text": "Gusto mo ba?",
      "translation_es": "¿Quieres?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 914.204,
      "end": 916.32,
      "kind": "prompt",
      "text": "Y ahora, «Quiero ir a Divisoria».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 920.32,
      "end": 922.08,
      "kind": "phrase",
      "text": "Gusto kong pumunta sa Divisoria.",
      "translation_es": "Quiero ir a Divisoria.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 925.58,
      "end": 927.879,
      "kind": "prompt",
      "text": "¿Cómo se dice «¿Cómo se va a Tondo?»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 931.879,
      "end": 933.399,
      "kind": "phrase",
      "text": "Paano pumunta sa Tondo?",
      "translation_es": "¿Cómo se va a Tondo?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 936.899,
      "end": 938.597,
      "kind": "prompt",
      "text": "Di: «¿Está lejos?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 942.597,
      "end": 943.237,
      "kind": "phrase",
      "text": "Malayo ba?",
      "translation_es": "¿Está lejos?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 945.737,
      "end": 949.003,
      "kind": "prompt",
      "text": "Otra vez. «Gira a la derecha. / Gira a la izquierda».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 953.003,
      "end": 956.203,
      "kind": "phrase",
      "text": "Kumanan ka. / Kumaliwa ka.",
      "translation_es": "Gira a la derecha. / Gira a la izquierda.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 959.703,
      "end": 962.132,
      "kind": "prompt",
      "text": "Y ahora, «¡Pare aquí! (en el jeepney)».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 966.132,
      "end": 966.984,
      "kind": "phrase",
      "text": "Para po!",
      "translation_es": "¡Pare aquí! (en el jeepney)",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 969.484,
      "end": 973.82,
      "kind": "instruction",
      "text": "Escucha la conversación completa una vez más. Ahora la entiendes entera.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 974.42,
      "end": 977.38,
      "kind": "dialogue",
      "text": "Paano pumunta sa Divisoria? Malayo ba?",
      "translation_es": "¿Cómo se va a Divisoria? ¿Está lejos?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 978.18,
      "end": 982.0,
      "kind": "dialogue",
      "text": "Hindi. Dumiretso ka lang. Kumanan ka.",
      "translation_es": "No. Sigue recto. Gira a la derecha.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 982.8,
      "end": 985.44,
      "kind": "dialogue",
      "text": "Gusto ko ng tubig. Gusto mo ba?",
      "translation_es": "Quiero agua. ¿Quieres?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 986.24,
      "end": 989.22,
      "kind": "dialogue",
      "text": "Ayaw ko. Gusto kong pumunta sa palengke.",
      "translation_es": "No quiero. Quiero ir al mercado.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 990.02,
      "end": 991.86,
      "kind": "dialogue",
      "text": "Sige. Para po!",
      "translation_es": "Vale. ¡Pare aquí!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 992.66,
      "end": 995.194,
      "kind": "instruction",
      "text": "Hasta la próxima lección. Ingat ka!",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    }
