      "end": 810.322,
      "kind": "phrase",
      "text": "Konti lang.",
      "translation_es": "Solo un poco.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 812.822,
      "end": 814.05,
      "kind": "prompt",
      "text": "¿Cómo se dice «yo»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 818.05,
      "end": 818.588,
      "kind": "phrase",
      "text": "ako",
      "translation_es": "yo",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 821.088,
      "end": 822.211,
      "kind": "prompt",
      "text": "Di: «Sí (con respeto)».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 826.211,
      "end": 826.851,
      "kind": "phrase",
      "text": "Opo.",
      "translation_es": "Sí (con respeto).",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 829.351,
      "end": 831.598,
      "kind": "instruction",
      "text": "Repaso final. Todo lo de hoy.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 832.098,
      "end": 833.639,
      "kind": "prompt",
      "text": "Di: «Quiero agua».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 837.639,
      "end": 838.919,
      "kind": "phrase",
      "text": "Gusto ko ng tubig.",
      "translation_es": "Quiero agua.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 841.419,
      "end": 843.012,
      "kind": "prompt",
      "text": "Otra vez. «¿Quieres?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 847.012,
      "end": 847.732,
      "kind": "phrase",
      "text": "Gusto mo ba?",
      "translation_es": "¿Quieres?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 850.232,
      "end": 852.348,
      "kind": "prompt",
      "text": "Y ahora, «Quiero ir a Divisoria».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 856.348,
      "end": 858.108,
      "kind": "phrase",
      "text": "Gusto kong pumunta sa Divisoria.",
      "translation_es": "Quiero ir a Divisoria.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 861.608,
      "end": 863.907,
      "kind": "prompt",
      "text": "¿Cómo se dice «¿Cómo se va a Tondo?»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 867.907,
      "end": 869.427,
      "kind": "phrase",
      "text": "Paano pumunta sa Tondo?",
      "translation_es": "¿Cómo se va a Tondo?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 872.927,
      "end": 874.625,
      "kind": "prompt",
      "text": "Di: «¿Está lejos?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 878.625,
      "end": 879.265,
      "kind": "phrase",
      "text": "Malayo ba?",
      "translation_es": "¿Está lejos?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 881.765,
      "end": 885.03,
      "kind": "prompt",
      "text": "Otra vez. «Gira a la derecha. / Gira a la izquierda».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 889.03,
      "end": 892.23,
      "kind": "phrase",
      "text": "Kumanan ka. / Kumaliwa ka.",
      "translation_es": "Gira a la derecha. / Gira a la izquierda.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 895.73,
      "end": 898.159,
      "kind": "prompt",
      "text": "Y ahora, «¡Pare aquí! (en el jeepney)».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 902.159,
      "end": 903.011,
      "kind": "phrase",
      "text": "Para po!",
      "translation_es": "¡Pare aquí! (en el jeepney)",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 905.511,
      "end": 909.848,
      "kind": "instruction",
      "text": "Escucha la conversación completa una vez más. Ahora la entiendes entera.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 910.448,
      "end": 913.408,
      "kind": "dialogue",
      "text": "Paano pumunta sa Divisoria? Malayo ba?",
      "translation_es": "¿Cómo se va a Divisoria? ¿Está lejos?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 914.208,
      "end": 918.027,
      "kind": "dialogue",
      "text": "Hindi. Dumiretso ka lang. Kumanan ka.",
      "translation_es": "No. Sigue recto. Gira a la derecha.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 918.827,
      "end": 921.467,
      "kind": "dialogue",
      "text": "Gusto ko ng tubig. Gusto mo ba?",
      "translation_es": "Quiero agua. ¿Quieres?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 922.267,
      "end": 925.247,
      "kind": "dialogue",
      "text": "Ayaw ko. Gusto kong pumunta sa palengke.",
      "translation_es": "No quiero. Quiero ir al mercado.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 926.047,
      "end": 927.887,
      "kind": "dialogue",
      "text": "Sige. Para po!",
      "translation_es": "Vale. ¡Pare aquí!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 928.687,
      "end": 931.221,
      "kind": "instruction",
      "text": "Hasta la próxima lección. Ingat ka!",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    }
  ],
