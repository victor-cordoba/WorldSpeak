{
  "id": "lesson-05-main",
  "title": "Lección 05",
  "summary_es": "Aprendes gusto ko ng y gusto kong pumunta, a preguntar gusto mo ba, a decir ayaw ko, a pedir el camino y a entender dumiretso, kumanan, kumaliwa.",
  "topics": [
    "Gusto ko",
    "Gusto mo ba",
    "Quiero ir a",
    "Cómo se va",
    "Derecha e izquierda"
  ],
  "dialogue": {
    "tl": [
      "Paano pumunta sa Divisoria? Malayo ba?",
      "Hindi. Dumiretso ka lang. Kumanan ka.",
      "Gusto ko ng tubig. Gusto mo ba?",
      "Ayaw ko. Gusto kong pumunta sa palengke.",
      "Sige. Para po!"
    ],
    "es": [
      "¿Cómo se va a Divisoria? ¿Está lejos?",
      "No. Sigue recto. Gira a la derecha.",
      "Quiero agua. ¿Quieres?",
      "No quiero. Quiero ir al mercado.",
      "Vale. ¡Pare aquí!"
    ]
  },
