      "text": "Di: «Quiero agua».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 856.865,
      "end": 858.145,
      "kind": "phrase",
      "text": "Gusto ko ng tubig.",
      "translation_es": "Quiero agua.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 860.645,
      "end": 862.363,
      "kind": "prompt",
      "text": "Otra vez. «¿Quieres?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 866.363,
      "end": 867.083,
      "kind": "phrase",
      "text": "Gusto mo ba?",
      "translation_es": "¿Quieres?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 869.583,
      "end": 872.091,
      "kind": "prompt",
      "text": "Y ahora, «Quiero ir a Divisoria».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 876.091,
      "end": 877.851,
      "kind": "phrase",
      "text": "Gusto kong pumunta sa Divisoria.",
      "translation_es": "Quiero ir a Divisoria.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 881.351,
      "end": 883.508,
      "kind": "prompt",
      "text": "¿Cómo se dice «¿Cómo se va a Tondo?»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 887.508,
      "end": 889.028,
      "kind": "phrase",
      "text": "Paano pumunta sa Tondo?",
      "translation_es": "¿Cómo se va a Tondo?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 892.528,
      "end": 894.306,
      "kind": "prompt",
      "text": "Di: «¿Está lejos?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 898.306,
      "end": 898.946,
      "kind": "phrase",
      "text": "Malayo ba?",
      "translation_es": "¿Está lejos?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 901.446,
      "end": 905.487,
      "kind": "prompt",
      "text": "Otra vez. «Gira a la derecha. / Gira a la izquierda».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 909.487,
      "end": 912.687,
      "kind": "phrase",
      "text": "Kumanan ka. / Kumaliwa ka.",
      "translation_es": "Gira a la derecha. / Gira a la izquierda.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 916.187,
      "end": 919.066,
      "kind": "prompt",
      "text": "Y ahora, «¡Pare aquí! (en el jeepney)».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 923.066,
      "end": 923.918,
      "kind": "phrase",
      "text": "Para po!",
      "translation_es": "¡Pare aquí! (en el jeepney)",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 926.418,
      "end": 932.084,
      "kind": "instruction",
      "text": "Escucha la conversación completa una vez más. Ahora la entiendes entera.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 932.684,
      "end": 935.644,
      "kind": "dialogue",
      "text": "Paano pumunta sa Divisoria? Malayo ba?",
      "translation_es": "¿Cómo se va a Divisoria? ¿Está lejos?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 936.444,
      "end": 940.263,
      "kind": "dialogue",
      "text": "Hindi. Dumiretso ka lang. Kumanan ka.",
      "translation_es": "No. Sigue recto. Gira a la derecha.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 941.063,
      "end": 943.703,
      "kind": "dialogue",
      "text": "Gusto ko ng tubig. Gusto mo ba?",
      "translation_es": "Quiero agua. ¿Quieres?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 944.503,
      "end": 947.483,
      "kind": "dialogue",
      "text": "Ayaw ko. Gusto kong pumunta sa palengke.",
      "translation_es": "No quiero. Quiero ir al mercado.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 948.283,
      "end": 950.123,
      "kind": "dialogue",
      "text": "Sige. Para po!",
      "translation_es": "Vale. ¡Pare aquí!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 950.923,
      "end": 953.895,
      "kind": "instruction",
      "text": "Hasta la próxima lección. Ingat ka!",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    }
  ],
