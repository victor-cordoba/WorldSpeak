      "note_es": "",
      "language": "en"
    },
    {
      "start": 4.9,
      "end": 10.308,
      "kind": "instruction",
      "text": "Un chico te dice que no ha ido a casa. Le preguntas cuándo y por qué. Escucha la conversación.",
