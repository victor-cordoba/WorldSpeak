      "language": "tl"
    },
    {
      "start": 756.031,
      "end": 758.351,
      "kind": "dialogue",
      "text": "Kasi gutom ako. Mamaya na lang.",
      "translation_es": "Porque tengo hambre. Mejor más tarde.",
      "note_es": "",
      "language": "tl"
    },
