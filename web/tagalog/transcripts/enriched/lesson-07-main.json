{
  "id": "lesson-07-main",
  "title": "Lección 07",
  "summary_es": "Aprendes kailan, bakit e ilan, a responder con kasi, y las palabras de tiempo ngayon, bukas, kahapon, mamaya.",
  "topics": [
    "Kailan",
    "Bakit",
    "Ilan",
    "Kasi",
    "Hoy y mañana"
  ],
  "dialogue": {
    "tl": [
      "Kailan ka pupunta sa bahay?",
      "Bukas. Hindi ngayon.",
      "Bakit?",
      "Kasi gutom ako. Mamaya na lang.",
      "Ilan kayo sa bahay?",
      "Lima. Kahapon, apat."
    ],
    "es": [
      "¿Cuándo vas a ir a casa?",
      "Mañana. Hoy no.",
      "¿Por qué?",
      "Porque tengo hambre. Mejor más tarde.",
      "¿Cuántos sois en casa?",
      "Cinco. Ayer, cuatro."
    ]
  },
  "segments": [
    {
      "start": 0.8,
      "end": 4.3,
      "kind": "instruction",
      "text": "Lección siete. ¿Cuándo? ¿Por qué? ¿Cuántos?",
