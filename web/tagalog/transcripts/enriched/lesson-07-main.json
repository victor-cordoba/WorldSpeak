    {
      "start": 432.532,
      "end": 442.268,
      "kind": "explanation",
      "text": "Bakit es por qué. Kasi es porque, en la calle. Bakit hindi? Kasi gutom ako. Formal sería dahil, pero lo que vas a oír es kasi.",
      "translation_es": "",
      "note_es": "",
