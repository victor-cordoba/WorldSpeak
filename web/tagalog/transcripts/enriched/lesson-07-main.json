{
  "id": "lesson-07-main",
  "title": "Lección 07",
  "summary_es": "Aprendes kailan, bakit e ilan, a responder con kasi, y las palabras de tiempo ngayon, bukas, kahapon, mamaya.",
  "topics": [
    "Kailan",
    "Bakit",
    "Ilan",
    "Kasi",
    "Hoy y mañana"
  ],
  "dialogue": {
    "tl": [
      "Kailan ka pupunta sa bahay?",
      "Bukas. Hindi ngayon.",
      "Bakit?",
      "Kasi gutom ako. Mamaya na lang.",
      "Ilan kayo sa bahay?",
      "Lima. Kahapon, apat."
    ],
    "es": [
      "¿Cuándo vas a ir a casa?",
      "Mañana. Hoy no.",
      "¿Por qué?",
      "Porque tengo hambre. Mejor más tarde.",
      "¿Cuántos sois en casa?",
      "Cinco. Ayer, cuatro."
    ]
  },
  "segments": [
    {
      "start": 0.8,
      "end": 4.065,
      "kind": "instruction",
      "text": "Lección 7. ¿Cuándo? ¿Por qué? ¿Cuántos?.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 4.665,
      "end": 9.419,
      "kind": "instruction",
      "text": "Un chico te dice que no ha ido a casa. Le preguntas cuándo y por qué. Escucha la conversación.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 10.219,
      "end": 12.466,
      "kind": "dialogue",
