{
  "id": "lesson-01-main",
  "title": "Lección 01",
  "summary_es": "Aprendes a saludar (Kumusta, Magandang umaga), a decir cómo estás, a presentarte con Ako si y a preguntar el nombre con Anong pangalan mo.",
  "topics": [
    "Saludos",
    "Presentarse",
    "Preguntar el nombre",
    "Cortesía po",
    "Despedirse"
  ],
  "dialogue": {
    "tl": [
      "Magandang umaga po! Kumusta?",
      "Mabuti naman po, salamat. Ako si Javier.",
      "Ako si Ana. Anong pangalan mo?",
      "Javier. Salamat po, Ana. Ingat ka!"
    ],
    "es": [
      "¡Buenos días! ¿Qué tal?",
      "Bien, gracias. Soy Javier.",
      "Yo soy Ana. ¿Cómo te llamas?",
      "Javier. Gracias, Ana. ¡Cuídate!"
    ]
  },
  "segments": [
    {
      "start": 0.8,
      "end": 4.98,
      "kind": "instruction",
      "text": "Lección 1. Hola, ¿cómo estás? ¿Cómo te llamas?.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 5.58,
      "end": 15.239,
      "kind": "instruction",
      "text": "Estás en una calle de Tondo, a media mañana. Una mujer te saluda desde su puesto de la sari-sari. Escucha la conversación.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 16.039,
      "end": 18.658,
      "kind": "dialogue",
      "text": "Magandang umaga po! Kumusta?",
      "translation_es": "¡Buenos días! ¿Qué tal?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 19.458,
      "end": 22.338,
      "kind": "dialogue",
      "text": "Mabuti naman po, salamat. Ako si Javier.",
      "translation_es": "Bien, gracias. Soy Javier.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 23.138,
      "end": 25.778,
      "kind": "dialogue",
      "text": "Ako si Ana. Anong pangalan mo?",
      "translation_es": "Yo soy Ana. ¿Cómo te llamas?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 26.578,
      "end": 30.816,
      "kind": "dialogue",
      "text": "Javier. Salamat po, Ana. Ingat ka!",
      "translation_es": "Javier. Gracias, Ana. ¡Cuídate!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 31.616,
      "end": 40.857,
      "kind": "explanation",
      "text": "Saludar según la hora, decir tu nombre y preguntar el suyo. Al terminar, esta conversación la vas a hacer tú.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 41.657,
      "end": 64.784,
      "kind": "explanation",
      "text": "Un apunte antes de seguir. Vas a oír mucho la palabra po. Po es la palabra del respeto: se añade al final de casi cualquier frase cuando hablas con adultos o con mayores. Salamat po. Kumusta po. Con niños no hace falta. Es la manera más fácil de sonar educado en Tagalog.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 65.384,
      "end": 72.246,
      "kind": "instruction",
