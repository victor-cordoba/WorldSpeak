{
  "id": "lesson-06-main",
  "title": "Lección 06",
  "summary_es": "Aprendes magkano po ito, a entender los precios en español filipino (bente, singkwenta), los números del 1 al 10, y a pedir con isang kape nga po y pahingi po.",
  "topics": [
    "Magkano",
    "Números",
    "Caro y barato",
    "Pedir con nga po",
    "Wala"
  ],
  "dialogue": {
    "tl": [
      "Magkano po ito?",
      "Bente pesos po.",
      "Ang mahal! Isang kape nga po.",
      "Sige. Pahingi po ng tubig?",
      "Wala. Mura ang kape, dalawa!"
    ],
    "es": [
      "¿Cuánto cuesta esto?",
      "Veinte pesos.",
      "¡Qué caro! Un café, por favor.",
      "Vale. ¿Me da agua?",
      "No hay. El café es barato, ¡dos!"
    ]
  },
