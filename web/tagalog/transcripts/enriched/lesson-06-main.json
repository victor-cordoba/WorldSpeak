    "tl": [
      "Magkano po ito?",
      "Bente pesos po.",
      "Ang mahal! Isang kape nga po.",
      "Sige. Pahingi po ng tubig?",
      "Wala. Mura ang kape, dalawa!"
    ],
    "es": [
      "¿Cuánto cuesta esto?",
      "Veinte pesos.",
      "¡Qué caro! Un café, por favor.",
      "Vale. ¿Me da agua?",
      "No hay. El café es barato, ¡dos!"
    ]
  },
