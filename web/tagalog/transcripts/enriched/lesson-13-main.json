      "note_es": "",
      "language": "tl"
    },
    {
      "start": 467.44,
      "end": 471.84,
      "kind": "instruction",
      "text": "Conversación guiada. Yo te digo la situación, tú hablas, y luego lo oyes.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 472.44,
