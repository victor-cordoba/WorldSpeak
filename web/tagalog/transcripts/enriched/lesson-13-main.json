      "note_es": "",
      "language": "en"
    },
    {
      "start": 417.16,
      "end": 429.8,
      "kind": "explanation",
      "text": "En Tagalog, 'na' indica que algo ya ha ocurrido, mientras que 'pa' indica que algo no ha ocurrido aún. Se usan para expresar el estado de acciones en el tiempo.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 430.4,
      "end": 431.44,
      "kind": "phrase",
      "text": "Kumain ka na ba?",
