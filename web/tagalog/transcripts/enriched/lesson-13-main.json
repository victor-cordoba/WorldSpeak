    {
      "start": 365.271,
      "end": 366.577,
      "kind": "explanation",
      "text": "Uso de 'na' y 'pa'.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 366.977,
      "end": 376.642,
      "kind": "explanation",
      "text": "En Tagalog, 'na' indica que algo ya ha ocurrido, mientras que 'pa' indica que algo no ha ocurrido aún. Se usan para expresar el estado de acciones en el tiempo.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 377.242,
