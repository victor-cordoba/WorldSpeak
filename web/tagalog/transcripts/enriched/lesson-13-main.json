      "end": 435.94,
      "kind": "phrase",
      "text": "Hindi pa.",
      "translation_es": "Todavía no.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 438.44,
      "end": 447.72,
      "kind": "instruction",
      "text": "Ahora, a entender. Vas a oír respuestas típicas, con otra voz. Escucha, y piensa qué significan. Luego te lo digo.",
