      "translation_es": "¿Cómo está, hermana?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 742.545,
      "end": 745.07,
      "kind": "dialogue",
      "text": "Mabuti naman, iho. Ikaw?",
      "translation_es": "Bien, hijo. ¿Y tú?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 745.87,
      "end": 749.07,
      "kind": "dialogue",
      "text": "Okay lang po. Gusto ko pong bumili ng candy.",
      "translation_es": "Estoy bien. Quiero comprar un caramelo.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 749.87,
      "end": 751.272,
      "kind": "dialogue",
      "text": "May pera ka ba?",
      "translation_es": "¿Tienes dinero?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 752.072,
      "end": 755.652,
      "kind": "dialogue",
      "text": "Opo, pero kasi gusto ko ring bumili ng juice.",
      "translation_es": "Sí, pero porque también quiero comprar un zumo.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 756.452,
      "end": 759.784,
      "kind": "dialogue",
      "text": "Sige, kung gusto mo. Tapos na ba ang homework mo?",
      "translation_es": "Vale, si quieres. ¿Ya terminaste tu tarea?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 760.584,
      "end": 762.413,
      "kind": "dialogue",
      "text": "Opo, tapos na.",
      "translation_es": "Sí, ya terminé.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 763.213,
      "end": 765.421,
      "kind": "instruction",
      "text": "Hasta la próxima lección. Ingat ka!",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    }
  ],
