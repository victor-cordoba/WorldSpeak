      "language": "tl"
    },
    {
      "start": 768.171,
      "end": 770.287,
      "kind": "instruction",
      "text": "Repaso final. Todo lo de hoy.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 770.787,
      "end": 772.093,
      "kind": "prompt",
      "text": "Di: «¿Dónde duermes?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 776.093,
      "end": 777.608,
      "kind": "phrase",
      "text": "Saan ka natutulog?",
      "translation_es": "¿Dónde duermes?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 780.108,
      "end": 781.884,
      "kind": "prompt",
      "text": "Otra vez. «En la calle».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 785.884,
      "end": 786.929,
      "kind": "phrase",
      "text": "Sa kalye.",
      "translation_es": "En la calle.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 789.429,
      "end": 791.493,
      "kind": "prompt",
      "text": "Y ahora, «En la casa de mi abuela».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 795.493,
      "end": 797.269,
      "kind": "phrase",
      "text": "Sa bahay ng lola ko.",
      "translation_es": "En la casa de mi abuela.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 799.769,
      "end": 802.198,
      "kind": "prompt",
      "text": "¿Cómo se dice «¿Por qué no vuelves a casa?»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 806.198,
      "end": 807.74,
      "kind": "phrase",
      "text": "Bakit hindi ka umuuwi?",
      "translation_es": "¿Por qué no vuelves a casa?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 810.24,
      "end": 811.546,
      "kind": "prompt",
      "text": "Di: «Vuelve a casa».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 815.546,
      "end": 816.773,
      "kind": "phrase",
      "text": "Umuwi ka na.",
      "translation_es": "Vuelve a casa.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 819.273,
      "end": 821.337,
      "kind": "prompt",
      "text": "Otra vez. «Sí, vuelvo a casa».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 825.337,
      "end": 826.983,
      "kind": "phrase",
      "text": "Opo, umuuwi ako.",
      "translation_es": "Sí, vuelvo a casa.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 829.483,
      "end": 832.252,
      "kind": "prompt",
      "text": "Y ahora, «No, aún no he vuelto a casa».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 836.252,
      "end": 838.603,
      "kind": "phrase",
      "text": "Opo, hindi pa ako umuuwi.",
      "translation_es": "No, aún no he vuelto a casa.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 842.103,
      "end": 843.879,
      "kind": "prompt",
      "text": "¿Cómo se dice «La vida es difícil»?",
