      "note_es": "",
      "language": "en"
    },
    {
      "start": 847.879,
      "end": 849.394,
      "kind": "phrase",
      "text": "Mahirap ang buhay.",
      "translation_es": "La vida es difícil.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 851.894,
      "end": 855.865,
      "kind": "instruction",
      "text": "Escucha la conversación completa una vez más. Ahora la entiendes entera.",
