      "note_es": "",
      "language": "en"
    },
    {
      "start": 853.084,
      "end": 854.305,
      "kind": "prompt",
      "text": "Di: «¿Dónde duermes?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 858.305,
      "end": 859.825,
      "kind": "phrase",
      "text": "Saan ka natutulog?",
      "translation_es": "¿Dónde duermes?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 862.325,
      "end": 864.274,
      "kind": "prompt",
      "text": "Otra vez. «En la calle».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 868.274,
      "end": 869.234,
      "kind": "phrase",
      "text": "Sa kalye.",
      "translation_es": "En la calle.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 871.734,
      "end": 873.687,
      "kind": "prompt",
      "text": "Y ahora, «En la casa de mi abuela».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 877.687,
      "end": 879.287,
      "kind": "phrase",
      "text": "Sa bahay ng lola ko.",
      "translation_es": "En la casa de mi abuela.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 881.787,
      "end": 883.852,
      "kind": "prompt",
      "text": "¿Cómo se dice «¿Por qué no vuelves a casa?»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 887.852,
      "end": 889.452,
      "kind": "phrase",
      "text": "Bakit hindi ka umuuwi?",
      "translation_es": "¿Por qué no vuelves a casa?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 891.952,
      "end": 893.174,
      "kind": "prompt",
      "text": "Di: «Vuelve a casa».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 897.174,
      "end": 898.534,
      "kind": "phrase",
      "text": "Umuwi ka na.",
      "translation_es": "Vuelve a casa.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 901.034,
      "end": 903.438,
      "kind": "prompt",
      "text": "Otra vez. «Sí, vuelvo a casa».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 907.438,
      "end": 909.838,
      "kind": "phrase",
      "text": "Opo, umuuwi ako.",
      "translation_es": "Sí, vuelvo a casa.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 912.338,
      "end": 914.96,
      "kind": "prompt",
      "text": "Y ahora, «No, aún no he vuelto a casa».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 918.96,
      "end": 920.72,
      "kind": "phrase",
      "text": "Opo, hindi pa ako umuuwi.",
      "translation_es": "No, aún no he vuelto a casa.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 924.22,
      "end": 925.996,
      "kind": "prompt",
      "text": "¿Cómo se dice «La vida es difícil»?",
