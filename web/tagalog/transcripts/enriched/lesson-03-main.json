    },
    {
      "start": 826.178,
      "end": 827.903,
      "kind": "prompt",
      "text": "Otra vez. «Mi casa».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 831.903,
      "end": 833.743,
      "kind": "phrase",
      "text": "Bahay ko.",
      "translation_es": "Mi casa.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 836.243,
      "end": 837.705,
      "kind": "prompt",
      "text": "Y ahora, «¿Y tú?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 841.705,
      "end": 842.176,
      "kind": "phrase",
      "text": "Ikaw?",
      "translation_es": "¿Y tú?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 844.676,
      "end": 846.453,
      "kind": "prompt",
      "text": "¿Cómo se dice «Tengo hambre»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 850.453,
      "end": 851.493,
      "kind": "phrase",
      "text": "Gutom ako.",
      "translation_es": "Tengo hambre.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 853.993,
      "end": 858.329,
      "kind": "instruction",
      "text": "Escucha la conversación completa una vez más. Ahora la entiendes entera.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 858.929,
      "end": 861.169,
      "kind": "dialogue",
      "text": "Ako si Marites. Ikaw?",
      "translation_es": "Yo soy Marites. ¿Y tú?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 861.969,
      "end": 865.009,
      "kind": "dialogue",
      "text": "Ako si Javier. Gutom ako!",
      "translation_es": "Yo soy Javier. ¡Tengo hambre!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 865.809,
      "end": 868.689,
      "kind": "dialogue",
      "text": "Ako rin! Malapit lang ang bahay ko.",
      "translation_es": "¡Yo también! Mi casa está aquí cerca.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 869.489,
      "end": 870.129,
      "kind": "dialogue",
      "text": "Sino siya?",
      "translation_es": "¿Quién es ella?",
