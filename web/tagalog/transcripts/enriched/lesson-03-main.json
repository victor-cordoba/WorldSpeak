      "language": "tl"
    },
    {
      "start": 764.209,
      "end": 766.769,
      "kind": "dialogue",
      "text": "Ako si Víctor. Gutom ako!",
      "translation_es": "Yo soy Víctor. ¡Tengo hambre!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 767.569,
      "end": 771.253,
      "kind": "dialogue",
      "text": "Ako rin! Malapit lang ang bahay ko.",
