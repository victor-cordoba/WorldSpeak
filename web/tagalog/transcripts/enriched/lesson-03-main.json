      "end": 774.137,
      "kind": "dialogue",
      "text": "Ako si Javier. Gutom ako!",
      "translation_es": "Yo soy Javier. ¡Tengo hambre!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 774.937,
      "end": 777.817,
      "kind": "dialogue",
      "text": "Ako rin! Malapit lang ang bahay ko.",
      "translation_es": "¡Yo también! Mi casa está aquí cerca.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 778.617,
      "end": 779.257,
      "kind": "dialogue",
      "text": "Sino siya?",
      "translation_es": "¿Quién es ella?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 780.057,
      "end": 784.217,
      "kind": "dialogue",
      "text": "Kaibigan ko. Ikaw din, kaibigan ko na!",
      "translation_es": "Mi amiga. ¡Tú también, ya eres mi amigo!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 785.017,
      "end": 787.029,
      "kind": "instruction",
      "text": "Hasta la próxima lección. Ingat ka!",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    }
