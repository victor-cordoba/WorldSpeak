      "translation_es": "Tengo hambre.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 528.159,
      "end": 532.025,
      "kind": "prompt",
      "text": "Te dice que él también. Señala una casa y di: mi casa.",
