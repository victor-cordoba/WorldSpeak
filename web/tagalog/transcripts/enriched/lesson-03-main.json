      "language": "tl"
    },
    {
      "start": 824.998,
      "end": 828.038,
      "kind": "dialogue",
      "text": "Ako si Javier. Gutom ako!",
      "translation_es": "Yo soy Javier. ¡Tengo hambre!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 828.838,
      "end": 831.718,
      "kind": "dialogue",
      "text": "Ako rin! Malapit lang ang bahay ko.",
      "translation_es": "¡Yo también! Mi casa está aquí cerca.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 832.518,
      "end": 833.158,
      "kind": "dialogue",
      "text": "Sino siya?",
      "translation_es": "¿Quién es ella?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 833.958,
      "end": 838.118,
      "kind": "dialogue",
      "text": "Kaibigan ko. Ikaw din, kaibigan ko na!",
      "translation_es": "Mi amiga. ¡Tú también, ya eres mi amigo!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 838.918,
      "end": 841.452,
      "kind": "instruction",
      "text": "Hasta la próxima lección. Ingat ka!",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    }
  ],
