      "kind": "dialogue",
      "text": "Ako si Marites. Ikaw?",
      "translation_es": "Yo soy Marites. ¿Y tú?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 883.791,
      "end": 886.831,
      "kind": "dialogue",
      "text": "Ako si Javier. Gutom ako!",
      "translation_es": "Yo soy Javier. ¡Tengo hambre!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 887.631,
      "end": 890.511,
      "kind": "dialogue",
      "text": "Ako rin! Malapit lang ang bahay ko.",
      "translation_es": "¡Yo también! Mi casa está aquí cerca.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 891.311,
      "end": 891.951,
      "kind": "dialogue",
      "text": "Sino siya?",
      "translation_es": "¿Quién es ella?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 892.751,
      "end": 896.911,
      "kind": "dialogue",
      "text": "Kaibigan ko. Ikaw din, kaibigan ko na!",
      "translation_es": "Mi amiga. ¡Tú también, ya eres mi amigo!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 897.711,
      "end": 899.919,
      "kind": "instruction",
      "text": "Hasta la próxima lección. Ingat ka!",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    }
  ],
