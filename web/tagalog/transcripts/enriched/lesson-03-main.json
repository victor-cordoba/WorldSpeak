      "note_es": "",
      "language": "tl"
    },
    {
      "start": 772.053,
      "end": 773.097,
      "kind": "dialogue",
      "text": "Sino siya?",
      "translation_es": "¿Quién es ella?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 773.897,
      "end": 777.711,
      "kind": "dialogue",
      "text": "Kaibigan ko. Ikaw din, kaibigan ko na!",
      "translation_es": "Mi amiga. ¡Tú también, ya eres mi amigo!",
      "note_es": "",
      "language": "tl"
    },
