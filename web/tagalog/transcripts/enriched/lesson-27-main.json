      "translation_es": "¿Dónde está la esquina?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 790.094,
      "end": 791.47,
      "kind": "dialogue",
      "text": "Sa Divisoria po!",
      "translation_es": "¡A Divisoria, por favor!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 792.27,
      "end": 793.87,
      "kind": "dialogue",
      "text": "Magkano ang pamasahe?",
      "translation_es": "¿Cuánto es el pasaje?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 794.67,
      "end": 796.009,
      "kind": "dialogue",
      "text": "Bente pesos po.",
      "translation_es": "Veinte pesos.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 796.809,
      "end": 797.769,
      "kind": "dialogue",
      "text": "Bayad po.",
      "translation_es": "Pago, por favor.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 798.569,
      "end": 799.937,
      "kind": "dialogue",
      "text": "Para na po!",
      "translation_es": "¡Pare aquí, por favor!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 800.737,
      "end": 803.709,
