      "translation_es": "¿Dónde está la esquina?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 736.167,
      "end": 737.543,
      "kind": "dialogue",
      "text": "Sa Divisoria po!",
      "translation_es": "¡A Divisoria, por favor!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 738.343,
      "end": 739.943,
      "kind": "dialogue",
      "text": "Magkano ang pamasahe?",
      "translation_es": "¿Cuánto es el pasaje?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 740.743,
      "end": 742.081,
      "kind": "dialogue",
      "text": "Bente pesos po.",
      "translation_es": "Veinte pesos.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 742.881,
      "end": 743.841,
      "kind": "dialogue",
      "text": "Bayad po.",
      "translation_es": "Pago, por favor.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 744.641,
      "end": 746.009,
      "kind": "dialogue",
      "text": "Para na po!",
      "translation_es": "¡Pare aquí, por favor!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 746.809,
      "end": 749.017,
