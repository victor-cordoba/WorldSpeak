      "language": "tl"
    },
    {
      "start": 721.752,
      "end": 723.128,
      "kind": "dialogue",
      "text": "Sa Divisoria po!",
      "translation_es": "¡A Divisoria, por favor!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 723.928,
      "end": 725.528,
      "kind": "dialogue",
      "text": "Magkano ang pamasahe?",
      "translation_es": "¿Cuánto es el pasaje?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 726.328,
      "end": 727.666,
      "kind": "dialogue",
      "text": "Bente pesos po.",
      "translation_es": "Veinte pesos.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 728.466,
      "end": 729.426,
      "kind": "dialogue",
      "text": "Bayad po.",
      "translation_es": "Pago, por favor.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 730.226,
      "end": 731.595,
      "kind": "dialogue",
      "text": "Para na po!",
      "translation_es": "¡Pare aquí, por favor!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 732.395,
