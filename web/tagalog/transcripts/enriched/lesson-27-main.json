      "translation_es": "¿Dónde está la esquina?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 767.786,
      "end": 769.162,
      "kind": "dialogue",
      "text": "Sa Divisoria po!",
      "translation_es": "¡A Divisoria, por favor!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 769.962,
      "end": 771.562,
      "kind": "dialogue",
      "text": "Magkano ang pamasahe?",
      "translation_es": "¿Cuánto es el pasaje?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 772.362,
      "end": 773.7,
      "kind": "dialogue",
      "text": "Bente pesos po.",
      "translation_es": "Veinte pesos.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 774.5,
      "end": 775.46,
      "kind": "dialogue",
      "text": "Bayad po.",
      "translation_es": "Pago, por favor.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 776.26,
      "end": 777.629,
      "kind": "dialogue",
      "text": "Para na po!",
      "translation_es": "¡Pare aquí, por favor!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 778.429,
      "end": 780.963,
