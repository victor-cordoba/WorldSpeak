    },
    {
      "role": "native_m",
      "lang": "tl",
      "text": "Tubig. Gusto ka og tubig?",
      "kind": "dialogue",
      "pause": 0.8,
      "translation_es": "Agua. ¿Quieres agua?",
      "item": null,
      "clip": "_clips/a5040cbbbe71b61d.mp3"
    },
    {
      "role": "native_f",
      "lang": "tl",
      "text": "Oo, gusto ko og tubig. Tagpila ni?",
      "kind": "dialogue",
      "pause": 0.8,
      "translation_es": "Sí, quiero agua. ¿Cuánto cuesta esto?",
      "item": null,
