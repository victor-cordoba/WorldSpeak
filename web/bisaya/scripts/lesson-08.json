    {
      "role": "native_m",
      "lang": "tl",
      "text": "Maayong buntag! Unsa imong ngalan?",
      "kind": "dialogue",
      "pause": 0.8,
      "translation_es": "¡Buenos días! ¿Cómo te llamas?",
      "item": null,
      "clip": "_clips/3a2721a00eabaa83.mp3"
    },
    {
      "role": "native_f",
      "lang": "tl",
      "text": "Ako si Maria. Unsa sa Binisaya ang 'agua'?",
      "kind": "dialogue",
      "pause": 0.8,
      "translation_es": "Yo soy María. ¿Cómo se dice 'agua' en Bisaya?",
      "item": null,
      "clip": "_clips/6d0b304561f0587d.mp3"
    },
    {
      "role": "native_m",
      "lang": "tl",
      "text": "Tubig. Gusto ka og tubig?",
      "kind": "dialogue",
      "pause": 0.8,
      "translation_es": "Agua. ¿Quieres agua?",
      "item": null,
      "clip": "_clips/a5040cbbbe71b61d.mp3"
    },
    {
      "role": "native_f",
      "lang": "tl",
      "text": "Oo, gusto ko og tubig. Tagpila ni?",
      "kind": "dialogue",
      "pause": 0.8,
      "translation_es": "Sí, quiero agua. ¿Cuánto cuesta esto?",
      "item": null,
      "clip": "_clips/7faef9845f47d5e6.mp3"
    },
    {
      "role": "native_m",
      "lang": "tl",
      "text": "Bente pesos. Walay sapayan.",
      "kind": "dialogue",
      "pause": 0.8,
      "translation_es": "Veinte pesos. De nada.",
      "item": null,
      "clip": "_clips/77a567fedf1387b6.mp3"
    },
    {
      "role": "native_f",
      "lang": "tl",
      "text": "Salamat! Pasaylo-a ko, wala ko kasabot usahay.",
      "kind": "dialogue",
      "pause": 0.8,
      "translation_es": "¡Gracias! Perdóname, a veces no entiendo.",
      "item": null,
      "clip": "_clips/6713b2e7b634b5de.mp3"
    },
    {
      "role": "native_m",
      "lang": "tl",
      "text": "Walay sapayan. Amping!",
      "kind": "dialogue",
      "pause": 0.8,
      "translation_es": "De nada. ¡Cuídate!",
      "item": null,
