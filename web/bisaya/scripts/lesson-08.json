    "tl": [
      "Maayong buntag! Unsa imong ngalan?",
      "Ako si Maria. Unsa sa Binisaya ang 'agua'?",
      "Tubig. Gusto ka og tubig?",
      "Oo, gusto ko og tubig. Tagpila ni?",
      "Bente pesos. Walay sapayan.",
      "Salamat! Pasaylo-a ko, wala ko kasabot usahay.",
      "Walay sapayan. Amping!"
    ],
    "es": [
      "¡Buenos días! ¿Cómo te llamas?",
      "Yo soy María. ¿Cómo se dice 'agua' en Bisaya?",
      "Agua. ¿Quieres agua?",
      "Sí, quiero agua. ¿Cuánto cuesta esto?",
      "Veinte pesos. De nada.",
      "¡Gracias! Perdóname, a veces no entiendo.",
      "De nada. ¡Cuídate!"
    ]
  },
