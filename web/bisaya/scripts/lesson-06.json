      "pause": 0.8,
      "translation_es": "",
      "item": null,
      "clip": "_clips/ce06b57a91a3359f.mp3"
    },
    {
      "role": "native_f",
      "lang": "tl",
      "text": "Maayong buntag! Unsa imong gusto?",
