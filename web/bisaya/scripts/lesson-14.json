      "pause": 0.6,
      "translation_es": "",
      "item": null,
      "clip": "_clips/41b2fcfe68601441.mp3"
    },
    {
      "role": "narrator",
      "lang": "es",
      "text": "En un encuentro casual en el mercado de Carbon, dos amigos se saludan y conversan sobre sus planes. Escucha la conversación.",
      "kind": "instruction",
      "pause": 0.8,
      "translation_es": "",
      "item": null,
      "clip": "_clips/a78284cde0a35930.mp3"
    },
    {
      "role": "native_m",
      "lang": "tl",
      "text": "Kumusta ka, Bai?",
