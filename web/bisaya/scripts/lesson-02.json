      "translation_es": "¿Sabes hablar inglés?",
      "item": null,
      "clip": "_clips/891bd2ed830fbf5f.mp3"
    },
    {
      "role": "native_m",
      "lang": "tl",
      "text": "Oo, pero wala ko kasabot sa tanan.",
      "kind": "dialogue",
      "pause": 0.8,
      "translation_es": "Sí, pero no entiendo todo.",
      "item": null,
      "clip": "_clips/9be3aa8b073be65d.mp3"
    },
    {
      "role": "native_f",
      "lang": "tl",
      "text": "Usba palihug.",
