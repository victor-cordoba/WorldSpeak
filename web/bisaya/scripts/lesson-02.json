    },
    {
      "role": "native_f",
      "lang": "tl",
      "text": "Maayong buntag! Kabalo ka mag-Binisaya?",
      "kind": "dialogue",
      "pause": 0.8,
      "translation_es": "¡Buenos días! ¿Sabes hablar Bisaya?",
      "item": null,
