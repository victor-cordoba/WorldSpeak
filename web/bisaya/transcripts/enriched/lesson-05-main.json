      "note_es": "",
      "language": "en"
    },
    {
      "start": 797.809,
      "end": 798.769,
      "kind": "dialogue",
      "text": "Asa ka padulong?",
      "translation_es": "¿A dónde vas?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 799.569,
      "end": 801.809,
      "kind": "dialogue",
      "text": "Gusto kong moadto sa Carbon.",
      "translation_es": "Quiero ir al Carbon.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 802.609,
      "end": 804.107,
      "kind": "dialogue",
      "text": "Unsaon pag-adto sa Carbon?",
      "translation_es": "¿Cómo se va al Carbon?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 804.907,
      "end": 805.547,
      "kind": "dialogue",
      "text": "Diretso lang.",
      "translation_es": "Sigue recto.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 806.347,
      "end": 806.987,
      "kind": "dialogue",
      "text": "Layo ba?",
      "translation_es": "¿Está lejos?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 807.787,
      "end": 809.068,
      "kind": "dialogue",
      "text": "Dili kaayo.",
      "translation_es": "No mucho.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 809.868,
      "end": 810.557,
      "kind": "dialogue",
      "text": "Salamat!",
      "translation_es": "¡Gracias!",
      "note_es": "",
      "language": "tl"
    },
    {
