      "start": 369.259,
      "end": 370.618,
      "kind": "phrase",
      "text": "Asa ka nagtrabaho?",
      "translation_es": "¿Dónde trabajas?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 373.118,
      "end": 374.476,
      "kind": "phrase",
      "text": "Asa ka nagtrabaho?",
      "translation_es": "¿Dónde trabajas?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 375.676,
      "end": 377.688,
      "kind": "explanation",
      "text": "Pregunta sobre el lugar de trabajo.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 378.188,
      "end": 380.33,
      "kind": "prompt",
      "text": "¿Cómo se dice «¿Dónde trabajas?»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 384.33,
      "end": 385.688,
      "kind": "phrase",
      "text": "Asa ka nagtrabaho?",
      "translation_es": "¿Dónde trabajas?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 388.188,
      "end": 390.121,
      "kind": "prompt",
      "text": "Otra vez. «¿Dónde trabajas?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 394.121,
      "end": 395.48,
      "kind": "phrase",
      "text": "Asa ka nagtrabaho?",
      "translation_es": "¿Dónde trabajas?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 397.98,
      "end": 399.988,
      "kind": "instruction",
      "text": "Un momento. Volvamos atrás.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 400.388,
      "end": 401.851,
      "kind": "prompt",
      "text": "Y ahora, «¡Amigo».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 405.851,
      "end": 406.477,
      "kind": "phrase",
      "text": "Bai!",
      "translation_es": "¡Amigo!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 408.977,
      "end": 411.929,
      "kind": "instruction",
      "text": "Pregunta sorpresa, de una lección anterior.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 412.329,
      "end": 416.431,
      "kind": "prompt",
      "text": "Y ahora, «Nosotros (sin ti) y nosotros (contigo)».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 420.431,
      "end": 421.606,
      "kind": "phrase",
      "text": "Kami ug kita",
      "translation_es": "Nosotros (sin ti) y nosotros (contigo)",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 424.106,
      "end": 425.386,
      "kind": "explanation",
      "text": "Predicado primero.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 425.786,
      "end": 435.425,
      "kind": "explanation",
      "text": "En Bisaya, es común colocar el predicado antes del sujeto. Esto se observa en frases como 'Nalipay ko' (Me alegra) y 'Gwapa ka' (Eres guapa).",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 436.025,
      "end": 437.906,
      "kind": "phrase",
      "text": "Nalipay ko nga nagkaila ta.",
      "translation_es": "Me alegra que nos hayamos conocido.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 441.406,
      "end": 442.275,
      "kind": "phrase",
      "text": "Gwapa ka.",
      "translation_es": "Eres guapa.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 444.775,
      "end": 452.454,
      "kind": "instruction",
      "text": "Ahora, a entender. Vas a oír respuestas típicas, con otra voz. Escucha, y piensa qué significan. Luego te lo digo.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 453.054,
      "end": 454.175,
      "kind": "phrase",
      "text": "Amping ka!",
      "translation_es": "¡Cuídate!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 456.175,
      "end": 456.933,
      "kind": "explanation",
      "text": "«¡Cuídate».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 457.433,
      "end": 458.554,
      "kind": "phrase",
      "text": "Amping ka!",
      "translation_es": "¡Cuídate!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 459.754,
      "end": 461.582,
      "kind": "phrase",
      "text": "Naa sa Guadalupe.",
      "translation_es": "Está en Guadalupe.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 463.582,
      "end": 465.045,
      "kind": "explanation",
      "text": "«Está en Guadalupe».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 465.545,
      "end": 467.374,
      "kind": "phrase",
      "text": "Naa sa Guadalupe.",
      "translation_es": "Está en Guadalupe.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 468.574,
      "end": 473.642,
      "kind": "instruction",
      "text": "Conversación guiada. Yo te digo la situación, tú hablas, y luego lo oyes.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 474.242,
      "end": 478.108,
      "kind": "prompt",
      "text": "Te encuentras con un amigo en el mercado y quieres saber dónde trabaja.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 482.108,
      "end": 483.466,
      "kind": "phrase",
      "text": "Asa ka nagtrabaho?",
      "translation_es": "¿Dónde trabajas?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 485.966,
      "end": 488.395,
      "kind": "instruction",
      "text": "Repaso final. Todo lo de hoy.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 488.895,
      "end": 491.325,
      "kind": "prompt",
      "text": "Di: «Me alegra que nos hayamos conocido».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 495.325,
      "end": 497.206,
      "kind": "phrase",
      "text": "Nalipay ko nga nagkaila ta.",
      "translation_es": "Me alegra que nos hayamos conocido.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 500.706,
      "end": 502.586,
      "kind": "prompt",
      "text": "Otra vez. «Nos vemos mañana».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 506.586,
      "end": 507.683,
      "kind": "phrase",
      "text": "Kita ta ugma.",
      "translation_es": "Nos vemos mañana.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 510.183,
      "end": 511.881,
      "kind": "prompt",
      "text": "Y ahora, «Eres guapa».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
