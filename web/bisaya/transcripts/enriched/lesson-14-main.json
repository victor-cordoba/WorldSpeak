      "kind": "phrase",
      "text": "Kanta!",
      "translation_es": "¡Canta!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 536.743,
      "end": 538.676,
      "kind": "prompt",
      "text": "Otra vez. «¿Dónde trabajas?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 542.676,
      "end": 544.034,
      "kind": "phrase",
      "text": "Asa ka nagtrabaho?",
      "translation_es": "¿Dónde trabajas?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 546.534,
      "end": 549.303,
      "kind": "instruction",
      "text": "Como hay tiempo, repasemos de nuevo lo anterior.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 549.803,
      "end": 551.34,
      "kind": "instruction",
      "text": "",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 551.84,
      "end": 553.616,
      "kind": "prompt",
      "text": "¿Cómo se dice «¿Cómo estás?»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 557.616,
      "end": 558.661,
      "kind": "phrase",
      "text": "Kumusta ka?",
      "translation_es": "¿Cómo estás?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 561.161,
      "end": 562.435,
      "kind": "prompt",
      "text": "Di: «Bien».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 566.435,
      "end": 567.663,
      "kind": "phrase",
      "text": "Maayo ra.",
      "translation_es": "Bien.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 570.163,
      "end": 571.928,
      "kind": "prompt",
      "text": "¿Cómo se dice «Yo soy María»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 575.928,
      "end": 576.971,
      "kind": "phrase",
      "text": "Ako si Maria.",
      "translation_es": "Yo soy María.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 579.471,
      "end": 581.247,
      "kind": "prompt",
      "text": "Di: «¿Dónde está tu casa?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 585.247,
      "end": 586.766,
      "kind": "phrase",
      "text": "Asa ang balay nimo?",
      "translation_es": "¿Dónde está tu casa?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 589.266,
      "end": 591.199,
      "kind": "prompt",
      "text": "¿Cómo se dice «Está en Cebú»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 595.199,
      "end": 596.557,
      "kind": "phrase",
      "text": "Naa sa Cebu.",
      "translation_es": "Está en Cebú.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 599.057,
      "end": 600.834,
      "kind": "prompt",
      "text": "Di: «¿Tienes buen sueldo?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 604.834,
      "end": 606.295,
      "kind": "phrase",
      "text": "Dako imong sweldo?",
      "translation_es": "¿Tienes buen sueldo?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 608.795,
      "end": 611.224,
      "kind": "instruction",
      "text": "Repaso final. Todo lo de hoy.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 611.724,
      "end": 614.153,
      "kind": "prompt",
      "text": "Di: «Me alegra que nos hayamos conocido».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 618.153,
      "end": 620.034,
      "kind": "phrase",
      "text": "Nalipay ko nga nagkaila ta.",
      "translation_es": "Me alegra que nos hayamos conocido.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 623.534,
      "end": 625.414,
      "kind": "prompt",
      "text": "Otra vez. «Nos vemos mañana».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 629.414,
      "end": 630.512,
      "kind": "phrase",
      "text": "Kita ta ugma.",
      "translation_es": "Nos vemos mañana.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 633.012,
      "end": 634.71,
      "kind": "prompt",
      "text": "Y ahora, «Eres guapa».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 638.71,
      "end": 639.579,
      "kind": "phrase",
      "text": "Gwapa ka.",
      "translation_es": "Eres guapa.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 642.079,
      "end": 643.777,
      "kind": "prompt",
      "text": "¿Cómo se dice «¡Amigo»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 647.777,
      "end": 648.403,
      "kind": "phrase",
      "text": "Bai!",
      "translation_es": "¡Amigo!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 650.903,
      "end": 652.261,
      "kind": "prompt",
      "text": "Di: «¡Canta».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 656.261,
      "end": 657.071,
      "kind": "phrase",
      "text": "Kanta!",
      "translation_es": "¡Canta!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 659.571,
      "end": 661.504,
      "kind": "prompt",
      "text": "Otra vez. «¿Dónde trabajas?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 665.504,
      "end": 666.863,
      "kind": "phrase",
      "text": "Asa ka nagtrabaho?",
      "translation_es": "¿Dónde trabajas?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 669.363,
      "end": 673.743,
      "kind": "instruction",
      "text": "Escucha la conversación completa una vez más. Ahora la entiendes entera.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 674.343,
      "end": 675.571,
      "kind": "dialogue",
      "text": "Kumusta ka, Bai?",
      "translation_es": "¿Cómo estás, amigo?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 676.371,
      "end": 680.159,
      "kind": "dialogue",
      "text": "Maayo man, salamat. Nalipay ko nga nagkaila ta.",
      "translation_es": "Estoy bien, gracias. Me alegra que nos hayamos conocido.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 680.959,
      "end": 682.162,
      "kind": "dialogue",
      "text": "Kita ta ugma?",
      "translation_es": "¿Nos vemos mañana?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 682.962,
      "end": 686.749,
      "kind": "dialogue",
      "text": "Oo, kita ta ugma. Asa ka nagtrabaho karon?",
      "translation_es": "Sí, nos vemos mañana. ¿Dónde trabajas ahora?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 687.549,
      "end": 689.143,
      "kind": "dialogue",
      "text": "Naa sa Guadalupe.",
      "translation_es": "Está en Guadalupe.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 689.943,
      "end": 692.888,
      "kind": "dialogue",
      "text": "Gwapa ka, Bai! Amping ka!",
      "translation_es": "¡Eres guapa, amigo! ¡Cuídate!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 693.688,
      "end": 696.062,
      "kind": "instruction",
      "text": "Hasta la próxima lección. Amping!",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    }
  ],
