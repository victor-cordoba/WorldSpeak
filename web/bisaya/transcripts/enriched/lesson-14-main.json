      "start": 395.771,
      "end": 396.731,
      "kind": "phrase",
      "text": "Asa ka nagtrabaho?",
      "translation_es": "¿Dónde trabajas?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 399.231,
      "end": 400.192,
      "kind": "phrase",
      "text": "Asa ka nagtrabaho?",
      "translation_es": "¿Dónde trabajas?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 401.392,
      "end": 403.577,
      "kind": "explanation",
      "text": "Pregunta sobre el lugar de trabajo.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 404.077,
      "end": 406.689,
      "kind": "prompt",
      "text": "¿Cómo se dice «¿Dónde trabajas?»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 410.689,
      "end": 411.649,
      "kind": "phrase",
      "text": "Asa ka nagtrabaho?",
      "translation_es": "¿Dónde trabajas?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 414.149,
      "end": 416.796,
      "kind": "prompt",
      "text": "Otra vez. «¿Dónde trabajas?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 420.796,
      "end": 421.756,
      "kind": "phrase",
      "text": "Asa ka nagtrabaho?",
      "translation_es": "¿Dónde trabajas?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 424.256,
      "end": 426.021,
      "kind": "instruction",
      "text": "Un momento. Volvamos atrás.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 426.421,
      "end": 428.278,
      "kind": "prompt",
      "text": "Y ahora, «¡Amigo».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 432.278,
      "end": 432.998,
      "kind": "phrase",
      "text": "Bai!",
      "translation_es": "¡Amigo!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 435.498,
      "end": 438.286,
      "kind": "instruction",
      "text": "Pregunta sorpresa, de una lección anterior.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 438.686,
      "end": 443.841,
      "kind": "prompt",
      "text": "Y ahora, «Nosotros (sin ti) y nosotros (contigo)».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 447.841,
      "end": 449.281,
      "kind": "phrase",
      "text": "Kami ug kita",
      "translation_es": "Nosotros (sin ti) y nosotros (contigo)",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 451.781,
      "end": 453.213,
      "kind": "explanation",
      "text": "Predicado primero.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 453.613,
      "end": 466.802,
      "kind": "explanation",
      "text": "En Bisaya, es común colocar el predicado antes del sujeto. Esto se observa en frases como 'Nalipay ko' (Me alegra) y 'Gwapa ka' (Eres guapa).",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 467.402,
      "end": 469.082,
      "kind": "phrase",
      "text": "Nalipay ko nga nagkaila ta.",
      "translation_es": "Me alegra que nos hayamos conocido.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 472.582,
      "end": 474.342,
      "kind": "phrase",
      "text": "Gwapa ka.",
      "translation_es": "Eres guapa.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 476.842,
      "end": 486.269,
      "kind": "instruction",
      "text": "Ahora, a entender. Vas a oír respuestas típicas, con otra voz. Escucha, y piensa qué significan. Luego te lo digo.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 486.869,
      "end": 488.149,
      "kind": "phrase",
      "text": "Amping ka!",
      "translation_es": "¡Cuídate!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 490.149,
      "end": 491.179,
      "kind": "explanation",
      "text": "«¡Cuídate».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 491.679,
      "end": 492.959,
      "kind": "phrase",
      "text": "Amping ka!",
      "translation_es": "¡Cuídate!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 494.159,
      "end": 495.759,
      "kind": "phrase",
      "text": "Naa sa Guadalupe.",
      "translation_es": "Está en Guadalupe.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 497.759,
      "end": 499.176,
      "kind": "explanation",
      "text": "«Está en Guadalupe».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 499.676,
      "end": 501.276,
      "kind": "phrase",
      "text": "Naa sa Guadalupe.",
      "translation_es": "Está en Guadalupe.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 502.476,
      "end": 508.348,
      "kind": "instruction",
      "text": "Conversación guiada. Yo te digo la situación, tú hablas, y luego lo oyes.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 508.948,
      "end": 513.88,
      "kind": "prompt",
      "text": "Te encuentras con un amigo en el mercado y quieres saber dónde trabaja.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 517.88,
      "end": 518.84,
      "kind": "phrase",
      "text": "Asa ka nagtrabaho?",
      "translation_es": "¿Dónde trabajas?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 521.34,
      "end": 524.173,
      "kind": "instruction",
      "text": "Repaso final. Todo lo de hoy.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 524.673,
      "end": 528.071,
      "kind": "prompt",
      "text": "Di: «Me alegra que nos hayamos conocido».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
