      "note_es": "",
      "language": "en"
    },
    {
      "start": 585.848,
      "end": 587.367,
      "kind": "phrase",
      "text": "Asa ang balay nimo?",
      "translation_es": "¿Dónde está tu casa?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 589.867,
      "end": 591.408,
      "kind": "prompt",
      "text": "Di: «Está en Cebú».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 595.408,
      "end": 596.766,
      "kind": "phrase",
      "text": "Naa sa Cebu.",
      "translation_es": "Está en Cebú.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 599.266,
      "end": 601.042,
      "kind": "prompt",
      "text": "¿Cómo se dice «¿Cómo estás?»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 605.042,
      "end": 606.087,
      "kind": "phrase",
      "text": "Kumusta ka?",
      "translation_es": "¿Cómo estás?",
      "note_es": "",
