      "note_es": "",
      "language": "en"
    },
    {
      "start": 639.564,
      "end": 641.993,
      "kind": "prompt",
      "text": "Di: «Me alegra que nos hayamos conocido».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 645.993,
      "end": 647.874,
      "kind": "phrase",
      "text": "Nalipay ko nga nagkaila ta.",
      "translation_es": "Me alegra que nos hayamos conocido.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 651.374,
      "end": 653.254,
      "kind": "prompt",
      "text": "Otra vez. «Nos vemos mañana».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
