      "text": "Gwapa ka.",
      "translation_es": "Eres guapa.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 669.918,
      "end": 671.616,
      "kind": "prompt",
      "text": "¿Cómo se dice «¡Amigo»?",
