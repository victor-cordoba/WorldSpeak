      "note_es": "",
      "language": "tl"
    },
    {
      "start": 617.589,
      "end": 619.354,
      "kind": "prompt",
      "text": "¿Cómo se dice «Yo soy María»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 623.354,
      "end": 624.397,
      "kind": "phrase",
      "text": "Ako si Maria.",
      "translation_es": "Yo soy María.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 626.897,
      "end": 628.673,
      "kind": "prompt",
      "text": "Di: «¿Tienes buen sueldo?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 632.673,
      "end": 634.134,
      "kind": "phrase",
      "text": "Dako imong sweldo?",
      "translation_es": "¿Tienes buen sueldo?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 636.634,
      "end": 639.064,
      "kind": "instruction",
      "text": "Repaso final. Todo lo de hoy.",
