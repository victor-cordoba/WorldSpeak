      "kind": "phrase",
      "text": "Asa ka nagtrabaho?",
      "translation_es": "¿Dónde trabajas?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 697.202,
      "end": 701.583,
      "kind": "instruction",
      "text": "Escucha la conversación completa una vez más. Ahora la entiendes entera.",
