      "note_es": "",
      "language": "en"
    },
    {
      "start": 657.913,
      "end": 659.593,
      "kind": "phrase",
      "text": "Nalipay ko nga nagkaila ta.",
      "translation_es": "Me alegra que nos hayamos conocido.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 663.093,
      "end": 665.276,
      "kind": "prompt",
      "text": "Otra vez. «Nos vemos mañana».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 669.276,
      "end": 670.476,
      "kind": "phrase",
      "text": "Kita ta ugma.",
      "translation_es": "Nos vemos mañana.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 672.976,
      "end": 674.834,
      "kind": "prompt",
      "text": "Y ahora, «Eres guapa».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 678.834,
      "end": 680.594,
      "kind": "phrase",
      "text": "Gwapa ka.",
      "translation_es": "Eres guapa.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 683.094,
      "end": 684.831,
      "kind": "prompt",
      "text": "¿Cómo se dice «¡Amigo»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 688.831,
      "end": 689.551,
      "kind": "phrase",
      "text": "Bai!",
      "translation_es": "¡Amigo!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 692.051,
      "end": 693.455,
      "kind": "prompt",
      "text": "Di: «¡Canta».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 697.455,
      "end": 698.095,
      "kind": "phrase",
      "text": "Kanta!",
      "translation_es": "¡Canta!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 700.595,
      "end": 703.242,
      "kind": "prompt",
      "text": "Otra vez. «¿Dónde trabajas?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 707.242,
      "end": 708.202,
      "kind": "phrase",
      "text": "Asa ka nagtrabaho?",
      "translation_es": "¿Dónde trabajas?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 710.702,
      "end": 716.135,
      "kind": "instruction",
      "text": "Escucha la conversación completa una vez más. Ahora la entiendes entera.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 716.735,
      "end": 717.775,
      "kind": "dialogue",
      "text": "Kumusta ka, Bai?",
      "translation_es": "¿Cómo estás, amigo?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 718.575,
      "end": 722.989,
      "kind": "dialogue",
      "text": "Maayo man, salamat. Nalipay ko nga nagkaila ta.",
      "translation_es": "Estoy bien, gracias. Me alegra que nos hayamos conocido.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 723.789,
      "end": 724.694,
      "kind": "dialogue",
      "text": "Kita ta ugma?",
      "translation_es": "¿Nos vemos mañana?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 725.494,
      "end": 729.414,
      "kind": "dialogue",
      "text": "Oo, kita ta ugma. Asa ka nagtrabaho karon?",
      "translation_es": "Sí, nos vemos mañana. ¿Dónde trabajas ahora?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 730.214,
      "end": 731.654,
      "kind": "dialogue",
      "text": "Naa sa Guadalupe.",
      "translation_es": "Está en Guadalupe.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 732.454,
      "end": 734.578,
      "kind": "dialogue",
      "text": "Gwapa ka, Bai! Amping ka!",
      "translation_es": "¡Eres guapa, amigo! ¡Cuídate!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 735.378,
      "end": 737.747,
      "kind": "instruction",
      "text": "Hasta la próxima lección. Amping!",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    }
  ],
