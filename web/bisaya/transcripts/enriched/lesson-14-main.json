      "kind": "phrase",
      "text": "Kita ta ugma.",
      "translation_es": "Nos vemos mañana.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 660.851,
      "end": 662.549,
      "kind": "prompt",
