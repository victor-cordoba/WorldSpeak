      "note_es": "",
      "language": "tl"
    },
    {
      "start": 378.583,
      "end": 379.942,
      "kind": "phrase",
      "text": "Asa ka nagtrabaho?",
      "translation_es": "¿Dónde trabajas?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 382.442,
      "end": 383.8,
      "kind": "phrase",
      "text": "Asa ka nagtrabaho?",
      "translation_es": "¿Dónde trabajas?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 385.0,
      "end": 387.012,
      "kind": "explanation",
      "text": "Pregunta sobre el lugar de trabajo.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 387.512,
      "end": 389.654,
      "kind": "prompt",
      "text": "¿Cómo se dice «¿Dónde trabajas?»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 393.654,
      "end": 395.012,
      "kind": "phrase",
      "text": "Asa ka nagtrabaho?",
      "translation_es": "¿Dónde trabajas?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 397.512,
      "end": 399.445,
      "kind": "prompt",
      "text": "Otra vez. «¿Dónde trabajas?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 403.445,
      "end": 404.803,
      "kind": "phrase",
      "text": "Asa ka nagtrabaho?",
      "translation_es": "¿Dónde trabajas?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 407.303,
      "end": 409.312,
      "kind": "instruction",
      "text": "Un momento. Volvamos atrás.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 409.712,
      "end": 411.175,
      "kind": "prompt",
      "text": "Y ahora, «¡Amigo».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 415.175,
      "end": 415.801,
      "kind": "phrase",
      "text": "Bai!",
      "translation_es": "¡Amigo!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 418.301,
      "end": 421.253,
      "kind": "instruction",
      "text": "Pregunta sorpresa, de una lección anterior.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 421.653,
      "end": 425.754,
      "kind": "prompt",
      "text": "Y ahora, «Nosotros (sin ti) y nosotros (contigo)».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 429.754,
      "end": 430.93,
      "kind": "phrase",
      "text": "Kami ug kita",
      "translation_es": "Nosotros (sin ti) y nosotros (contigo)",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 433.43,
      "end": 434.71,
      "kind": "explanation",
      "text": "Predicado primero.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 435.11,
      "end": 444.749,
      "kind": "explanation",
      "text": "En Bisaya, es común colocar el predicado antes del sujeto. Esto se observa en frases como 'Nalipay ko' (Me alegra) y 'Gwapa ka' (Eres guapa).",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 445.349,
      "end": 447.23,
      "kind": "phrase",
      "text": "Nalipay ko nga nagkaila ta.",
      "translation_es": "Me alegra que nos hayamos conocido.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 450.73,
      "end": 451.599,
      "kind": "phrase",
      "text": "Gwapa ka.",
      "translation_es": "Eres guapa.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 454.099,
      "end": 461.778,
      "kind": "instruction",
      "text": "Ahora, a entender. Vas a oír respuestas típicas, con otra voz. Escucha, y piensa qué significan. Luego te lo digo.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 462.378,
      "end": 463.499,
      "kind": "phrase",
      "text": "Amping ka!",
      "translation_es": "¡Cuídate!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 465.499,
      "end": 466.257,
      "kind": "explanation",
      "text": "«¡Cuídate».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 466.757,
      "end": 467.878,
      "kind": "phrase",
      "text": "Amping ka!",
      "translation_es": "¡Cuídate!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 469.078,
      "end": 470.906,
      "kind": "phrase",
      "text": "Naa sa Guadalupe.",
      "translation_es": "Está en Guadalupe.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 472.906,
      "end": 474.369,
      "kind": "explanation",
      "text": "«Está en Guadalupe».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 474.869,
      "end": 476.698,
      "kind": "phrase",
      "text": "Naa sa Guadalupe.",
      "translation_es": "Está en Guadalupe.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 477.898,
      "end": 482.965,
      "kind": "instruction",
      "text": "Conversación guiada. Yo te digo la situación, tú hablas, y luego lo oyes.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 483.565,
      "end": 487.432,
      "kind": "prompt",
      "text": "Te encuentras con un amigo en el mercado y quieres saber dónde trabaja.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 491.432,
      "end": 492.79,
      "kind": "phrase",
      "text": "Asa ka nagtrabaho?",
      "translation_es": "¿Dónde trabajas?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 495.29,
      "end": 497.719,
      "kind": "instruction",
      "text": "Repaso final. Todo lo de hoy.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 498.219,
      "end": 500.649,
      "kind": "prompt",
      "text": "Di: «Me alegra que nos hayamos conocido».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 504.649,
      "end": 506.53,
      "kind": "phrase",
      "text": "Nalipay ko nga nagkaila ta.",
      "translation_es": "Me alegra que nos hayamos conocido.",
      "note_es": "",
      "language": "tl"
    },
    {
