      "language": "en"
    },
    {
      "start": 702.183,
      "end": 703.411,
      "kind": "dialogue",
      "text": "Kumusta ka, Bai?",
      "translation_es": "¿Cómo estás, amigo?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 704.211,
      "end": 707.999,
      "kind": "dialogue",
      "text": "Maayo man, salamat. Nalipay ko nga nagkaila ta.",
      "translation_es": "Estoy bien, gracias. Me alegra que nos hayamos conocido.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 708.799,
      "end": 710.001,
      "kind": "dialogue",
      "text": "Kita ta ugma?",
      "translation_es": "¿Nos vemos mañana?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 710.801,
      "end": 714.589,
      "kind": "dialogue",
      "text": "Oo, kita ta ugma. Asa ka nagtrabaho karon?",
      "translation_es": "Sí, nos vemos mañana. ¿Dónde trabajas ahora?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 715.389,
      "end": 716.983,
      "kind": "dialogue",
      "text": "Naa sa Guadalupe.",
      "translation_es": "Está en Guadalupe.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 717.783,
      "end": 720.728,
      "kind": "dialogue",
      "text": "Gwapa ka, Bai! Amping ka!",
      "translation_es": "¡Eres guapa, amigo! ¡Cuídate!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 721.528,
      "end": 723.902,
      "kind": "instruction",
      "text": "Hasta la próxima lección. Amping!",
