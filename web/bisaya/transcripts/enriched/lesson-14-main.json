      "note_es": "",
      "language": "en"
    },
    {
      "start": 596.302,
      "end": 596.942,
      "kind": "phrase",
      "text": "Kumusta ka?",
      "translation_es": "¿Cómo estás?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 599.442,
      "end": 600.797,
      "kind": "prompt",
      "text": "Di: «Bien».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 604.797,
      "end": 605.517,
      "kind": "phrase",
      "text": "Maayo ra.",
      "translation_es": "Bien.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 608.017,
      "end": 610.167,
      "kind": "prompt",
      "text": "¿Cómo se dice «Yo soy María»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 614.167,
      "end": 615.186,
      "kind": "phrase",
      "text": "Ako si Maria.",
      "translation_es": "Yo soy María.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 617.686,
      "end": 620.147,
      "kind": "prompt",
      "text": "Di: «¿Dónde está tu casa?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 624.147,
      "end": 625.145,
      "kind": "phrase",
      "text": "Asa ang balay nimo?",
      "translation_es": "¿Dónde está tu casa?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 627.645,
      "end": 629.788,
      "kind": "prompt",
      "text": "¿Cómo se dice «Está en Cebú»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 633.788,
      "end": 634.748,
      "kind": "phrase",
      "text": "Naa sa Cebu.",
      "translation_es": "Está en Cebú.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 637.248,
      "end": 639.484,
      "kind": "prompt",
      "text": "Di: «¿Tienes buen sueldo?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 643.484,
      "end": 644.683,
      "kind": "phrase",
      "text": "Dako imong sweldo?",
      "translation_es": "¿Tienes buen sueldo?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 647.183,
      "end": 650.015,
      "kind": "instruction",
      "text": "Repaso final. Todo lo de hoy.",
