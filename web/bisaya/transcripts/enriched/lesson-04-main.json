    },
    {
      "start": 356.382,
      "end": 357.793,
      "kind": "phrase",
      "text": "Kabalo ka mag-Ingles?",
      "translation_es": "¿Sabes hablar inglés?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 360.293,
      "end": 361.991,
      "kind": "explanation",
      "text": "Uso de 'asa' y 'hain'.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 362.391,
      "end": 376.523,
      "kind": "explanation",
      "text": "En Bisaya, 'asa' se usa con verbos para preguntar por ubicaciones, mientras que 'hain' se usa sin verbo. Por ejemplo, 'asa ka karun?' para preguntar '¿Dónde estás ahora?' y 'hain ang tindahan?' para preguntar '¿Dónde está la tienda?'.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 377.123,
      "end": 378.168,
      "kind": "phrase",
      "text": "Asa ka karun?",
      "translation_es": "¿Dónde estás ahora?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 380.668,
      "end": 381.895,
      "kind": "phrase",
      "text": "Hain ang tindahan?",
      "translation_es": "¿Dónde está la tienda?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 384.395,
      "end": 392.074,
      "kind": "instruction",
      "text": "Ahora, a entender. Vas a oír respuestas típicas, con otra voz. Escucha, y piensa qué significan. Luego te lo digo.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 392.674,
      "end": 393.85,
      "kind": "phrase",
      "text": "Diri ra.",
      "translation_es": "Aquí nomás.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 395.85,
      "end": 396.789,
      "kind": "explanation",
      "text": "«Aquí nomás».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 397.289,
      "end": 398.464,
      "kind": "phrase",
      "text": "Diri ra.",
      "translation_es": "Aquí nomás.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 399.664,
      "end": 401.071,
      "kind": "phrase",
      "text": "Diha sa merkado.",
      "translation_es": "Allí en el mercado.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 403.071,
      "end": 404.377,
      "kind": "explanation",
      "text": "«Allí en el mercado».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 404.877,
      "end": 406.285,
      "kind": "phrase",
      "text": "Diha sa merkado.",
      "translation_es": "Allí en el mercado.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 407.485,
      "end": 408.947,
      "kind": "phrase",
      "text": "Didto sa balay.",
      "translation_es": "Allí en la casa.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 410.947,
      "end": 412.123,
      "kind": "explanation",
      "text": "«Allí en la casa».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 412.623,
      "end": 414.085,
      "kind": "phrase",
      "text": "Didto sa balay.",
      "translation_es": "Allí en la casa.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 415.285,
      "end": 416.982,
      "kind": "phrase",
      "text": "Duol ra sa here.",
      "translation_es": "Cerca de aquí.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 418.982,
      "end": 420.105,
      "kind": "explanation",
      "text": "«Cerca de aquí».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 420.605,
      "end": 422.302,
      "kind": "phrase",
      "text": "Duol ra sa here.",
      "translation_es": "Cerca de aquí.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 423.502,
      "end": 428.57,
      "kind": "instruction",
      "text": "Conversación guiada. Yo te digo la situación, tú hablas, y luego lo oyes.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 429.17,
      "end": 433.271,
      "kind": "prompt",
      "text": "Estás en el mercado y buscas la tienda de frutas. Pregunta dónde está.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 437.271,
      "end": 438.499,
      "kind": "phrase",
      "text": "Hain ang tindahan?",
      "translation_es": "¿Dónde está la tienda?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 440.999,
      "end": 443.715,
      "kind": "prompt",
      "text": "Quieres saber qué hora es. Pregunta la hora.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 447.715,
      "end": 449.074,
      "kind": "phrase",
      "text": "Unsa ang oras?",
      "translation_es": "¿Qué hora es?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 451.574,
      "end": 454.003,
      "kind": "instruction",
      "text": "Repaso final. Todo lo de hoy.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 454.503,
      "end": 456.436,
      "kind": "prompt",
      "text": "Di: «¿Dónde estás ahora?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 460.436,
      "end": 461.481,
      "kind": "phrase",
      "text": "Asa ka karun?",
      "translation_es": "¿Dónde estás ahora?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 463.981,
      "end": 466.045,
      "kind": "prompt",
      "text": "Otra vez. «¿Dónde está la tienda?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 470.045,
      "end": 471.273,
      "kind": "phrase",
      "text": "Hain ang tindahan?",
      "translation_es": "¿Dónde está la tienda?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 473.773,
      "end": 475.705,
      "kind": "prompt",
      "text": "Y ahora, «¿Quién es el maestro?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 479.705,
      "end": 480.996,
      "kind": "phrase",
      "text": "Kinsa ang maestro?",
      "translation_es": "¿Quién es el maestro?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 483.496,
      "end": 485.22,
      "kind": "prompt",
      "text": "¿Cómo se dice «¿Qué hora es?»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 489.22,
      "end": 490.579,
      "kind": "phrase",
      "text": "Unsa ang oras?",
      "translation_es": "¿Qué hora es?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 493.079,
      "end": 494.671,
      "kind": "prompt",
      "text": "Di: «Aquí nomás».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 498.671,
      "end": 499.429,
      "kind": "phrase",
      "text": "Diri ra.",
      "translation_es": "Aquí nomás.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 501.929,
      "end": 504.698,
      "kind": "instruction",
      "text": "Como hay tiempo, repasemos de nuevo lo anterior.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 505.198,
      "end": 506.735,
      "kind": "instruction",
      "text": "",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 507.235,
      "end": 509.429,
      "kind": "prompt",
      "text": "¿Cómo se dice «¿Dónde está tu casa?»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 513.429,
      "end": 514.948,
      "kind": "phrase",
      "text": "Asa ang balay nimo?",
      "translation_es": "¿Dónde está tu casa?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 517.448,
      "end": 518.989,
      "kind": "prompt",
      "text": "Di: «Está en Cebú».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 522.989,
      "end": 524.348,
      "kind": "phrase",
      "text": "Naa sa Cebu.",
      "translation_es": "Está en Cebú.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 526.848,
      "end": 528.441,
      "kind": "prompt",
      "text": "¿Cómo se dice «¿Quién es María?»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 532.441,
      "end": 533.617,
      "kind": "phrase",
      "text": "Kinsa si Maria?",
      "translation_es": "¿Quién es María?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 536.117,
      "end": 537.841,
      "kind": "prompt",
      "text": "Di: «Ella es mi hermana».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 541.841,
      "end": 543.182,
      "kind": "phrase",
      "text": "Siya ang igsoon ko.",
      "translation_es": "Ella es mi hermana.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 545.682,
      "end": 547.197,
      "kind": "prompt",
      "text": "¿Cómo se dice «¿A dónde vas?»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 551.197,
      "end": 552.608,
      "kind": "phrase",
      "text": "Asa ka padulong?",
      "translation_es": "¿A dónde vas?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 555.108,
      "end": 557.119,
      "kind": "prompt",
      "text": "Di: «¿Sabes hablar Bisaya?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 561.119,
      "end": 562.764,
      "kind": "phrase",
      "text": "Kabalo ka mag-Binisaya?",
      "translation_es": "¿Sabes hablar Bisaya?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 566.264,
      "end": 568.029,
      "kind": "prompt",
      "text": "¿Cómo se dice «Yo soy María»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 572.029,
      "end": 573.072,
      "kind": "phrase",
      "text": "Ako si Maria.",
      "translation_es": "Yo soy María.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 575.572,
      "end": 578.001,
      "kind": "instruction",
      "text": "Repaso final. Todo lo de hoy.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 578.501,
      "end": 580.434,
      "kind": "prompt",
      "text": "Di: «¿Dónde estás ahora?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 584.434,
      "end": 585.479,
      "kind": "phrase",
      "text": "Asa ka karun?",
      "translation_es": "¿Dónde estás ahora?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 587.979,
      "end": 590.043,
      "kind": "prompt",
      "text": "Otra vez. «¿Dónde está la tienda?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 594.043,
      "end": 595.271,
      "kind": "phrase",
      "text": "Hain ang tindahan?",
      "translation_es": "¿Dónde está la tienda?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 597.771,
      "end": 599.703,
      "kind": "prompt",
      "text": "Y ahora, «¿Quién es el maestro?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 603.703,
      "end": 604.994,
      "kind": "phrase",
      "text": "Kinsa ang maestro?",
      "translation_es": "¿Quién es el maestro?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 607.494,
      "end": 609.218,
      "kind": "prompt",
      "text": "¿Cómo se dice «¿Qué hora es?»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 613.218,
      "end": 614.577,
      "kind": "phrase",
      "text": "Unsa ang oras?",
      "translation_es": "¿Qué hora es?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 617.077,
      "end": 618.67,
      "kind": "prompt",
      "text": "Di: «Aquí nomás».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 622.67,
      "end": 623.427,
      "kind": "phrase",
      "text": "Diri ra.",
      "translation_es": "Aquí nomás.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 625.927,
      "end": 630.308,
      "kind": "instruction",
      "text": "Escucha la conversación completa una vez más. Ahora la entiendes entera.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 630.908,
      "end": 633.674,
      "kind": "dialogue",
      "text": "Maayong buntag! Asa ka padulong?",
      "translation_es": "¡Buenos días! ¿A dónde vas?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 634.474,
      "end": 640.368,
      "kind": "dialogue",
      "text": "Maayong buntag! Adto ko sa merkado. Asa ang tindahan sa prutas?",
      "translation_es": "¡Buenos días! Voy al mercado. ¿Dónde está la tienda de frutas?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 641.168,
      "end": 643.63,
      "kind": "dialogue",
      "text": "Diha ra sa merkado, duol ra.",
      "translation_es": "Allí en el mercado, está cerca.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 644.43,
      "end": 647.511,
      "kind": "dialogue",
      "text": "Salamat! Unsa ang oras karun?",
      "translation_es": "¡Gracias! ¿Qué hora es ahora?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 648.311,
      "end": 650.975,
      "kind": "dialogue",
      "text": "Unsa ang oras? Alas diyes na.",
      "translation_es": "¿Qué hora es? Ya son las diez.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 651.775,
      "end": 654.149,
      "kind": "instruction",
      "text": "Hasta la próxima lección. Amping!",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    }
  ],
