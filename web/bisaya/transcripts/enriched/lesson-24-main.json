      "note_es": "",
      "language": "tl"
    },
    {
      "start": 397.546,
      "end": 406.974,
      "kind": "instruction",
      "text": "Ahora, a entender. Vas a oír respuestas típicas, con otra voz. Escucha, y piensa qué significan. Luego te lo digo.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 407.574,
      "end": 409.254,
      "kind": "phrase",
      "text": "Naa sa Lorega.",
