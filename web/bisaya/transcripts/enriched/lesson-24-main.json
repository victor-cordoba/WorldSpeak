      "note_es": "",
      "language": "tl"
    },
    {
      "start": 405.578,
      "end": 410.646,
      "kind": "instruction",
      "text": "Conversación guiada. Yo te digo la situación, tú hablas, y luego lo oyes.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 411.246,
      "end": 415.452,
      "kind": "prompt",
      "text": "Ves a un niño en la calle y quieres advertirle sobre el peligro de las drogas.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 419.452,
      "end": 420.862,
      "kind": "phrase",
      "text": "Naa bay droga diri?",
