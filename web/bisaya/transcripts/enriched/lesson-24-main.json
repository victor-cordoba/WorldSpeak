      "note_es": "",
      "language": "tl"
    },
    {
      "start": 380.862,
      "end": 388.541,
      "kind": "instruction",
      "text": "Ahora, a entender. Vas a oír respuestas típicas, con otra voz. Escucha, y piensa qué significan. Luego te lo digo.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 389.141,
      "end": 390.838,
      "kind": "phrase",
      "text": "Naa sa Lorega.",
