      "note_es": "",
      "language": "tl"
    },
    {
      "start": 436.731,
      "end": 439.16,
      "kind": "instruction",
      "text": "Repaso final. Todo lo de hoy.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 439.66,
      "end": 441.489,
      "kind": "prompt",
      "text": "Di: «¿Hay drogas aquí?».",
      "translation_es": "",
      "note_es": "",
