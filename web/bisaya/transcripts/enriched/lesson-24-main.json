    },
    {
      "start": 377.086,
      "end": 386.986,
      "kind": "explanation",
      "text": "El término 'ayaw' se utiliza para indicar prohibición o advertencia. Es una forma de decir 'no lo hagas' o 'evita'. Se usa en situaciones donde se quiere prevenir una acción.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 387.586,
      "end": 388.473,
      "kind": "phrase",
