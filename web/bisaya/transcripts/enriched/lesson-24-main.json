      "language": "tl"
    },
    {
      "start": 418.947,
      "end": 424.015,
      "kind": "instruction",
      "text": "Conversación guiada. Yo te digo la situación, tú hablas, y luego lo oyes.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 424.615,
      "end": 428.82,
      "kind": "prompt",
      "text": "Ves a un niño en la calle y quieres advertirle sobre el peligro de las drogas.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 432.82,
      "end": 434.231,
      "kind": "phrase",
      "text": "Naa bay droga diri?",
