      "note_es": "",
      "language": "en"
    },
    {
      "start": 363.559,
      "end": 365.44,
      "kind": "phrase",
      "text": "Nalipay ko nga nagkaila ta.",
      "translation_es": "Me alegra que nos hayamos conocido.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 368.94,
