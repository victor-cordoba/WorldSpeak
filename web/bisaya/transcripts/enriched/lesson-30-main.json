      "note_es": "",
      "language": "en"
    },
    {
      "start": 372.96,
      "end": 374.319,
      "kind": "phrase",
      "text": "Nagtrabaho ka?",
      "translation_es": "¿Estás trabajando?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 376.819,
      "end": 379.77,
      "kind": "instruction",
      "text": "Pregunta sorpresa, de una lección anterior.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 380.17,
      "end": 383.122,
      "kind": "prompt",
      "text": "Y ahora, «Me alegra que nos hayamos conocido».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 387.122,
      "end": 389.003,
      "kind": "phrase",
      "text": "Nalipay ko nga nagkaila ta.",
      "translation_es": "Me alegra que nos hayamos conocido.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 392.503,
      "end": 394.384,
      "kind": "explanation",
      "text": "Verbos en presente continuo.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 394.784,
      "end": 404.237,
      "kind": "explanation",
      "text": "En Bisaya, para expresar que alguien está realizando una acción en este momento, se utiliza el prefijo 'nag-' antes del verbo. Esto indica que la acción está en curso.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 404.837,
      "end": 406.117,
      "kind": "phrase",
      "text": "Nagkaon ka?",
      "translation_es": "¿Estás comiendo?",
