      "kind": "phrase",
      "text": "Nagtrabaho ka?",
      "translation_es": "¿Estás trabajando?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 412.475,
      "end": 420.154,
      "kind": "instruction",
      "text": "Ahora, a entender. Vas a oír respuestas típicas, con otra voz. Escucha, y piensa qué significan. Luego te lo digo.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 420.754,
      "end": 422.682,
      "kind": "phrase",
      "text": "Oo, nagkaon.",
      "translation_es": "Sí, estoy comiendo.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 424.682,
      "end": 426.197,
      "kind": "explanation",
      "text": "«Sí, estoy comiendo».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
