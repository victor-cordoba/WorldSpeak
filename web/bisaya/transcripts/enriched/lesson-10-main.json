    },
    {
      "start": 775.398,
      "end": 776.704,
      "kind": "dialogue",
      "text": "Naa kay pamilya?",
      "translation_es": "¿Tienes familia?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 777.504,
      "end": 780.038,
      "kind": "dialogue",
      "text": "Oo, naa koy mama ug papa.",
      "translation_es": "Sí, tengo mamá y papá.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 780.838,
      "end": 782.066,
      "kind": "dialogue",
      "text": "Pila mo sa pamilya?",
      "translation_es": "¿Cuántos sois en la familia?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 782.866,
      "end": 784.98,
      "kind": "dialogue",
      "text": "Upat mi. Naa koy igsoon.",
      "translation_es": "Somos cuatro. Tengo un hermano.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 785.78,
      "end": 787.321,
      "kind": "dialogue",
      "text": "Naa ko sa Cebu karun.",
      "translation_es": "Estoy en Cebú ahora.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 788.121,
      "end": 789.948,
      "kind": "dialogue",
      "text": "Maayo, amping!",
      "translation_es": "Bien, ¡cuídate!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 790.748,
      "end": 793.122,
      "kind": "instruction",
      "text": "Hasta la próxima lección. Amping!",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    }
