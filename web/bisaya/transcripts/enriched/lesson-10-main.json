      "translation_es": "Bien.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 811.851,
      "end": 813.211,
      "kind": "dialogue",
      "text": "Naa kay pamilya?",
      "translation_es": "¿Tienes familia?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 814.011,
      "end": 816.62,
      "kind": "dialogue",
      "text": "Oo, naa koy mama ug papa.",
      "translation_es": "Sí, tengo mamá y papá.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 817.42,
      "end": 818.578,
      "kind": "dialogue",
      "text": "Pila mo sa pamilya?",
      "translation_es": "¿Cuántos sois en la familia?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 819.378,
      "end": 821.742,
      "kind": "dialogue",
      "text": "Upat mi. Naa koy igsoon.",
      "translation_es": "Somos cuatro. Tengo un hermano.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 822.542,
      "end": 824.062,
      "kind": "dialogue",
      "text": "Naa ko sa Cebu karun.",
      "translation_es": "Estoy en Cebú ahora.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 824.862,
      "end": 826.382,
      "kind": "dialogue",
      "text": "Maayo, amping!",
      "translation_es": "Bien, ¡cuídate!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 827.182,
      "end": 829.551,
      "kind": "instruction",
      "text": "Hasta la próxima lección. Amping!",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    }
  ],
