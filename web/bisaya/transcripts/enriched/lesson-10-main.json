      "translation_es": "Hermano mayor / Hermana mayor",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 780.233,
      "end": 784.614,
      "kind": "instruction",
      "text": "Escucha la conversación completa una vez más. Ahora la entiendes entera.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 785.214,
      "end": 786.259,
      "kind": "dialogue",
      "text": "Kumusta ka?",
      "translation_es": "¿Cómo estás?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 787.059,
      "end": 788.286,
      "kind": "dialogue",
      "text": "Maayo ra.",
      "translation_es": "Bien.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 789.086,
      "end": 790.393,
      "kind": "dialogue",
      "text": "Naa kay pamilya?",
      "translation_es": "¿Tienes familia?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 791.193,
      "end": 793.726,
      "kind": "dialogue",
      "text": "Oo, naa koy mama ug papa.",
      "translation_es": "Sí, tengo mamá y papá.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 794.526,
      "end": 795.754,
      "kind": "dialogue",
      "text": "Pila mo sa pamilya?",
      "translation_es": "¿Cuántos sois en la familia?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 796.554,
      "end": 798.669,
      "kind": "dialogue",
      "text": "Upat mi. Naa koy igsoon.",
      "translation_es": "Somos cuatro. Tengo un hermano.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 799.469,
      "end": 801.01,
      "kind": "dialogue",
      "text": "Naa ko sa Cebu karun.",
      "translation_es": "Estoy en Cebú ahora.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 801.81,
      "end": 803.637,
      "kind": "dialogue",
      "text": "Maayo, amping!",
      "translation_es": "Bien, ¡cuídate!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 804.437,
      "end": 806.811,
      "kind": "instruction",
      "text": "Hasta la próxima lección. Amping!",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    }
  ],
