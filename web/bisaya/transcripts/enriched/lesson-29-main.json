      "start": 789.585,
      "end": 790.578,
      "kind": "phrase",
      "text": "Barato.",
      "translation_es": "Barato.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 793.078,
      "end": 794.541,
      "kind": "prompt",
      "text": "Di: «¿Dónde trabajas?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 798.541,
      "end": 799.899,
      "kind": "phrase",
      "text": "Asa ka nagtrabaho?",
      "translation_es": "¿Dónde trabajas?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 802.399,
      "end": 803.675,
      "kind": "prompt",
      "text": "¿Cómo se dice «Misa»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 807.675,
      "end": 808.378,
      "kind": "phrase",
      "text": "Misa",
      "translation_es": "Misa",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 810.878,
      "end": 813.307,
      "kind": "instruction",
      "text": "Repaso final. Todo lo de hoy.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 813.807,
      "end": 815.401,
      "kind": "prompt",
      "text": "Di: «¡Pero delicioso».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 819.401,
      "end": 820.358,
      "kind": "phrase",
      "text": "Pero lami!",
      "translation_es": "¡Pero delicioso!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 822.858,
      "end": 825.0,
      "kind": "prompt",
      "text": "Otra vez. «Porque voy al mercado».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 829.0,
      "end": 830.881,
      "kind": "phrase",
      "text": "Kay adto ko sa merkado.",
      "translation_es": "Porque voy al mercado.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 834.381,
      "end": 836.308,
      "kind": "prompt",
      "text": "Y ahora, «Yo también quiero».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 840.308,
      "end": 841.587,
      "kind": "phrase",
      "text": "Gusto pud ko.",
      "translation_es": "Yo también quiero.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 844.087,
      "end": 846.046,
      "kind": "prompt",
      "text": "¿Cómo se dice «Por eso tengo prisa»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 850.046,
      "end": 851.506,
      "kind": "phrase",
      "text": "Mao nga nagdali ko.",
      "translation_es": "Por eso tengo prisa.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 854.006,
      "end": 855.887,
      "kind": "prompt",
      "text": "Di: «Si quieres, vamos».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 859.887,
      "end": 862.029,
      "kind": "phrase",
      "text": "Kung gusto ka, adto ta.",
      "translation_es": "Si quieres, vamos.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 865.529,
      "end": 868.063,
      "kind": "prompt",
      "text": "Otra vez. «Nos vemos mañana entonces».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 872.063,
      "end": 873.944,
      "kind": "phrase",
      "text": "Dayon ugma ta magkita.",
      "translation_es": "Nos vemos mañana entonces.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 876.444,
      "end": 878.142,
      "kind": "prompt",
      "text": "Y ahora, «Aquí nomás».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 882.142,
      "end": 883.369,
      "kind": "phrase",
      "text": "Diri ra lang ko.",
      "translation_es": "Aquí nomás.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 885.869,
      "end": 888.012,
      "kind": "prompt",
      "text": "¿Cómo se dice «Quizás vaya a Cebú»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 892.012,
      "end": 893.97,
      "kind": "phrase",
      "text": "Siguro moadto ko sa Cebu.",
      "translation_es": "Quizás vaya a Cebú.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 897.47,
      "end": 901.851,
      "kind": "instruction",
      "text": "Escucha la conversación completa una vez más. Ahora la entiendes entera.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 902.451,
      "end": 905.063,
      "kind": "dialogue",
      "text": "Kumusta ka? Asa ka padulong?",
      "translation_es": "¿Cómo estás? ¿A dónde vas?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 905.863,
      "end": 909.311,
      "kind": "dialogue",
      "text": "Adto ko sa merkado kay gusto ko og prutas.",
      "translation_es": "Voy al mercado porque quiero fruta.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 910.111,
      "end": 913.191,
      "kind": "dialogue",
      "text": "Lami ang mga prutas diri, pero mahal pud.",
      "translation_es": "Las frutas aquí son deliciosas, pero también caras.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 913.991,
      "end": 916.458,
      "kind": "dialogue",
      "text": "Mao nga magtan-aw ko ug barato.",
      "translation_es": "Por eso buscaré algo barato.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 917.258,
      "end": 919.557,
      "kind": "dialogue",
      "text": "Kung gusto ka, tabangan tika.",
      "translation_es": "Si quieres, te ayudo.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 920.357,
      "end": 923.152,
      "kind": "dialogue",
      "text": "Salamat! Dayon, adto ta.",
      "translation_es": "¡Gracias! Entonces, vamos.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 923.952,
      "end": 926.326,
      "kind": "instruction",
      "text": "Hasta la próxima lección. Amping!",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    }
  ],
