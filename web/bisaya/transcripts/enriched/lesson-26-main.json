{
  "id": "lesson-26-main",
  "title": "Lección 26",
  "summary_es": "Aprender a preguntar por el menú del día.",
  "topics": [
    "comida",
    "mercado",
    "preguntar",
    "gustos"
  ],
  "dialogue": {
    "tl": [
      "Maayong buntag! Unsa ang sud-an karon?",
      "Adobo, sinugba, ug pancit.",
      "Lami! Gusto ko og sinugba.",
      "Gusto ka og ilimnon?",
      "Oo, gusto ko og tubig."
    ],
    "es": [
      "¡Buenos días! ¿Cuál es el plato de hoy?",
      "Adobo, asado y fideos.",
      "¡Delicioso! Quiero asado.",
      "¿Quieres una bebida?",
      "Sí, quiero agua."
    ]
  },
