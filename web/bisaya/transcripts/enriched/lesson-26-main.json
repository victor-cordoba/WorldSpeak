    {
      "start": 376.993,
      "end": 382.06,
      "kind": "instruction",
      "text": "Conversación guiada. Yo te digo la situación, tú hablas, y luego lo oyes.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 382.66,
      "end": 386.161,
      "kind": "prompt",
      "text": "Estás en un karinderya y quieres saber qué platos hay hoy.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 390.161,
      "end": 391.885,
      "kind": "phrase",
      "text": "Unsa ang sud-an karon?",
