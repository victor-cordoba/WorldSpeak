    },
    {
      "start": 372.908,
      "end": 378.78,
      "kind": "instruction",
      "text": "Conversación guiada. Yo te digo la situación, tú hablas, y luego lo oyes.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 379.38,
      "end": 383.181,
      "kind": "prompt",
      "text": "Estás en un karinderya y quieres saber qué platos hay hoy.",
