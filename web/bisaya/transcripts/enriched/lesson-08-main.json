      "note_es": "",
      "language": "en"
    },
    {
      "start": 652.152,
      "end": 653.441,
      "kind": "phrase",
      "text": "Unsa imong ngalan?",
      "translation_es": "¿Cómo te llamas?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 655.941,
      "end": 657.247,
      "kind": "prompt",
      "text": "¿Cómo se dice «Gracias»?",
