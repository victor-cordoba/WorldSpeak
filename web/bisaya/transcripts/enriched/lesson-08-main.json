      "note_es": "",
      "language": "tl"
    },
    {
      "start": 496.345,
      "end": 505.773,
      "kind": "instruction",
      "text": "Ahora, a entender. Vas a oír respuestas típicas, con otra voz. Escucha, y piensa qué significan. Luego te lo digo.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 506.373,
      "end": 508.293,
      "kind": "phrase",
      "text": "Walay sapayan",
