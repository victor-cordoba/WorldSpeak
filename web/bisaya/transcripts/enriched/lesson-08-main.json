    {
      "start": 115.788,
      "end": 127.83,
      "kind": "explanation",
      "text": "Un apunte: en Bisaya no existe po. El respeto va con Kuya, Ate, Manong, Manang, Sir o Ma'am, y con el tono. Y kita es nosotros contigo: si dicen kita o ta, te incluyen.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 128.43,
      "end": 132.293,
      "kind": "instruction",
      "text": "«Nosotros (sin ti) y nosotros (contigo)». Escucha y repite.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
