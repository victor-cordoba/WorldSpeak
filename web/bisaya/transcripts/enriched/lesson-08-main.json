      "note_es": "",
      "language": "en"
    },
    {
      "start": 661.247,
      "end": 662.135,
      "kind": "phrase",
      "text": "Salamat.",
      "translation_es": "Gracias.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 664.635,
      "end": 666.359,
      "kind": "prompt",
      "text": "Di: «Dame agua».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 670.359,
      "end": 671.717,
      "kind": "phrase",
      "text": "Pahatag og tubig.",
      "translation_es": "Dame agua.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 674.217,
      "end": 675.524,
      "kind": "prompt",
      "text": "¿Cómo se dice «¡Para»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 679.524,
      "end": 680.098,
      "kind": "phrase",
      "text": "Para!",
      "translation_es": "¡Para!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 682.598,
      "end": 685.028,
      "kind": "instruction",
      "text": "Repaso final. Todo lo de hoy.",
