      "language": "en"
    },
    {
      "start": 642.91,
      "end": 643.954,
      "kind": "phrase",
      "text": "Ako si Maria.",
      "translation_es": "Yo soy María.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 646.454,
