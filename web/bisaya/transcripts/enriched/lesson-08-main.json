    },
    {
      "start": 4.176,
      "end": 11.503,
      "kind": "instruction",
      "text": "En el mercado de Carbon, un voluntario español intenta hablar con un vendedor local. Escucha la conversación.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 12.303,
      "end": 15.103,
      "kind": "dialogue",
      "text": "Maayong buntag! Unsa imong ngalan?",
      "translation_es": "¡Buenos días! ¿Cómo te llamas?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 15.903,
      "end": 19.743,
      "kind": "dialogue",
      "text": "Ako si Maria. Unsa sa Binisaya ang 'agua'?",
      "translation_es": "Yo soy María. ¿Cómo se dice 'agua' en Bisaya?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 20.543,
      "end": 23.931,
      "kind": "dialogue",
      "text": "Tubig. Gusto ka og tubig?",
      "translation_es": "Agua. ¿Quieres agua?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 24.731,
      "end": 27.931,
      "kind": "dialogue",
      "text": "Oo, gusto ko og tubig. Tagpila ni?",
      "translation_es": "Sí, quiero agua. ¿Cuánto cuesta esto?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 28.731,
      "end": 31.291,
      "kind": "dialogue",
      "text": "Bente pesos. Walay sapayan.",
      "translation_es": "Veinte pesos. De nada.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 32.091,
      "end": 36.331,
      "kind": "dialogue",
      "text": "Salamat! Pasaylo-a ko, wala ko kasabot usahay.",
      "translation_es": "¡Gracias! Perdóname, a veces no entiendo.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 37.131,
      "end": 39.211,
      "kind": "dialogue",
      "text": "Walay sapayan. Amping!",
      "translation_es": "De nada. ¡Cuídate!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 40.011,
      "end": 47.906,
      "kind": "explanation",
      "text": "Aprenderás a preguntar y entender en una conversación básica. Al terminar, esta conversación la vas a hacer tú.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 48.706,
