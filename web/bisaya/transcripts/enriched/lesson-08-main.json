      "note_es": "",
      "language": "en"
    },
    {
      "start": 488.705,
      "end": 490.145,
      "kind": "phrase",
      "text": "Kami ug kita",
      "translation_es": "Nosotros (sin ti) y nosotros (contigo)",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 492.645,
      "end": 493.845,
      "kind": "phrase",
      "text": "Kamo ug sila",
