    },
    {
      "start": 3.629,
      "end": 10.177,
      "kind": "instruction",
      "text": "En un barrio de Cebú, un voluntario habla con un niño en la calle. Escucha la conversación.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 10.977,
      "end": 12.097,
      "kind": "dialogue",
      "text": "Kumusta ka, dong?",
