      "note_es": "",
      "language": "tl"
    },
    {
      "start": 12.897,
      "end": 14.623,
      "kind": "dialogue",
      "text": "Maayo ra.",
      "translation_es": "Bien.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 15.423,
      "end": 17.023,
      "kind": "dialogue",
      "text": "Gihigugma ka sa imong mama?",
