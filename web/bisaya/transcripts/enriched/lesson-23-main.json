    },
    {
      "start": 632.988,
      "end": 635.817,
      "kind": "dialogue",
      "text": "Maayong buntag, mga bata!",
      "translation_es": "¡Buenos días, niños!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 636.617,
      "end": 638.628,
      "kind": "dialogue",
      "text": "Maayong buntag, kuya!",
      "translation_es": "¡Buenos días, hermano mayor!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 639.428,
      "end": 641.074,
      "kind": "dialogue",
      "text": "Unsa imong pangandoy?",
      "translation_es": "¿Cuál es tu sueño?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 641.874,
      "end": 643.569,
      "kind": "dialogue",
      "text": "Gusto ko mahimong doktor!",
      "translation_es": "¡Quiero ser doctor!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 644.369,
      "end": 645.462,
      "kind": "dialogue",
      "text": "Kaya nimo na!",
      "translation_es": "¡Tú puedes hacerlo!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 646.262,
      "end": 648.557,
      "kind": "dialogue",
      "text": "Ako gusto mahimong maestra.",
      "translation_es": "Yo quiero ser maestra.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 649.357,
      "end": 651.829,
      "kind": "dialogue",
      "text": "Maayo kaayo! Unsa pa?",
