      "note_es": "",
      "language": "en"
    },
    {
      "start": 532.525,
      "end": 533.565,
      "kind": "phrase",
      "text": "Unsa imong ngalan?",
      "translation_es": "¿Cómo te llamas?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 536.065,
      "end": 537.604,
      "kind": "prompt",
      "text": "¿Cómo se dice «Gracias»?",
