    },
    {
      "start": 623.966,
      "end": 625.726,
      "kind": "dialogue",
      "text": "Maayong buntag, mga bata!",
      "translation_es": "¡Buenos días, niños!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 626.526,
      "end": 628.061,
      "kind": "dialogue",
      "text": "Maayong buntag, kuya!",
      "translation_es": "¡Buenos días, hermano mayor!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 628.861,
      "end": 630.048,
      "kind": "dialogue",
      "text": "Unsa imong pangandoy?",
      "translation_es": "¿Cuál es tu sueño?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 630.848,
      "end": 632.768,
      "kind": "dialogue",
      "text": "Gusto ko mahimong doktor!",
      "translation_es": "¡Quiero ser doctor!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 633.568,
      "end": 634.627,
      "kind": "dialogue",
      "text": "Kaya nimo na!",
      "translation_es": "¡Tú puedes hacerlo!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 635.427,
      "end": 637.427,
      "kind": "dialogue",
      "text": "Ako gusto mahimong maestra.",
      "translation_es": "Yo quiero ser maestra.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 638.227,
      "end": 640.547,
      "kind": "dialogue",
      "text": "Maayo kaayo! Unsa pa?",
      "translation_es": "¡Muy bien! ¿Qué más?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 641.347,
      "end": 643.715,
      "kind": "instruction",
      "text": "Hasta la próxima lección. Amping!",
