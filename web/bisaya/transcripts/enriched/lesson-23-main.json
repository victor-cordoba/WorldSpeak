      "note_es": "",
      "language": "tl"
    },
    {
      "start": 423.729,
      "end": 429.601,
      "kind": "instruction",
      "text": "Conversación guiada. Yo te digo la situación, tú hablas, y luego lo oyes.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 430.201,
      "end": 433.221,
      "kind": "prompt",
      "text": "Pregunta a un niño sobre sus sueños futuros.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 437.221,
      "end": 438.408,
      "kind": "phrase",
      "text": "Unsa imong pangandoy?",
      "translation_es": "¿Cuál es tu sueño?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 440.908,
      "end": 443.741,
      "kind": "instruction",
      "text": "Repaso final. Todo lo de hoy.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 444.241,
      "end": 446.145,
      "kind": "prompt",
      "text": "Di: «¿Cuál es tu sueño?».",
