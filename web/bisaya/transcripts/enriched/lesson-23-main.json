    },
    {
      "start": 614.738,
      "end": 616.749,
      "kind": "dialogue",
      "text": "Maayong buntag, kuya!",
      "translation_es": "¡Buenos días, hermano mayor!",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 617.549,
      "end": 619.195,
      "kind": "dialogue",
      "text": "Unsa imong pangandoy?",
