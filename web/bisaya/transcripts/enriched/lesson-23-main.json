      "language": "tl"
    },
    {
      "start": 627.478,
      "end": 629.95,
      "kind": "dialogue",
      "text": "Maayo kaayo! Unsa pa?",
      "translation_es": "¡Muy bien! ¿Qué más?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 630.75,
