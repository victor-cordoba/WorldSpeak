      "kind": "phrase",
      "text": "Ako si Maria.",
      "translation_es": "Yo soy María.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 526.528,
      "end": 528.525,
      "kind": "prompt",
      "text": "Di: «¿Cómo te llamas?».",
