    },
    {
      "start": 415.453,
      "end": 420.521,
      "kind": "instruction",
      "text": "Conversación guiada. Yo te digo la situación, tú hablas, y luego lo oyes.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 421.121,
      "end": 423.55,
      "kind": "prompt",
