      "note_es": "",
      "language": "tl"
    },
    {
      "start": 378.158,
      "end": 379.804,
      "kind": "phrase",
      "text": "Unsa imong pangandoy?",
      "translation_es": "¿Cuál es tu sueño?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 382.304,
      "end": 389.983,
      "kind": "instruction",
      "text": "Ahora, a entender. Vas a oír respuestas típicas, con otra voz. Escucha, y piensa qué significan. Luego te lo digo.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 390.583,
      "end": 391.68,
      "kind": "phrase",
