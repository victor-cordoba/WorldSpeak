      "note_es": "",
      "language": "tl"
    },
    {
      "start": 502.415,
      "end": 504.243,
      "kind": "prompt",
      "text": "Di: «Yo soy María».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 508.243,
      "end": 509.287,
      "kind": "phrase",
      "text": "Ako si Maria.",
