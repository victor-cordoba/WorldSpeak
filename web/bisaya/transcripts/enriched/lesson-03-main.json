      "note_es": "",
      "language": "tl"
    },
    {
      "start": 423.988,
      "end": 429.86,
      "kind": "instruction",
      "text": "Conversación guiada. Yo te digo la situación, tú hablas, y luego lo oyes.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 430.46,
      "end": 433.665,
      "kind": "prompt",
      "text": "Estás en el mercado y quieres saber si la persona es Juan.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 437.665,
      "end": 438.385,
      "kind": "phrase",
      "text": "Ikaw si Juan?",
