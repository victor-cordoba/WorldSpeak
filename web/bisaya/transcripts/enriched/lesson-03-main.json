      "note_es": "",
      "language": "tl"
    },
    {
      "start": 411.038,
      "end": 416.106,
      "kind": "instruction",
      "text": "Conversación guiada. Yo te digo la situación, tú hablas, y luego lo oyes.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 416.706,
      "end": 420.148,
      "kind": "prompt",
      "text": "Estás en el mercado y quieres saber si la persona es Juan.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 424.148,
      "end": 425.372,
      "kind": "phrase",
      "text": "Ikaw si Juan?",
