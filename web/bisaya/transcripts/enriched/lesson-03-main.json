      "note_es": "",
      "language": "tl"
    },
    {
      "start": 641.024,
      "end": 644.095,
      "kind": "dialogue",
      "text": "Oo, ako si Juan. Asa ang balay nimo?",
      "translation_es": "Sí, yo soy Juan. ¿Dónde está tu casa?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 644.895,
      "end": 648.755,
      "kind": "dialogue",
      "text": "Naa sa Cebu. Ikaw, asa ka padulong?",
      "translation_es": "Está en Cebú. ¿Y tú, a dónde vas?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 649.555,
      "end": 651.139,
      "kind": "dialogue",
      "text": "Adto ko sa merkado.",
