      "note_es": "",
      "language": "en"
    },
    {
      "start": 517.72,
      "end": 519.009,
      "kind": "phrase",
      "text": "Unsa imong ngalan?",
      "translation_es": "¿Cómo te llamas?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 521.509,
      "end": 523.52,
      "kind": "prompt",
      "text": "Di: «¿Sabes hablar Bisaya?».",
