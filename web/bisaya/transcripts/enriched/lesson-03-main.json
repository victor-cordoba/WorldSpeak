      "note_es": "",
      "language": "tl"
    },
    {
      "start": 413.184,
      "end": 418.252,
      "kind": "instruction",
      "text": "Conversación guiada. Yo te digo la situación, tú hablas, y luego lo oyes.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 418.852,
      "end": 422.294,
      "kind": "prompt",
      "text": "Estás en el mercado y quieres saber si la persona es Juan.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 426.294,
      "end": 427.518,
      "kind": "phrase",
      "text": "Ikaw si Juan?",
