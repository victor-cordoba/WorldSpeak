      "note_es": "",
      "language": "en"
    },
    {
      "start": 483.223,
      "end": 484.451,
      "kind": "phrase",
      "text": "Maayo ra.",
      "translation_es": "Bien.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 486.951,
      "end": 489.146,
      "kind": "prompt",
      "text": "¿Cómo se dice «¿Dónde está tu casa?»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 493.146,
      "end": 494.665,
      "kind": "phrase",
      "text": "Asa ang balay nimo?",
      "translation_es": "¿Dónde está tu casa?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 497.165,
      "end": 498.706,
      "kind": "prompt",
      "text": "Di: «Está en Cebú».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 502.706,
      "end": 504.064,
      "kind": "phrase",
      "text": "Naa sa Cebu.",
      "translation_es": "Está en Cebú.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 506.564,
      "end": 508.288,
      "kind": "prompt",
      "text": "¿Cómo se dice «¿Qué hora es?»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 512.288,
      "end": 513.647,
      "kind": "phrase",
      "text": "Unsa ang oras?",
      "translation_es": "¿Qué hora es?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 516.147,
      "end": 517.74,
      "kind": "prompt",
      "text": "Di: «Sigue recto».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 521.74,
      "end": 522.968,
      "kind": "phrase",
      "text": "Diretso lang.",
      "translation_es": "Sigue recto.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 525.468,
      "end": 527.233,
      "kind": "prompt",
      "text": "¿Cómo se dice «Yo soy María»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 531.233,
      "end": 532.276,
      "kind": "phrase",
      "text": "Ako si Maria.",
      "translation_es": "Yo soy María.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 534.776,
      "end": 537.205,
      "kind": "instruction",
      "text": "Repaso final. Todo lo de hoy.",
