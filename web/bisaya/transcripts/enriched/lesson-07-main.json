      "note_es": "",
      "language": "en"
    },
    {
      "start": 409.654,
      "end": 410.281,
      "kind": "phrase",
      "text": "Pila mo?",
      "translation_es": "¿Cuántos sois?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 412.781,
      "end": 415.211,
      "kind": "instruction",
      "text": "Repaso final. Todo lo de hoy.",
