      "start": 0.8,
      "end": 4.177,
      "kind": "instruction",
      "text": "Lección 7. ¿Cuándo? ¿Por qué? ¿Cuántos?.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 4.777,
      "end": 10.759,
      "kind": "instruction",
      "text": "En el mercado de Carbon, un voluntario habla con un niño local. Escucha la conversación.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 11.559,
      "end": 12.199,
      "kind": "dialogue",
      "text": "Kumusta ka?",
      "translation_es": "¿Cómo estás?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 12.999,
      "end": 14.679,
      "kind": "dialogue",
      "text": "Maayo ra. Ikaw?",
      "translation_es": "Bien. ¿Y tú?",
      "note_es": "",
      "language": "tl"
    },
