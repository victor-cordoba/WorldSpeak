    },
    {
      "start": 485.355,
      "end": 486.032,
      "kind": "instruction",
      "text": "",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 486.532,
      "end": 488.707,
      "kind": "prompt",
      "text": "¿Cómo se dice «¿Cómo estás?»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 492.707,
      "end": 493.347,
      "kind": "phrase",
      "text": "Kumusta ka?",
      "translation_es": "¿Cómo estás?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 495.847,
      "end": 497.202,
      "kind": "prompt",
      "text": "Di: «Bien».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 501.202,
      "end": 501.922,
      "kind": "phrase",
      "text": "Maayo ra.",
      "translation_es": "Bien.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 504.422,
      "end": 507.038,
      "kind": "prompt",
      "text": "¿Cómo se dice «¿Dónde está tu casa?»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 511.038,
      "end": 512.036,
      "kind": "phrase",
      "text": "Asa ang balay nimo?",
      "translation_es": "¿Dónde está tu casa?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 514.536,
      "end": 516.355,
      "kind": "prompt",
      "text": "Di: «Está en Cebú».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 520.355,
      "end": 521.315,
      "kind": "phrase",
      "text": "Naa sa Cebu.",
      "translation_es": "Está en Cebú.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 523.815,
      "end": 526.005,
      "kind": "prompt",
      "text": "¿Cómo se dice «¿Qué hora es?»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 530.005,
      "end": 531.117,
      "kind": "phrase",
      "text": "Unsa ang oras?",
      "translation_es": "¿Qué hora es?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 533.617,
      "end": 535.475,
      "kind": "prompt",
      "text": "Di: «Sigue recto».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 539.475,
      "end": 540.115,
      "kind": "phrase",
      "text": "Diretso lang.",
      "translation_es": "Sigue recto.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 542.615,
      "end": 544.764,
      "kind": "prompt",
      "text": "¿Cómo se dice «Yo soy María»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 548.764,
      "end": 549.783,
      "kind": "phrase",
      "text": "Ako si Maria.",
      "translation_es": "Yo soy María.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 552.283,
      "end": 555.116,
      "kind": "instruction",
      "text": "Repaso final. Todo lo de hoy.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 555.616,
      "end": 557.102,
      "kind": "prompt",
      "text": "Di: «¿Cuándo?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 561.102,
      "end": 561.742,
      "kind": "phrase",
      "text": "Kanus-a?",
      "translation_es": "¿Cuándo?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 564.242,
      "end": 565.821,
      "kind": "prompt",
      "text": "Otra vez. «¿Por qué?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 569.821,
      "end": 570.381,
      "kind": "phrase",
      "text": "Ngano?",
      "translation_es": "¿Por qué?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 572.881,
      "end": 574.414,
      "kind": "prompt",
      "text": "Y ahora, «¿Cuántos?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 578.414,
      "end": 578.974,
      "kind": "phrase",
      "text": "Pila?",
      "translation_es": "¿Cuántos?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 581.474,
      "end": 585.892,
      "kind": "prompt",
      "text": "¿Cómo se dice «Ahora, mañana, ayer, luego»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 589.892,
      "end": 592.772,
      "kind": "phrase",
      "text": "Karon, ugma, gahapon, unya",
      "translation_es": "Ahora, mañana, ayer, luego",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 596.272,
      "end": 598.091,
      "kind": "prompt",
      "text": "Di: «¿Cuántos sois?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 602.091,
      "end": 602.811,
      "kind": "phrase",
      "text": "Pila mo?",
      "translation_es": "¿Cuántos sois?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 605.311,
      "end": 610.745,
      "kind": "instruction",
      "text": "Escucha la conversación completa una vez más. Ahora la entiendes entera.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 611.345,
      "end": 611.985,
      "kind": "dialogue",
      "text": "Kumusta ka?",
      "translation_es": "¿Cómo estás?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 612.785,
      "end": 614.465,
      "kind": "dialogue",
      "text": "Maayo ra. Ikaw?",
      "translation_es": "Bien. ¿Y tú?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 615.265,
      "end": 618.305,
      "kind": "dialogue",
      "text": "Maayo man. Kanus-a ka moadto sa eskwela?",
      "translation_es": "Estoy bien. ¿Cuándo vas a la escuela?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 619.105,
      "end": 620.998,
      "kind": "dialogue",
      "text": "Ugma pa. Ngano?",
      "translation_es": "Mañana. ¿Por qué?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 621.798,
      "end": 624.038,
      "kind": "dialogue",
      "text": "Kay gusto ko makakita sa imong klase.",
      "translation_es": "Porque quiero ver tu clase.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 624.838,
      "end": 626.297,
      "kind": "dialogue",
      "text": "Pila mo sa inyong balay?",
      "translation_es": "¿Cuántos sois en tu casa?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 627.097,
      "end": 628.697,
      "kind": "dialogue",
      "text": "Upat mi. Ikaw?",
      "translation_es": "Somos cuatro. ¿Y tú?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 629.497,
      "end": 633.115,
      "kind": "dialogue",
      "text": "Tulo mi. Kay gigutom ko, adto na ko.",
      "translation_es": "Somos tres. Porque tengo hambre, me voy.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 633.915,
      "end": 636.283,
      "kind": "instruction",
      "text": "Hasta la próxima lección. Amping!",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    }
