      "start": 0.8,
      "end": 4.666,
      "kind": "instruction",
      "text": "Lección 7. ¿Cuándo? ¿Por qué? ¿Cuántos?.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 5.266,
      "end": 10.543,
      "kind": "instruction",
      "text": "En el mercado de Carbon, un voluntario habla con un niño local. Escucha la conversación.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 11.343,
      "end": 12.388,
      "kind": "dialogue",
      "text": "Kumusta ka?",
      "translation_es": "¿Cómo estás?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 13.188,
      "end": 15.199,
      "kind": "dialogue",
      "text": "Maayo ra. Ikaw?",
      "translation_es": "Bien. ¿Y tú?",
      "note_es": "",
      "language": "tl"
