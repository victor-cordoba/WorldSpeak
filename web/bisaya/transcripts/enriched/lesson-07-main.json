      "note_es": "",
      "language": "en"
    },
    {
      "start": 495.389,
      "end": 496.747,
      "kind": "phrase",
      "text": "Unsa ang oras?",
      "translation_es": "¿Qué hora es?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 499.247,
      "end": 501.023,
      "kind": "prompt",
      "text": "Di: «¿Dónde está tu casa?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 505.023,
      "end": 506.542,
      "kind": "phrase",
      "text": "Asa ang balay nimo?",
      "translation_es": "¿Dónde está tu casa?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 509.042,
      "end": 510.975,
      "kind": "prompt",
      "text": "¿Cómo se dice «Está en Cebú»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 514.975,
      "end": 516.333,
      "kind": "phrase",
      "text": "Naa sa Cebu.",
      "translation_es": "Está en Cebú.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 518.833,
      "end": 520.479,
      "kind": "prompt",
      "text": "Di: «¿Cómo estás?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 524.479,
      "end": 525.524,
      "kind": "phrase",
      "text": "Kumusta ka?",
      "translation_es": "¿Cómo estás?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 528.024,
      "end": 529.252,
      "kind": "prompt",
      "text": "¿Cómo se dice «Bien»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 533.252,
      "end": 534.48,
      "kind": "phrase",
      "text": "Maayo ra.",
      "translation_es": "Bien.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 536.98,
      "end": 538.573,
      "kind": "prompt",
      "text": "Di: «Sigue recto».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 542.573,
      "end": 543.801,
      "kind": "phrase",
      "text": "Diretso lang.",
      "translation_es": "Sigue recto.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 546.301,
      "end": 548.066,
      "kind": "prompt",
      "text": "¿Cómo se dice «Yo soy María»?",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 552.066,
      "end": 553.109,
      "kind": "phrase",
      "text": "Ako si Maria.",
      "translation_es": "Yo soy María.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 555.609,
      "end": 558.038,
      "kind": "instruction",
      "text": "Repaso final. Todo lo de hoy.",
