    },
    {
      "start": 590.298,
      "end": 591.343,
      "kind": "dialogue",
      "text": "Kumusta ka?",
      "translation_es": "¿Cómo estás?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 592.143,
      "end": 594.154,
      "kind": "dialogue",
      "text": "Maayo ra. Ikaw?",
      "translation_es": "Bien. ¿Y tú?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 594.954,
      "end": 598.455,
      "kind": "dialogue",
      "text": "Maayo man. Kanus-a ka moadto sa eskwela?",
      "translation_es": "Estoy bien. ¿Cuándo vas a la escuela?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 599.255,
      "end": 600.662,
      "kind": "dialogue",
      "text": "Ugma pa. Ngano?",
      "translation_es": "Mañana. ¿Por qué?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 601.462,
      "end": 603.813,
      "kind": "dialogue",
      "text": "Kay gusto ko makakita sa imong klase.",
      "translation_es": "Porque quiero ver tu clase.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 604.613,
      "end": 606.151,
      "kind": "dialogue",
      "text": "Pila mo sa inyong balay?",
      "translation_es": "¿Cuántos sois en tu casa?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 606.951,
      "end": 608.543,
      "kind": "dialogue",
      "text": "Upat mi. Ikaw?",
      "translation_es": "Somos cuatro. ¿Y tú?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 609.343,
      "end": 612.53,
      "kind": "dialogue",
      "text": "Tulo mi. Kay gigutom ko, adto na ko.",
      "translation_es": "Somos tres. Porque tengo hambre, me voy.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 613.33,
      "end": 615.704,
      "kind": "instruction",
      "text": "Hasta la próxima lección. Amping!",
