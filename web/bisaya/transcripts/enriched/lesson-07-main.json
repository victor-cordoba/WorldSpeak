      "translation_es": "Ahora, mañana, ayer, luego",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 472.225,
      "end": 474.044,
      "kind": "prompt",
      "text": "Di: «¿Cuántos sois?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 478.044,
      "end": 478.764,
      "kind": "phrase",
      "text": "Pila mo?",
      "translation_es": "¿Cuántos sois?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 481.264,
      "end": 484.855,
      "kind": "instruction",
      "text": "Como hay tiempo, repasemos de nuevo lo anterior.",
