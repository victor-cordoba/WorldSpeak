      "kind": "phrase",
      "text": "Pila mo?",
      "translation_es": "¿Cuántos sois?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 585.317,
      "end": 589.698,
      "kind": "instruction",
      "text": "Escucha la conversación completa una vez más. Ahora la entiendes entera.",
      "translation_es": "",
      "note_es": "",
