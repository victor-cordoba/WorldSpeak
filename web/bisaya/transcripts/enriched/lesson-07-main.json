      "note_es": "",
      "language": "en"
    },
    {
      "start": 415.711,
      "end": 417.069,
      "kind": "prompt",
      "text": "Di: «¿Cuándo?».",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
