    "tl": [
      "Kumusta ka?",
      "Maayo ra. Ikaw?",
      "Maayo man. Kanus-a ka moadto sa eskwela?",
      "Ugma pa. Ngano?",
      "Kay gusto ko makakita sa imong klase.",
      "Pila mo sa inyong balay?",
      "Upat mi. Ikaw?",
      "Tulo mi. Kay gigutom ko, adto na ko."
    ],
    "es": [
      "¿Cómo estás?",
      "Bien. ¿Y tú?",
      "Estoy bien. ¿Cuándo vas a la escuela?",
      "Mañana. ¿Por qué?",
      "Porque quiero ver tu clase.",
      "¿Cuántos sois en tu casa?",
      "Somos cuatro. ¿Y tú?",
      "Somos tres. Porque tengo hambre, me voy."
    ]
  },
  "segments": [
