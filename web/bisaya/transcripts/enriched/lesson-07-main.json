      "kind": "phrase",
      "text": "Pila mo?",
      "translation_es": "¿Cuántos sois?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 606.15,
      "end": 610.531,
      "kind": "instruction",
      "text": "Escucha la conversación completa una vez más. Ahora la entiendes entera.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 611.131,
      "end": 612.176,
      "kind": "dialogue",
      "text": "Kumusta ka?",
      "translation_es": "¿Cómo estás?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 612.976,
      "end": 614.987,
      "kind": "dialogue",
      "text": "Maayo ra. Ikaw?",
      "translation_es": "Bien. ¿Y tú?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 615.787,
      "end": 619.288,
      "kind": "dialogue",
      "text": "Maayo man. Kanus-a ka moadto sa eskwela?",
      "translation_es": "Estoy bien. ¿Cuándo vas a la escuela?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 620.088,
      "end": 621.495,
      "kind": "dialogue",
      "text": "Ugma pa. Ngano?",
      "translation_es": "Mañana. ¿Por qué?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 622.295,
      "end": 624.646,
      "kind": "dialogue",
      "text": "Kay gusto ko makakita sa imong klase.",
      "translation_es": "Porque quiero ver tu clase.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 625.446,
      "end": 626.984,
      "kind": "dialogue",
      "text": "Pila mo sa inyong balay?",
      "translation_es": "¿Cuántos sois en tu casa?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 627.784,
      "end": 629.376,
      "kind": "dialogue",
      "text": "Upat mi. Ikaw?",
      "translation_es": "Somos cuatro. ¿Y tú?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 630.176,
      "end": 633.363,
      "kind": "dialogue",
      "text": "Tulo mi. Kay gigutom ko, adto na ko.",
      "translation_es": "Somos tres. Porque tengo hambre, me voy.",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 634.163,
      "end": 636.537,
      "kind": "instruction",
      "text": "Hasta la próxima lección. Amping!",
