    },
    {
      "start": 657.374,
      "end": 660.039,
      "kind": "dialogue",
      "text": "Nagbaligya ko og prutas. Ikaw?",
      "translation_es": "Vendo frutas. ¿Y tú?",
      "note_es": "",
      "language": "tl"
    },
    {
      "start": 660.839,
      "end": 663.086,
      "kind": "dialogue",
      "text": "Drayber ko. Naa kay negosyo?",
      "translation_es": "Soy conductor. ¿Tienes un negocio?",
