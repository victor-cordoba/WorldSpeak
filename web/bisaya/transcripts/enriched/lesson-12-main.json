      "note_es": "",
      "language": "tl"
    },
    {
      "start": 399.306,
      "end": 406.985,
      "kind": "instruction",
      "text": "Ahora, a entender. Vas a oír respuestas típicas, con otra voz. Escucha, y piensa qué significan. Luego te lo digo.",
      "translation_es": "",
      "note_es": "",
      "language": "en"
    },
    {
      "start": 407.585,
      "end": 408.813,
      "kind": "phrase",
