      "start": 744.477,
      "end": 747.246,
      "text": "Como hay tiempo, repasemos de nuevo lo anterior."
    },
    {
      "start": 747.746,
      "end": 749.051,
      "text": "."
    },
    {
      "start": 749.551,
      "end": 751.797,
      "text": "¿Cómo se dice «Estoy en el hospital»?"
    },
    {
      "start": 755.797,
      "end": 757.573,
      "text": "Naa ko sa hospital."
    },
    {
      "start": 760.073,
      "end": 762.006,
      "text": "Di: «Me duele la cabeza»."
    },
    {
      "start": 766.006,
      "end": 767.364,
      "text": "Sakit akong ulo."
    },
    {
      "start": 769.864,
      "end": 772.058,
      "text": "¿Cómo se dice «¿Cuánto cuesta esto?»?"
    },
    {
      "start": 776.058,
      "end": 776.995,
      "text": "Tagpila ni?"
    },
    {
      "start": 779.495,
      "end": 780.854,
      "text": "Di: «Barato»."
    },
    {
      "start": 784.854,
      "end": 785.846,
      "text": "Barato."
    },
    {
      "start": 788.346,
      "end": 789.861,
      "text": "¿Cómo se dice «¿Quieres?»?"
    },
    {
      "start": 793.861,
      "end": 794.896,
      "text": "Gusto ka?"
    },
    {
      "start": 797.396,
      "end": 798.911,
      "text": "Di: «¿A dónde vas?»."
    },
    {
      "start": 802.911,
      "end": 804.322,
      "text": "Asa ka padulong?"
    },
    {
      "start": 806.822,
      "end": 808.598,
      "text": "¿Cómo se dice «¿Cómo estás?»?"
    },
    {
      "start": 812.598,
      "end": 813.643,
      "text": "Kumusta ka?"
    },
    {
      "start": 816.143,
      "end": 817.606,
      "text": "Di: «¿Dónde trabajas?»."
    },
    {
      "start": 821.606,
      "end": 822.964,
      "text": "Asa ka nagtrabaho?"
    },
    {
      "start": 825.464,
      "end": 826.74,
      "text": "¿Cómo se dice «Misa»?"
    },
    {
      "start": 830.74,
      "end": 831.443,
      "text": "Misa"
    },
    {
      "start": 833.943,
      "end": 836.372,
      "text": "Repaso final. Todo lo de hoy."
    },
    {
      "start": 836.872,
      "end": 838.466,
      "text": "Di: «¡Pero delicioso»."
    },
    {
      "start": 842.466,
      "end": 843.423,
      "text": "Pero lami!"
    },
    {
      "start": 845.923,
      "end": 848.065,
      "text": "Otra vez. «Porque voy al mercado»."
    },
    {
      "start": 852.065,
      "end": 853.946,
      "text": "Kay adto ko sa merkado."
    },
    {
      "start": 857.446,
      "end": 859.374,
      "text": "Y ahora, «Yo también quiero»."
    },
    {
      "start": 863.374,
      "end": 864.652,
      "text": "Gusto pud ko."
    },
    {
      "start": 867.152,
      "end": 869.111,
      "text": "¿Cómo se dice «Por eso tengo prisa»?"
    },
    {
      "start": 873.111,
      "end": 874.571,
      "text": "Mao nga nagdali ko."
    },
    {
      "start": 877.071,
      "end": 878.952,
      "text": "Di: «Si quieres, vamos»."
    },
    {
      "start": 882.952,
      "end": 885.094,
      "text": "Kung gusto ka, adto ta."
    },
    {
      "start": 888.594,
      "end": 891.128,
      "text": "Otra vez. «Nos vemos mañana entonces»."
    },
    {
      "start": 895.128,
      "end": 897.009,
      "text": "Dayon ugma ta magkita."
    },
    {
      "start": 899.509,
      "end": 901.207,
      "text": "Y ahora, «Aquí nomás»."
    },
    {
      "start": 905.207,
      "end": 906.435,
      "text": "Diri ra lang ko."
    },
    {
      "start": 908.935,
      "end": 911.077,
      "text": "¿Cómo se dice «Quizás vaya a Cebú»?"
    },
    {
      "start": 915.077,
      "end": 917.036,
      "text": "Siguro moadto ko sa Cebu."
    },
    {
      "start": 920.536,
      "end": 924.916,
      "text": "Escucha la conversación completa una vez más. Ahora la entiendes entera."
    },
    {
      "start": 925.516,
      "end": 928.129,
      "text": "Kumusta ka? Asa ka padulong?"
    },
    {
      "start": 928.929,
      "end": 932.376,
      "text": "Adto ko sa merkado kay gusto ko og prutas."
    },
    {
      "start": 933.176,
      "end": 936.256,
      "text": "Lami ang mga prutas diri, pero mahal pud."
    },
    {
      "start": 937.056,
      "end": 939.524,
      "text": "Mao nga magtan-aw ko ug barato."
    },
    {
      "start": 940.324,
      "end": 942.622,
      "text": "Kung gusto ka, tabangan tika."
    },
    {
      "start": 943.422,
      "end": 946.217,
      "text": "Salamat! Dayon, adto ta."
    },
    {
      "start": 947.017,
      "end": 949.391,
      "text": "Hasta la próxima lección. Amping!"
    }
