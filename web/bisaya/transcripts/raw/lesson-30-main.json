    {
      "start": 450.271,
      "end": 451.551,
      "text": "Nagkaon ka?"
    },
    {
      "start": 454.051,
      "end": 456.297,
      "text": "Pregunta a un niño si está estudiando."
    },
    {
      "start": 460.297,
      "end": 461.76,
      "text": "Nag-eskwela ka?"
    },
    {
      "start": 464.26,
