    },
    {
      "start": 318.434,
      "end": 320.199,
      "text": "Un momento. Volvamos atrás."
    },
    {
      "start": 320.599,
      "end": 322.921,
      "text": "Y ahora, «Nos vemos mañana»."
    },
    {
      "start": 326.921,
