    {
      "start": 391.806,
      "end": 396.874,
      "text": "Conversación guiada. Yo te digo la situación, tú hablas, y luego lo oyes."
    },
    {
      "start": 397.474,
      "end": 400.137,
      "text": "Pregunta a alguien si sabe hablar Bisaya."
