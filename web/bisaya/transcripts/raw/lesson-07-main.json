      "text": "Pregunta por qué alguien tiene hambre."
    },
    {
      "start": 415.261,
      "end": 415.821,
      "text": "Ngano?"
    },
    {
      "start": 418.321,
      "end": 421.017,
      "text": "Pregunta cuántos sois en su casa."
    },
    {
      "start": 425.017,
      "end": 425.737,
      "text": "Pila mo?"
    },
    {
      "start": 428.237,
