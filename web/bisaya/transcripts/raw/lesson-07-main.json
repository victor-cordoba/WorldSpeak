      "end": 55.945,
      "text": "Di: «Bien»."
    },
    {
      "start": 59.945,
      "end": 60.665,
      "text": "Maayo ra."
    },
    {
      "start": 63.165,
      "end": 65.781,
      "text": "¿Cómo se dice «¿Dónde está tu casa?»?"
    },
    {
      "start": 69.781,
      "end": 70.779,
      "text": "Asa ang balay nimo?"
    },
    {
