      "text": "Naa sa Cebu."
    },
    {
      "start": 82.557,
      "end": 84.748,
      "text": "¿Cómo se dice «¿Qué hora es?»?"
    },
    {
      "start": 88.748,
      "end": 89.86,
      "text": "Unsa ang oras?"
    },
    {
      "start": 92.36,
      "end": 94.217,
      "text": "Di: «Sigue recto»."
    },
    {
      "start": 98.217,
      "end": 98.857,
      "text": "Diretso lang."
    },
    {
      "start": 101.357,
