      "text": "Nalipay ko."
    },
    {
      "start": 405.128,
      "end": 411.0,
      "text": "Conversación guiada. Yo te digo la situación, tú hablas, y luego lo oyes."
    },
    {
      "start": 411.6,
      "end": 413.926,
      "text": "Pregúntale a un amigo si está feliz."
    },
    {
      "start": 417.926,
      "end": 418.806,
      "text": "Malipayon ka?"
    },
    {
      "start": 421.306,
      "end": 423.071,
      "text": "Responde que estás cansado."
    },
    {
      "start": 427.071,
      "end": 427.935,
      "text": "Gikapoy ko."
    },
    {
      "start": 430.435,
      "end": 433.268,
      "text": "Repaso final. Todo lo de hoy."
