    },
    {
      "start": 397.961,
      "end": 407.156,
      "text": "El verbo 'mouli' se utiliza para expresar la acción de volver a casa. Es común en contextos donde se pregunta por el regreso al hogar."
    },
    {
      "start": 407.756,
      "end": 409.116,
      "text": "Ngano wala ka mouli?"
    },
    {
      "start": 411.616,
