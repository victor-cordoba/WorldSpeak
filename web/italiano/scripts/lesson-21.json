    "tl": [
      "Ciao, come stai?",
      "Sono un po' stanca, ma tutto a posto. E tu?",
      "Mi manca casa, ma sono felice di essere qui.",
      "Perché ti manca casa?",
      "Ho paura di non abituarmi a Roma.",
      "Non preoccuparti, tutto a posto. Roma è fantastica!"
    ],
    "es": [
