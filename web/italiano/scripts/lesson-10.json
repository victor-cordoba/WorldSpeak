  "dialogue": {
    "tl": [
      "Ciao, come ti chiami?",
      "Mi chiamo Laura. Piacere!",
      "Piacere! Hai famiglia?",
      "Sì, ho due fratelli e una sorella.",
      "Quanti siete in totale?",
      "Siamo sei. E tu?",
      "Sono sposato e ho una figlia."
    ],
    "es": [
      "Hola, ¿cómo te llamas?",
      "Me llamo Laura. ¡Encantada!",
      "¡Encantado! ¿Tienes familia?",
      "Sí, tengo dos hermanos y una hermana.",
      "¿Cuántos sois en total?",
      "Somos seis. ¿Y tú?",
      "Estoy casado y tengo una hija."
    ]
  },
  "vocabulary": [
