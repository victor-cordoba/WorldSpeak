  "dialogue": {
    "tl": [
      "Ciao, come stai?",
      "Tutto bene, grazie! Vuoi pregare insieme?",
      "Sì, andiamo alla messa a San Pietro.",
      "Perfetto! Il Vaticano è qui vicino.",
      "Dio ti benedica."
    ],
    "es": [
      "Hola, ¿cómo estás?",
      "¡Todo bien, gracias! ¿Quieres rezar juntos?",
      "Sí, vamos a la misa en San Pedro.",
      "¡Perfecto! El Vaticano está aquí cerca.",
      "Dios te bendiga."
    ]
  },
  "vocabulary": [
