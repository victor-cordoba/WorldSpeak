      "es": "San Pedro es bellísimo."
    },
    {
      "term": "Il Vaticano è qui vicino.",
      "es": "El Vaticano está aquí cerca."
    },
    {
      "term": "Padre nostro che sei nei cieli...",
      "es": "Padre nuestro que estás en los cielos..."
    }
  ],
