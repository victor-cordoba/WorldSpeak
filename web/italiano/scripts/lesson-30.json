  "dialogue": {
    "tl": [
      "Ciao, cosa fai stasera?",
      "Non ho ancora deciso. Tu?",
      "Voglio vedere un film. Ti va di andare al cinema?",
      "Non posso oggi, ho troppo da fare.",
      "Forse domani sarà meglio. Ci vediamo alle otto?",
      "Fammi sapere!"
    ],
    "es": [
      "Hola, ¿qué haces esta noche?",
      "No he decidido todavía. ¿Y tú?",
      "Quiero ver una película. ¿Te apetece ir al cine?",
      "No puedo hoy, tengo demasiado que hacer.",
      "Quizás mañana será mejor. ¿Nos vemos a las ocho?",
      "¡Avísame!"
    ]
  },
