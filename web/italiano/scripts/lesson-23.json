  "dialogue": {
    "tl": [
      "Cosa vuoi fare da grande?",
      "Il mio sogno è diventare un artista.",
      "Vorrei vivere a Roma.",
      "Un giorno visiterò il Colosseo.",
      "Ce la fai a realizzare i tuoi sogni?",
      "Sì, ce la faccio."
    ],
    "es": [
      "¿Qué quieres ser de mayor?",
      "Mi sueño es ser artista.",
      "Querría vivir en Roma.",
      "Un día visitaré el Coliseo.",
      "¿Puedes lograr tus sueños?",
      "Sí, puedo."
    ]
  },
