    },
    {
      "role": "narrator",
      "lang": "es",
      "text": "El condizionale se utiliza para expresar deseos, sueños o situaciones hipotéticas. Es común en frases como 'Vorrei vivere a Roma' para expresar un deseo.",
      "kind": "explanation",
      "pause": 0.6,
      "translation_es": "",
      "item": null,
      "clip": "_clips/4408031e685fdbf0.mp3"
    },
    {
      "role": "native_m",
      "lang": "tl",
      "text": "Vorrei vivere a Roma.",
