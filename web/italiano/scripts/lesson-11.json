  "dialogue": {
    "tl": [
      "Ciao, come ti chiami?",
      "Mi chiamo Anna. E tu?",
      "Mi chiamo Luca. Quanti anni hai?",
      "Ho dieci anni. E tu?",
      "Anch'io ho dieci anni. Sei giovane!",
      "Quando sei nato?",
      "Sono nato nel 2013."
    ],
    "es": [
      "Hola, ¿cómo te llamas?",
      "Me llamo Anna. ¿Y tú?",
      "Me llamo Luca. ¿Cuántos años tienes?",
      "Tengo diez años. ¿Y tú?",
      "Yo también tengo diez años. ¡Eres joven!",
      "¿Cuándo naciste?",
      "Nací en 2013."
    ]
  },
