      "Anche per me! Sei simpatico.",
      "Ci vediamo domani?",
      "Sì, ci vediamo domani.",
      "Dammi il numero, così ti scrivo.",
      "Certo, scrivimi!"
    ],
    "es": [
      "Ha sido un placer conocerte.",
      "¡Para mí también! Eres simpático.",
      "¿Nos vemos mañana?",
      "Sí, nos vemos mañana.",
      "Dame el número, así te escribo.",
      "¡Claro, escríbeme!"
    ]
  },
