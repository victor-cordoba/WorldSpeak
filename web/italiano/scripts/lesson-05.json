  "dialogue": {
    "tl": [
      "Vorrei un caffè, per favore.",
      "Vuoi anche un cornetto?",
      "No, grazie. Vado al mercato dopo.",
      "Come si arriva al Colosseo?",
      "Vai dritto e poi a destra."
    ],
    "es": [
      "Querría un café, por favor.",
      "¿Quieres también un cruasán?",
      "No, gracias. Voy al mercado después.",
      "¿Cómo se llega al Coliseo?",
      "Vas recto y luego a la derecha."
    ]
  },
