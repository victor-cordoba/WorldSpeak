{
  "scenes": {
    "lesson-01": {
      "setting": "En un mercado animado de Cebú, donde los locales se saludan con familiaridad.",
      "lines": [
        {
          "role": "native_m",
          "tl": "Buongiorno!",
          "es": "¡Buenos días!"
        },
        {
          "role": "native_f",
          "tl": "Buongiorno! Come ti chiami?",
          "es": "¡Buenos días! ¿Cómo te llamas?"
        },
        {
          "role": "native_m",
          "tl": "Mi chiamo Carlo. E tu?",
          "es": "Me llamo Carlo. ¿Y tú?"
        },
        {
          "role": "native_f",
          "tl": "Mi chiamo Maria. Piacere di conoscerti.",
          "es": "Me llamo María. Encantada de conocerte."
        },
        {
          "role": "native_m",
          "tl": "Piacere! Tutto bene?",
          "es": "¡Encantado! ¿Todo bien?"
        },
        {
          "role": "native_f",
          "tl": "Sì, grazie! E tu?",
          "es": "¡Sí, gracias! ¿Y tú?"
        },
        {
          "role": "native_m",
          "tl": "Tutto bene, grazie. Ci vediamo domani.",
          "es": "Todo bien, gracias. Nos vemos mañana."
        },
        {
          "role": "native_f",
          "tl": "Ci vediamo, ciao!",
          "es": "Nos vemos, ¡chao!"
        }
      ]
    },
    "lesson-02": {
      "setting": "En un mercado de Tondo, un turista intenta comunicarse con un vendedor local.",
      "lines": [
        {
          "role": "native_m",
          "tl": "Buongiorno!",
          "es": "¡Buenos días!"
        },
        {
          "role": "native_f",
          "tl": "Buongiorno! Parli spagnolo?",
          "es": "¡Buenos días! ¿Hablas español?"
        },
        {
          "role": "native_m",
          "tl": "Un po'.",
          "es": "Un poco."
        },
        {
          "role": "native_f",
          "tl": "Puoi ripetere?",
          "es": "¿Puedes repetir?"
        },
        {
          "role": "native_m",
          "tl": "Non capisco.",
          "es": "No entiendo."
        },
        {
          "role": "native_f",
          "tl": "Va bene. Grazie!",
          "es": "Está bien. ¡Gracias!"
        }
      ]
    },
    "lesson-03": {
      "setting": "En una plaza de Cebú, un niño local se encuentra con un visitante.",
      "lines": [
        {
          "role": "kid_m",
          "tl": "Ciao! Come ti chiami?",
          "es": "¡Hola! ¿Cómo te llamas?"
        },
        {
          "role": "native_m",
          "tl": "Mi chiamo Luca. E tu?",
          "es": "Me llamo Luca. ¿Y tú?"
        },
        {
          "role": "kid_m",
          "tl": "Sono Paolo. Sei di qui?",
          "es": "Soy Paolo. ¿Eres de aquí?"
        },
        {
          "role": "native_m",
          "tl": "No, sono di Tondo. Vivo a Cebu.",
          "es": "No, soy de Tondo. Vivo en Cebú."
        },
        {
          "role": "kid_m",
          "tl": "Quanti anni hai?",
          "es": "¿Cuántos años tienes?"
        },
        {
          "role": "native_m",
          "tl": "Ho venti anni. E tu?",
          "es": "Tengo veinte años. ¿Y tú?"
        },
        {
          "role": "kid_m",
          "tl": "Ho dieci anni. Questa è casa mia.",
          "es": "Tengo diez años. Esta es mi casa."
        }
      ]
    }
  }
}
