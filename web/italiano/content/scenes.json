    "lesson-04": {
      "setting": "En una plaza de Roma, un niño y su madre buscan a su padre.",
      "lines": [
        {
          "role": "kid_m",
          "tl": "Mamma, dove sei?",
          "es": "Mamá, ¿dónde estás?"
        },
        {
          "role": "native_f",
          "tl": "Sono qui, vicino alla fontana!",
          "es": "¡Estoy aquí, cerca de la fuente!"
        },
        {
          "role": "kid_m",
          "tl": "Chi è lui, vicino a te?",
          "es": "¿Quién es él, cerca de ti?"
        },
        {
          "role": "native_f",
          "tl": "È un amico di papà.",
          "es": "Es un amigo de papá."
        },
        {
          "role": "kid_m",
          "tl": "E cos'è quello?",
          "es": "¿Y qué es aquello?"
        },
        {
          "role": "native_f",
          "tl": "È un gatto, vieni a vederlo!",
          "es": "Es un gato, ¡ven a verlo!"
        }
      ]
