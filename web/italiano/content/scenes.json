{
  "scenes": {
    "lesson-01": {
      "setting": "En una trattoria en Trastevere, un lugar perfecto para conocer a los romanos.",
      "lines": [
        {
          "role": "native_m",
          "tl": "Ciao, come stai?",
          "es": "Hola, ¿cómo estás?"
        },
        {
          "role": "native_f",
          "tl": "Tutto bene, grazie. E tu?",
          "es": "Todo bien, gracias. ¿Y tú?"
        },
        {
          "role": "native_m",
          "tl": "Bene, grazie. Come ti chiami?",
          "es": "Bien, gracias. ¿Cómo te llamas?"
        },
        {
          "role": "native_f",
          "tl": "Mi chiamo Lucia. Piacere!",
          "es": "Me llamo Lucía. ¡Encantada!"
        },
        {
          "role": "native_m",
          "tl": "Piacere! Io sono Marco.",
          "es": "¡Encantado! Yo soy Marco."
        },
        {
          "role": "native_f",
          "tl": "Ci vediamo!",
          "es": "¡Nos vemos!"
        }
      ]
    },
    "lesson-02": {
      "setting": "En una trattoria de Trastevere, un hispanohablante intenta comunicarse con el camarero.",
      "lines": [
        {
          "role": "native_m",
          "tl": "Buongiorno! Parli spagnolo?",
          "es": "¡Buenos días! ¿Hablas español?"
        },
        {
          "role": "native_f",
          "tl": "Un po'.",
          "es": "Un poco."
        },
        {
          "role": "native_m",
          "tl": "Perfetto! Puoi ripetere il menu, per favore?",
          "es": "¡Perfecto! ¿Puedes repetir el menú, por favor?"
        },
        {
          "role": "native_f",
          "tl": "Certo! Allora, abbiamo pasta, pizza e insalate.",
          "es": "¡Claro! Entonces, tenemos pasta, pizza y ensaladas."
        },
        {
          "role": "native_m",
          "tl": "Grazie! Non capisco 'insalate'.",
          "es": "¡Gracias! No entiendo 'ensaladas'."
        },
        {
          "role": "native_f",
          "tl": "Insalate sono 'ensaladas'.",
          "es": "Insalate son 'ensaladas'."
        }
      ]
    },
    "lesson-03": {
      "setting": "En una trattoria en Trastevere, dos jóvenes se conocen.",
      "lines": [
        {
          "role": "native_f",
          "tl": "Ciao, come ti chiami?",
          "es": "Hola, ¿cómo te llamas?"
        },
        {
          "role": "native_m",
          "tl": "Mi chiamo Luca. E tu?",
          "es": "Me llamo Luca. ¿Y tú?"
        },
        {
          "role": "native_f",
          "tl": "Io sono Anna. Abiti a Roma?",
          "es": "Yo soy Anna. ¿Vives en Roma?"
        },
        {
          "role": "native_m",
          "tl": "Sì, abito a Roma. Questa è casa mia.",
          "es": "Sí, vivo en Roma. Esta es mi casa."
        },
        {
          "role": "native_f",
          "tl": "Ti piace Roma?",
          "es": "¿Te gusta Roma?"
        },
        {
          "role": "native_m",
          "tl": "Mi piace molto!",
          "es": "¡Me gusta mucho!"
        }
      ]
    }
  }
}
