        {
          "role": "native_f",
          "tl": "Tifo Lazio.",
          "es": "Soy hincha de la Lazio."
        }
      ]
    },
    "lesson-23": {
      "setting": "En un parque de Roma, dos amigos hablan sobre sus sueños y el futuro.",
      "lines": [
        {
          "role": "native_m",
          "tl": "Cosa vuoi fare da grande?",
          "es": "¿Qué quieres ser de mayor?"
        },
        {
          "role": "native_f",
          "tl": "Il mio sogno è diventare un artista.",
          "es": "Mi sueño es ser artista."
        },
        {
          "role": "native_m",
          "tl": "Vorrei vivere a Roma.",
          "es": "Querría vivir en Roma."
        },
        {
          "role": "native_f",
          "tl": "Un giorno visiterò il Colosseo.",
          "es": "Un día visitaré el Coliseo."
        },
        {
          "role": "native_m",
          "tl": "Ce la fai a realizzare i tuoi sogni?",
          "es": "¿Puedes lograr tus sueños?"
        },
        {
          "role": "native_f",
          "tl": "Sì, ce la faccio.",
          "es": "Sí, puedo."
        }
      ]
    },
    "lesson-24": {
      "setting": "En una calle concurrida de Roma, un turista se siente mal y necesita ayuda.",
      "lines": [
        {
          "role": "native_m",
          "tl": "Attenzione! Occhio al portafoglio!",
          "es": "¡Atención! ¡Cuidado con la cartera!"
        },
        {
          "role": "native_f",
          "tl": "Aiuto! Sto male!",
          "es": "¡Ayuda! ¡Estoy mal!"
        },
        {
          "role": "native_m",
          "tl": "Chiama la polizia! Serve un medico!",
          "es": "¡Llama a la policía! ¡Se necesita un médico!"
        },
        {
          "role": "native_f",
          "tl": "Non è sicuro restare qui.",
          "es": "No es seguro quedarse aquí."
        },
        {
          "role": "native_m",
          "tl": "Sì, è aperto!",
          "es": "¡Sí, está abierto!"
        }
      ]
    },
    "lesson-25": {
      "setting": "En una plaza cerca del Vaticano, dos amigos conversan sobre sus planes para el día.",
      "lines": [
        {
          "role": "native_m",
          "tl": "Ciao, come stai?",
          "es": "Hola, ¿cómo estás?"
        },
        {
          "role": "native_f",
          "tl": "Tutto bene, grazie! Vuoi pregare insieme?",
          "es": "¡Todo bien, gracias! ¿Quieres rezar juntos?"
        },
        {
          "role": "native_m",
          "tl": "Sì, andiamo alla messa a San Pietro.",
          "es": "Sí, vamos a la misa en San Pedro."
        },
        {
          "role": "native_f",
          "tl": "Perfetto! Il Vaticano è qui vicino.",
          "es": "¡Perfecto! El Vaticano está aquí cerca."
        },
        {
          "role": "native_m",
          "tl": "Dio ti benedica.",
          "es": "Dios te bendiga."
        }
      ]
    },
    "lesson-26": {
      "setting": "Es una cálida tarde de verano en Roma. Dos amigos están planeando qué hacer por la noche mientras disfrutan de un aperitivo.",
      "lines": [
        {
          "role": "native_m",
          "tl": "Che famo stasera?",
          "es": "¿Qué hacemos esta noche?"
        },
        {
          "role": "native_f",
          "tl": "Usciamo? Fa caldo, ma il ponentino è piacevole.",
          "es": "¿Salimos? Hace calor, pero el ponentino es agradable."
        },
        {
          "role": "native_m",
          "tl": "Andiamo a Trastevere in Vespa?",
          "es": "¿Vamos a Trastevere en Vespa?"
        },
        {
          "role": "native_f",
          "tl": "Sì, ma prima l'aperitivo è pronto. Prendiamo uno spritz?",
          "es": "Sí, pero primero el aperitivo está listo. ¿Tomamos un spritz?"
        },
        {
          "role": "native_m",
          "tl": "Quanto costa uno spritz?",
          "es": "¿Cuánto cuesta un spritz?"
        }
      ]
    },
    "lesson-27": {
      "setting": "Es domingo por la tarde en Roma, y una familia se prepara para ver el partido de fútbol en casa.",
      "lines": [
        {
          "role": "native_m",
          "tl": "La partita è alle tre.",
          "es": "El partido es a las tres."
        },
        {
          "role": "native_f",
          "tl": "Chi gioca oggi?",
          "es": "¿Quién juega hoy?"
        },
        {
          "role": "native_m",
          "tl": "Forza Roma!",
          "es": "¡Vamos Roma!"
        },
        {
          "role": "native_f",
          "tl": "Andiamo allo stadio?",
          "es": "¿Vamos al estadio?"
        },
        {
          "role": "native_m",
          "tl": "No, guardiamo la partita in famiglia.",
          "es": "No, vemos el partido en familia."
        },
        {
          "role": "native_f",
          "tl": "Ha segnato la Roma!",
          "es": "¡Ha marcado la Roma!"
        }
      ]
    },
    "lesson-28": {
      "setting": "En una farmacia en Roma, un cliente busca ayuda para un malestar.",
      "lines": [
        {
          "role": "native_m",
          "tl": "Buongiorno, come posso aiutarla?",
          "es": "Buenos días, ¿cómo puedo ayudarle?"
        },
        {
          "role": "native_f",
          "tl": "Ho mal di testa e ho bisogno di una ricetta.",
          "es": "Tengo dolor de cabeza y necesito una receta."
        },
        {
          "role": "native_m",
          "tl": "Capisco, dov'è il pronto soccorso più vicino?",
          "es": "Entiendo, ¿dónde está urgencias más cercana?"
        },
        {
          "role": "native_f",
          "tl": "Sto meglio, grazie. Dov'è la farmacia più vicina?",
          "es": "Estoy mejor, gracias. ¿Dónde está la farmacia más cercana?"
        },
        {
          "role": "native_m",
          "tl": "La farmacia è qui vicino, a destra.",
          "es": "La farmacia está aquí cerca, a la derecha."
        }
      ]
    },
    "lesson-29": {
