{
  "scenes": {
    "lesson-01": {
      "setting": "En una trattoria en Trastevere, un lugar perfecto para conocer a los romanos.",
      "lines": [
        {
          "role": "native_m",
          "tl": "Ciao, come stai?",
          "es": "Hola, ¿cómo estás?"
        },
        {
          "role": "native_f",
          "tl": "Tutto bene, grazie. E tu?",
          "es": "Todo bien, gracias. ¿Y tú?"
        },
        {
          "role": "native_m",
          "tl": "Bene, grazie. Come ti chiami?",
          "es": "Bien, gracias. ¿Cómo te llamas?"
        },
        {
          "role": "native_f",
          "tl": "Mi chiamo Lucia. Piacere!",
          "es": "Me llamo Lucía. ¡Encantada!"
        },
        {
          "role": "native_m",
          "tl": "Piacere! Io sono Marco.",
          "es": "¡Encantado! Yo soy Marco."
        },
        {
          "role": "native_f",
          "tl": "Ci vediamo!",
          "es": "¡Nos vemos!"
        }
      ]
    },
    "lesson-02": {
