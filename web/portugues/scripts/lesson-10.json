  "dialogue": {
    "tl": [
      "Fixe! As ondas estavam ótimas hoje.",
      "Sim, adorei! Tens família?",
      "Tenho um irmão e uma irmã. E tu?",
      "Tenho filhos, mas não tenho mulher.",
      "Quantos são?",
      "São dois. E tu, tens filhos?"
    ],
    "es": [
      "¡Genial! Las olas estaban estupendas hoy.",
      "Sí, ¡me encantó! ¿Tienes familia?",
      "Tengo un hermano y una hermana. ¿Y tú?",
      "Tengo hijos, pero no tengo esposa.",
      "¿Cuántos son?",
      "Son dos. ¿Y tú, tienes hijos?"
    ]
  },
