  "dialogue": {
    "tl": [
      "Excuse me, which line do I take for Piccadilly Circus?",
      "Take the Bakerloo line.",
      "Thank you. Do you have an Oyster or contactless card?",
      "Yes, I have an Oyster card.",
      "Great, mind the gap when you board."
    ],
    "es": [
      "Perdona, ¿qué línea tomo para Piccadilly Circus?",
      "Toma la línea Bakerloo.",
      "Gracias. ¿Tienes una tarjeta Oyster o contactless?",
      "Sí, tengo una tarjeta Oyster.",
      "Genial, cuidado con el hueco al subir."
    ]
  },
  "vocabulary": [
    {
      "term": "Which line do I take for Piccadilly Circus?",
      "es": "¿Qué línea tomo para Piccadilly Circus?"
    },
    {
      "term": "Do you have an Oyster or contactless card?",
      "es": "¿Tienes una tarjeta Oyster o contactless?"
    },
    {
      "term": "Mind the gap.",
      "es": "Cuidado con el hueco."
    },
    {
      "term": "What's the next stop?",
      "es": "¿Cuál es la próxima parada?"
    },
    {
      "term": "A return ticket to Oxford, please.",
      "es": "Un billete de ida y vuelta a Oxford, por favor."
    },
    {
      "term": "Is this seat taken?",
      "es": "¿Está ocupado este asiento?"
    }
  ],
