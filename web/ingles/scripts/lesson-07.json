  "dialogue": {
    "tl": [
      "Hi, what time do you close today?",
      "We close at 6 PM.",
      "Is it open tomorrow?",
      "Yes, we're open tomorrow.",
      "Great, how many coffees do you serve daily?",
      "Around 200. Why do you ask?",
      "Just curious! Thanks."
    ],
    "es": [
      "Hola, ¿a qué hora cierran hoy?",
      "Cerramos a las 6 PM.",
      "¿Está abierto mañana?",
      "Sí, estamos abiertos mañana.",
      "Genial, ¿cuántos cafés sirven diariamente?",
      "Alrededor de 200. ¿Por qué preguntas?",
      "¡Solo curiosidad! Gracias."
    ]
  },
  "vocabulary": [
