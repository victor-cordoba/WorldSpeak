  "dialogue": {
    "tl": [
      "Mum, where is the tube station?",
      "It's near, just around the corner.",
      "Who is that man over there?",
      "I'm not sure. Maybe a local artist.",
      "What's this building?",
      "That's a famous market. Let's have a look!"
    ],
    "es": [
      "Mamá, ¿dónde está la estación de metro?",
      "Está cerca, justo a la vuelta de la esquina.",
      "¿Quién es ese hombre allí?",
      "No estoy segura. Quizás un artista local.",
      "¿Qué es este edificio?",
      "Es un mercado famoso. ¡Vamos a echar un vistazo!"
    ]
  },
