  "dialogue": {
    "tl": [
      "Good morning. How can I help you today?",
      "I've got a headache and a cold.",
      "I see. Do you need a prescription?",
      "Yes, please. Also, where is the chemist?",
      "It's just around the corner. I'm sure you'll be feeling better soon."
    ],
    "es": [
      "Buenos días. ¿En qué puedo ayudarte hoy?",
      "Tengo dolor de cabeza y un resfriado.",
      "Ya veo. ¿Necesitas una receta?",
      "Sí, por favor. Además, ¿dónde está la farmacia?",
      "Está justo a la vuelta de la esquina. Estoy seguro de que te sentirás mejor pronto."
    ]
  },
