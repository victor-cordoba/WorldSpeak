    "tl": [
      "Lovely day, isn't it?",
      "Yes, it's beautiful. How's it going?",
      "Not bad. Just enjoying the fresh air.",
      "Do you come here often?",
      "Yes, every weekend. It's a bit chilly today, isn't it?",
      "Yes, but I can't complain. It's better than rain!"
    ],
    "es": [
      "Día encantador, ¿verdad?",
      "Sí, es precioso. ¿Cómo va todo?",
      "No está mal. Solo disfrutando del aire fresco.",
      "¿Vienes aquí a menudo?",
      "Sí, todos los fines de semana. Hace un poco de frío, ¿no?",
      "Sí, pero no me puedo quejar. ¡Es mejor que la lluvia!"
    ]
  },
