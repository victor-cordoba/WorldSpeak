  "dialogue": {
    "tl": [
      "Salut ! Tu fais quoi dans la vie ?",
      "Je suis professeure. Et toi ?",
      "Je fais des études en informatique.",
      "Tu aimes ça ?",
      "Oui, j'aime bien. Et toi, tu aimes être prof ?",
      "Oui, beaucoup. C'est très enrichissant."
    ],
