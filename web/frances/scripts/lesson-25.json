    {
      "role": "narrator",
      "lang": "es",
      "text": "En una pequeña iglesia de Montmartre, dos amigos hablan sobre la fe antes de asistir a misa. Escucha la conversación.",
      "kind": "instruction",
      "pause": 0.8,
      "translation_es": "",
      "item": null,
      "clip": "_clips/9d3992b3f3c8aaf5.mp3"
    },
    {
      "role": "native_m",
      "lang": "tl",
      "text": "Bonjour ! Tu veux prier ?",
      "kind": "dialogue",
      "pause": 0.8,
      "translation_es": "¡Hola! ¿Quieres rezar?",
      "item": null,
      "clip": "_clips/99c5c6586434008e.mp3"
    },
    {
      "role": "native_f",
      "lang": "tl",
      "text": "Oui, j'aimerais bien. On peut dire le Notre Père ?",
      "kind": "dialogue",
      "pause": 0.8,
      "translation_es": "Sí, me gustaría. ¿Podemos rezar el Padre Nuestro?",
      "item": null,
      "clip": "_clips/0f566eef65268a98.mp3"
    },
    {
      "role": "native_m",
      "lang": "tl",
      "text": "Bien sûr. Après, on ira à la messe à Notre-Dame.",
      "kind": "dialogue",
      "pause": 0.8,
      "translation_es": "Por supuesto. Después, iremos a misa en Notre-Dame.",
      "item": null,
      "clip": "_clips/85d714a40eca3c0d.mp3"
    },
    {
      "role": "native_f",
      "lang": "tl",
      "text": "D'accord. Que Dieu te bénisse.",
      "kind": "dialogue",
      "pause": 0.8,
      "translation_es": "De acuerdo. Que Dios te bendiga.",
      "item": null,
      "clip": "_clips/ade9175a047cd5d7.mp3"
    },
    {
      "role": "native_m",
      "lang": "tl",
      "text": "Merci, toi aussi. Tu es croyante ?",
      "kind": "dialogue",
      "pause": 0.8,
