      "item": null,
      "clip": "_clips/6540cc6e4f262524.mp3"
    },
    {
      "role": "native_m",
      "lang": "tl",
      "text": "Bien sûr. Après, on ira à la messe à Notre-Dame.",
      "kind": "dialogue",
      "pause": 0.8,
      "translation_es": "Por supuesto. Después, iremos a misa en Notre-Dame.",
      "item": null,
      "clip": "_clips/5e59a426bcf61d5d.mp3"
    },
    {
      "role": "native_f",
      "lang": "tl",
      "text": "D'accord. Que Dieu te bénisse.",
