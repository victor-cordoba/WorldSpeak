    {
      "role": "narrator",
      "lang": "es",
      "text": "En una pequeña iglesia de Montmartre, dos amigos hablan sobre la fe antes de asistir a misa. Escucha la conversación.",
      "kind": "instruction",
      "pause": 0.8,
      "translation_es": "",
