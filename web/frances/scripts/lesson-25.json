    },
    {
      "role": "native_m",
      "lang": "tl",
      "text": "Bonjour ! Tu veux prier ?",
      "kind": "dialogue",
      "pause": 0.8,
      "translation_es": "¡Hola! ¿Quieres rezar?",
      "item": null,
      "clip": "_clips/08e4f0636644255c.mp3"
    },
    {
      "role": "native_f",
      "lang": "tl",
      "text": "Oui, j'aimerais bien. On peut dire le Notre Père ?",
