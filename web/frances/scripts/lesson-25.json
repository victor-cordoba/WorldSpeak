  "dialogue": {
    "tl": [
      "Bonjour ! Tu veux prier ?",
      "Oui, j'aimerais bien. On peut dire le Notre Père ?",
      "Bien sûr. Après, on ira à la messe à Notre-Dame.",
      "D'accord. Que Dieu te bénisse.",
      "Merci, toi aussi. Tu es croyante ?",
      "Oui, je crois en Dieu."
    ],
    "es": [
      "¡Hola! ¿Quieres rezar?",
      "Sí, me gustaría. ¿Podemos rezar el Padre Nuestro?",
      "Por supuesto. Después, iremos a misa en Notre-Dame.",
      "De acuerdo. Que Dios te bendiga.",
      "Gracias, igualmente. ¿Eres creyente?",
      "Sí, creo en Dios."
    ]
  },
