  "dialogue": {
    "tl": [
      "Bonjour, nous allons prendre une entrée, un plat et un dessert.",
      "Très bien, le plat du jour est du poulet rôti.",
      "Papa, je veux un verre de rouge !",
      "Non, tu peux avoir un jus d'orange.",
      "Fromage ou dessert pour vous deux ?",
      "Pour moi, un dessert, s'il vous plaît.",
      "Moi aussi, un dessert !"
    ],
    "es": [
      "Hola, vamos a tomar un entrante, un plato y un postre.",
      "Muy bien, el plato del día es pollo asado.",
      "¡Papá, quiero una copa de tinto!",
      "No, puedes tomar un zumo de naranja.",
      "¿Queso o postre para vosotros dos?",
      "Para mí, un postre, por favor.",
      "¡Yo también, un postre!"
    ]
  },
