        {
          "role": "native_m",
          "tl": "Je me sens mal.",
          "es": "Me siento mal."
        },
        {
          "role": "native_f",
          "tl": "Où sont les urgences ?",
          "es": "¿Dónde están las urgencias?"
        },
        {
          "role": "native_m",
          "tl": "Oui, je vais bien.",
          "es": "Sí, estoy bien."
        }
      ]
    },
    "lesson-25": {
      "setting": "En una pequeña iglesia de Montmartre, dos amigos hablan sobre la fe antes de asistir a misa.",
      "lines": [
        {
          "role": "native_m",
          "tl": "Bonjour ! Tu veux prier ?",
          "es": "¡Hola! ¿Quieres rezar?"
        },
        {
          "role": "native_f",
          "tl": "Oui, j'aimerais bien. On peut dire le Notre Père ?",
          "es": "Sí, me gustaría. ¿Podemos rezar el Padre Nuestro?"
        },
        {
          "role": "native_m",
          "tl": "Bien sûr. Après, on ira à la messe à Notre-Dame.",
          "es": "Por supuesto. Después, iremos a misa en Notre-Dame."
        },
        {
          "role": "native_f",
          "tl": "D'accord. Que Dieu te bénisse.",
          "es": "De acuerdo. Que Dios te bendiga."
        },
        {
          "role": "native_m",
          "tl": "Merci, toi aussi. Tu es croyante ?",
          "es": "Gracias, igualmente. ¿Eres creyente?"
        },
        {
          "role": "native_f",
          "tl": "Oui, je crois en Dieu.",
          "es": "Sí, creo en Dios."
        }
      ]
    },
