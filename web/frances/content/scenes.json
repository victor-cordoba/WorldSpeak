    "lesson-29": {
      "setting": "En un café de Montmartre, dos amigos deciden qué hacer después de tomar un café.",
      "lines": [
        {
          "role": "native_m",
          "tl": "Salut ! Tu veux un café ?",
          "es": "¡Hola! ¿Quieres un café?"
        },
        {
          "role": "native_f",
          "tl": "Oui, je veux. Et après ?",
          "es": "Sí, quiero. ¿Y después?"
        },
        {
          "role": "native_m",
          "tl": "Bon, on fait quoi ? Peut-être une balade ?",
          "es": "Bueno, ¿qué hacemos? ¿Quizás un paseo?"
        },
        {
          "role": "native_f",
          "tl": "Oui, mais il fait chaud. On va en terrasse ?",
          "es": "Sí, pero hace calor. ¿Vamos a una terraza?"
        },
        {
          "role": "native_m",
          "tl": "Du coup, on y va ? C'est juste ici.",
          "es": "Entonces, ¿vamos? Está justo aquí."
        },
        {
          "role": "native_f",
          "tl": "D'accord, mais c'est fermé ?",
          "es": "De acuerdo, ¿pero está cerrado?"
        },
        {
          "role": "native_m",
          "tl": "Non, c'est ouvert. Donc, tu viens ?",
          "es": "No, está abierto. Entonces, ¿vienes?"
        }
      ]
    },
