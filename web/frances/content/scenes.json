    "lesson-03": {
      "setting": "En un café en Montmartre, dos amigos se encuentran después de mucho tiempo.",
      "lines": [
        {
          "role": "native_m",
          "tl": "Salut ! Ça va ?",
          "es": "¡Hola! ¿Cómo estás?"
        },
        {
          "role": "native_f",
          "tl": "Salut ! Oui, ça va bien. Et toi ?",
          "es": "¡Hola! Sí, estoy bien. ¿Y tú?"
        },
        {
          "role": "native_m",
          "tl": "Moi aussi. Je suis content de te voir.",
          "es": "Yo también. Estoy contento de verte."
        },
        {
          "role": "native_f",
          "tl": "Moi aussi. Tu habites toujours chez toi ?",
          "es": "Yo también. ¿Sigues viviendo en tu casa?"
        },
        {
          "role": "native_m",
          "tl": "Non, maintenant je suis chez moi à Lyon.",
          "es": "No, ahora estoy en mi casa en Lyon."
        },
        {
          "role": "native_f",
          "tl": "Ah, d'accord. Chez moi, c'est toujours Paris.",
          "es": "Ah, de acuerdo. En mi casa, sigue siendo París."
        }
      ]
