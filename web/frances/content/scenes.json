    "lesson-23": {
      "setting": "En un café de Montmartre, dos amigos hablan de sus sueños y aspiraciones.",
      "lines": [
        {
          "role": "native_f",
          "tl": "Tu veux faire quoi plus tard ?",
          "es": "¿Qué quieres hacer más tarde?"
        },
        {
          "role": "native_m",
          "tl": "Mon rêve, c'est d'être artiste.",
          "es": "Mi sueño es ser artista."
        },
        {
          "role": "native_f",
          "tl": "J'aimerais vivre ici, à Montmartre.",
          "es": "Me gustaría vivir aquí, en Montmartre."
        },
        {
          "role": "native_m",
          "tl": "Un jour, on y arrivera.",
          "es": "Un día, lo lograremos."
        },
        {
          "role": "native_f",
          "tl": "Tu vas y arriver, j'en suis sûre.",
          "es": "Lo vas a lograr, estoy segura."
        }
      ]
    },
    "lesson-24": {
